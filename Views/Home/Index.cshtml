@{
    ViewBag.HideHotSidebar = false;
}

<div class="w-full">
    @await Component.InvokeAsync("StoriesList")
</div>

@section Scripts {
    <script src="~/js/infinite_scroll.js"></script>

    <script>
        $(document).ready(function () {
            // Chỉ Trang Chủ mới khởi tạo window.mainScroller
            window.mainScroller = new InfiniteScroller({
                gridSelector: '#mainStoryGrid',
                triggerSelector: '#infiniteScrollTrigger',
                spinnerSelector: '#scrollSpinner',
                noMoreSelector: '#noMoreData',
                endpoint: '/Stories/GetStoriesInfinite',
                pageSize: 8,
                params: {
                    search: ''
                }
            });
        });
    </script>
}