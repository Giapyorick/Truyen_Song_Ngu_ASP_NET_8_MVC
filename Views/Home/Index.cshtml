@{
    ViewBag.HideHotSidebar = false;
}
<!-- Nút lọc dùng chung kiểu nút của trang Thể loại (.cat-pill) -->
<link rel="stylesheet" href="~/css/home/categories.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home/home-filter.css" asp-append-version="true" />

<div class="w-full">
    @await Component.InvokeAsync("StoriesList")
</div>

@section Scripts {

    <script>
        $(document).ready(function () {
            window.mainScroller = new InfiniteScroller({
                gridSelector: '#mainStoryGrid',
                triggerSelector: '#infiniteScrollTrigger',
                spinnerSelector: '#scrollSpinner',
                noMoreSelector: '#noMoreData',
                endpoint: '/Stories/GetStoriesInfinite',
                pageSize: 8,
                params: {
                    type: 'latest', // THÊM DÒNG NÀY: Ép buộc lấy theo mới nhất thay vì mặc định 'likes'
                    categoryId: '',
                    search: ''
                }
            });
        });
    </script>
    <script src="~/js/home/home-filter.js" asp-append-version="true"></script>
}