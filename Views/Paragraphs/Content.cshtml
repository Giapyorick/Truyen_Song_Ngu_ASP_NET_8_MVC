<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/content.css">

@{
    ViewData["Title"] = "Reading Experience";
    var chapterId = ViewBag.ChapterId;
}

<div class="reading-wrapper transition-all duration-300" id="mainWrapper">
    <div class="reading-header">
        <div class="toolbar flex flex-wrap items-center justify-between gap-4 p-4 bg-gray-50 border-b border-gray-100 rounded-t-2xl">
            <span class="hint text-xs text-gray-500 font-medium">
                <i class="fa-solid fa-circle-info me-1 text-blue-500"></i> Double-click on each sentence to translate it individually.
            </span>

            <!-- Cụm điều khiển thanh công cụ chỉnh chữ và màu nền -->
            <div id="readingControls" class="flex items-center gap-4 text-sm font-medium transition-all duration-300">
                <!-- Bộ tăng giảm font chữ -->
                <div class="flex items-center gap-1 border border-gray-200 bg-white rounded-xl p-1 shadow-sm">
                    <button onclick="changeFontSize(-2)" class="px-2.5 py-1 text-gray-600 hover:bg-gray-100 rounded-lg active:scale-95 transition" title="Decrease size">A-</button>
                    <span id="fontSizeDisplay" class="px-2 text-xs text-gray-400 border-x border-gray-100">18px</span>
                    <button onclick="changeFontSize(2)" class="px-2.5 py-1 text-gray-600 hover:bg-gray-100 rounded-lg active:scale-95 transition" title="Increase size">A+</button>
                </div>

                <!-- Bộ đổi màu nền -->
                <div class="flex items-center gap-1.5 border border-gray-200 bg-white rounded-xl p-1 shadow-sm">
                    <button onclick="changeTheme('light')" class="w-6 h-6 rounded-full border border-gray-300 bg-white" title="Light theme"></button>
                    <button onclick="changeTheme('sepia')" class="w-6 h-6 rounded-full border border-yellow-700/20 bg-[#f4ecd8]" title="Sepia theme"></button>
                    <button onclick="changeTheme('dark')" class="w-6 h-6 rounded-full border border-gray-700 bg-[#1e293b]" title="Dark theme"></button>
                </div>
            </div>
        </div>
    </div>

    <article id="paragraphList" class="reading-content p-8 min-h-[50vh] transition-all duration-300" style="font-size: 18px;">
        <!-- Nội dung truyện tự động load ở đây -->
    </article>
</div>

<!-- Khay chứa thanh cấu hình dịch chuyển khi bật Focus (BẮT BUỘC ĐỂ NGOÀI) -->
<div id="focusToolbarContainer"></div>

<!-- Cụm nút bấm Action cố định ở góc phải công cộng -->
<!-- Khối chứa tiện ích tổng hợp duy nhất ở góc phải dưới -->
<div id="rightActionControls" class="fixed bottom-5 right-5 flex items-center gap-3 z-[1010]">
    
    <!-- Nút Chế độ tập trung (Focus Mode) -->
    <button id="btnFocusMode" onclick="toggleFocusMode()"
            class="flex items-center gap-2 btn-grad border border-gray-200 text-white px-4 py-3 rounded-full shadow-lg transition-all duration-300 font-medium text-sm whitespace-nowrap"
            title="Focus Mode">
        <i class="fa-solid fa-eye-slash text-amber-500"></i>
        <span class="btn-text">Focus Mode</span>
    </button>

    <!-- Nút Dịch tất cả -->
    <button id="btnTranslateAll"
            class="flex items-center gap-2 btn-grad border border-gray-200 text-white px-4 py-3 rounded-full shadow-lg transition-all duration-300 font-medium text-sm whitespace-nowrap"
            title="Translate all">
        <i class="fa-solid fa-language text-blue-600"></i>
        <span class="btn-text">Translate all</span>
    </button>

    <!-- Khay chứa trung gian cho thanh Font & Theme (Để JS nhận diện) -->
    <div id="controlsBridge"></div>

    <!-- Nút Chat AI (Quả địa cầu) -->
    <button onclick="toggleChat()" id="chat-button"
            class="flex items-center gap-2 btn-grad border border-gray-200 text-white px-4 py-3 rounded-full shadow-lg transition-all duration-300 font-medium text-sm whitespace-nowrap"
            title="Chat bot assistant">
        <span class="btn-text text-2xl leading-none">🌍</span>
    </button>
</div>

<!-- Khung Chat AI Assistant -->
<div id="chat-box" class="fixed bottom-24 right-5 w-[400px] max-h-[600px] h-[70vh] bg-white shadow-2xl rounded-2xl overflow-hidden border border-gray-100 flex flex-col font-sans transition-all duration-300 transform translate-y-10 opacity-0 pointer-events-none z-50" style = "z-index: 1011;">
    <div class="btn-grad p-4 flex justify-between items-center shadow-md">
        <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-green-600 rounded-full animate-pulse"></div>
            <h3 class="font-bold text-lg tracking-tight">AI Assistant</h3>
        </div>
        <button onclick="toggleChat()" class="hover:bg-white/30 p-2 rounded-full transition hover:rotate-90">
            <i class="fa-solid fa-x text-xl font-bold"></i>
        </button>
    </div>
    <div id="chat-history" class="flex-1 overflow-y-auto p-4 space-y-4 bg-[#f8f9fa]">
        <div class="flex justify-start">
            <div class="btn-grad-gray border border-gray-200 text-gray-700 p-3 rounded-2xl rounded-tl-none max-w-[85%] text-sm shadow-sm">
                Hello! 👋 I'm a translation assistant. Please enter the English word you need explained!
            </div>
        </div>
    </div>
    <div class="p-4 bg-white border-t border-gray-100">
        <textarea id="user-input" rows="1" class="w-full p-3 bg-gray-50 border text-black border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-400 focus:bg-white resize-none transition-all text-sm" placeholder="Type something..."></textarea>
        <div class="flex gap-2 mt-3">
            <button onclick="handleAction('Translate')" class="flex-1 btn-grad-trans text-white py-2.5 rounded-xl hover:bg-gray-200 transition-all text-xs font-bold">Translate</button>
            <button onclick="handleAction('Explain')" class="flex-1 btn-grad text-white py-2.5 rounded-xl shadow-lg transition-all text-xs font-bold">Explain</button>
        </div>
    </div>
</div>

<!-- Lớp phủ Hộp Đọc Tập Trung Focus Mode -->
<div id="focusModeOverlay" class="fixed inset-0 z-40 hidden transition-all duration-300">
    <div class="max-w-[800px] mx-auto h-full overflow-y-auto px-4 py-12">
        <div id="focusContentContainer" class="bg-white rounded-3xl p-8 shadow-xl min-h-full font-serif reading-content"></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>

<style>
    .ai-content h3 {
        font-weight: bold;
        color: #1e293b;
        margin-top: 10px;
        font-size: 1.1rem;
        font-family: 'Lora', serif;
    }

    .ai-content blockquote {
        border-left: 4px solid #0a0a0a;
        padding-left: 10px;
        margin: 10px 0;
        font-family: 'Lora', serif;
        background: #f0fdfa;
    }

    .ai-content ul {
        padding-left: 20px;
        list-style-type: disc;
    }

    .reading-content {
        line-height: 2 !important;
        font-family: 'Lora', serif !important;
    }

    /* ĐÃ SỬA: Loại bỏ hiệu ứng hover làm nổi bật câu văn và giữ nguyên con trỏ văn bản thông thường */
    .text-segment {
        cursor: text !important;
        background-color: transparent !important;
        transition: none !important;
    }
    .text-segment:hover {
        background-color: transparent !important;
        color: inherit !important;
    }

    /* ĐÃ SỬA: Ép các câu dịch (is-translated) giữ nguyên màu chữ của theme nền, không đổi màu xanh/đỏ */
    .is-translated {
        color: inherit !important;
    }

    /* ĐÃ SỬA: Tách biệt z-index để lớp phủ ẩn không chặn click chuột ở màn hình gốc */
    #focusModeOverlay {
        z-index: -1 !important;
        pointer-events: none;
        scrollbar-width: none !important;
        -ms-overflow-style: none !important;
    }
    #focusModeOverlay::-webkit-scrollbar {
        display: none !important;
    }
    #focusModeOverlay.block {
        z-index: 1000 !important; /* Đè lên mức 50 của header khi kích hoạt */
        pointer-events: auto;
    }

    #focusModeOverlay.theme-light {
        background-color: #f1f5f9;
    }

    #focusModeOverlay.theme-sepia {
        background-color: #eaddca;
    }

    #focusModeOverlay.theme-dark {
        background-color: #020617;
    }

    #focusModeOverlay.theme-light #focusContentContainer {
        background-color: #ffffff;
        color: #1e293b;
    }

    #focusModeOverlay.theme-sepia #focusContentContainer {
        background-color: #fdf6e3;
        color: #433422;
    }

    #focusModeOverlay.theme-dark #focusContentContainer {
        background-color: #1e293b;
        color: #f1f5f9;
        border: 1px solid #334155;
    }
    /* --- BỔ SUNG: Định nghĩa màu nền cho trang gốc khi KHÔNG bật Focus --- */
    #mainWrapper.theme-light {
        background-color: #ffffff !important;
        color: #1e293b !important;
    }
    #mainWrapper.theme-sepia {
        background-color: #fbf7ee !important; /* Màu nền giấy ố nhẹ dịu mắt */
        color: #433422 !important;
    }
    #mainWrapper.theme-dark {
        background-color: #1e293b !important; /* Màu nền tối bảo vệ mắt ban đêm */
        color: #f1f5f9 !important;
    }

    /* Đảm bảo thanh toolbar gốc ở đầu trang cũng chuyển màu mượt mà theo theme */
    #mainWrapper.theme-dark .toolbar {
        background-color: #111827 !important;
        border-color: #374151 !important;
    }
    #mainWrapper.theme-dark .toolbar button {
        color: #9ca3af !important;
    }
    #mainWrapper.theme-sepia .toolbar {
        background-color: #f4ecd8 !important;
        border-color: #e4dcbc !important;
    }
    #mainWrapper.theme-dark .text-segment {
        color: #f1f5f9 !important;
    }

    #mainWrapper.theme-sepia .text-segment {
        color: #433422 !important;
    }

    #mainWrapper.theme-light .text-segment {
        color: #1e293b !important;
    }

/* --- TRẠNG THÁI FIXED TOOLBAR KHI Ở FOCUS MODE --- */
.fixed-focus-toolbar {
    display: flex !important;
    flex-direction: column !important; /* Đổi thành cột dọc */
    gap: 12px !important;
    padding: 16px !important;
    background: white;
    border-radius: 24px;
    box-shadow: 0 10px 40px rgba(0,0,0,.15);
    border: 1px solid #e2e8f0;
    align-items: center !important;
}

/* Đồng bộ màu panel theo theme */
.theme-dark .fixed-focus-toolbar { background: #1e293b !important; border-color: #334155 !important; }
.theme-sepia .fixed-focus-toolbar { background: #f4ecd8 !important; border-color: #e4dcbc !important; }

/* Khi Focus bật: Ép toàn bộ chiếc khay tổng hợp xếp thành hàng dọc, căn lề sang bên phải */
.focus-layout-active {
    flex-direction: column !important;
    align-items: flex-end !important; /* Đẩy sát tất cả nút về bên phải màn hình */
    gap: 16px !important;
}

/* Đảm bảo khi xếp dọc, các nút text dài không bị co rúm */
.focus-layout-active button {
    width: fit-content !important;
}
/* Bảo vệ hình dáng của các nút tròn màu không bị bóp méo khi xếp dọc */
.fixed-focus-toolbar div div button, 
#readingControls div:last-child button {
    width: 24px !important;       /* Giữ nguyên chiều rộng */
    height: 24px !important;      /* Giữ nguyên chiều cao */
    flex-shrink: 0 !important;    /* Tuyệt đối không cho trình duyệt bóp nhỏ (Fix lỗi vạch dọc) */
    border-radius: 50% !important;/* Đảm bảo luôn luôn tròn trịa */
}

/* Đảm bảo cái khung viền bọc ngoài 3 nút tròn không bị bóp nghẹt */
#readingControls div:last-child {
    display: flex !important;
    flex-direction: row !important; /* Bên trong cụm màu luôn xếp hàng ngang */
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    min-width: 90px !important;    /* Đặt chiều rộng tối thiểu cho khay chứa màu */
}
</style>

@section Scripts {
    <script>
        function toggleChat() {
            const chatBox = document.getElementById('chat-box');
            const isHidden = chatBox.classList.contains('opacity-0');
            if (isHidden) {
                chatBox.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
            } else {
                chatBox.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }
        }

        async function handleAction(endpoint) {
            const inputElement = document.getElementById('user-input');
            const text = inputElement.value.trim();
            if (!text) return;

            appendMessage('user', text);
            inputElement.value = '';

            const loadingId = 'loading-' + Date.now();
            appendMessage('ai', '...', loadingId);

            try {
                const response = await fetch(`/Ai/${endpoint}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Text: text })
                });

                const data = await response.json();
                const resultText = data.translatedText || data.result;
                updateMessage(loadingId, resultText);
            } catch (error) {
                updateMessage(loadingId, "Error connection to server!");
            }
        }

        function appendMessage(sender, text, id = null) {
            const history = document.getElementById('chat-history');
            const wrapper = document.createElement('div');
            wrapper.className = sender === 'user' ? "flex justify-end" : "flex justify-start";

            const div = document.createElement('div');
            div.id = id;
            div.className = sender === 'user'
                ? "btn-grad text-left text-white p-3 rounded-2xl rounded-tr-none max-w-[85%] text-sm shadow-md transition-all"
                : "btn-grad-gray text-left border border-gray-200 text-gray-800 p-3 rounded-2xl rounded-tl-none max-w-[85%] text-sm shadow-sm whitespace-pre-line line-height-relaxed";

            div.innerText = text;
            wrapper.appendChild(div);
            history.appendChild(wrapper);
            history.scrollTop = history.scrollHeight;
        }

        function updateMessage(id, newText) {
            const el = document.getElementById(id);
            if (el) {
                el.innerHTML = marked.parse(newText);
                el.classList.add('ai-content');
                const history = document.getElementById('chat-history');
                history.scrollTop = history.scrollHeight;
            }
        }
    </script>

    <script>
        // --- CORE LOGIC ĐỌC TRUYỆN SONG NGỮ ---
        const chapterId = @chapterId;
        let currentFontSize = 18;
        let currentTheme = 'light';
        let isFocusMode = false;
        let isAllVietnamese = false;

        $(document).ready(function() {
            loadParagraphs();
        });

        function loadParagraphs() {
            $.ajax({
                url: '/Paragraphs/GetByChapter',
                type: 'GET',
                data: { chapterId },
                success: function(data) {
                    renderParagraphs(data);
                },
                error: function() {
                    console.error('Content cannot be loaded');
                }
            });
        }

        function renderParagraphs(paragraphs) {
            let html = '';
            paragraphs.forEach(p => {
                html += `
                        <span class="text-segment"
                              data-lang="en"
                              data-en="${escapeHtml(p.english)}"
                              data-vi="${escapeHtml(p.vietnamese)}">
                            ${escapeHtml(p.english)}
                        </span> `;
            });

            $('#paragraphList').html(html);
            bindEvents();
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function bindEvents() {
            $(document).off('dblclick', '.text-segment').on('dblclick', '.text-segment', function() {
                const $el = $(this);

                if ($el.closest('#focusContentContainer').length > 0) {
                    const index = $('#focusContentContainer .text-segment').index(this);
                    const $originalSegment = $('#paragraphList .text-segment').eq(index);

                    toggleLanguage($originalSegment);
                    $el.text($originalSegment.text());
                    $el.data('lang', $originalSegment.data('lang'));
                    $el.toggleClass('is-translated', $originalSegment.hasClass('is-translated'));
                } else {
                    toggleLanguage($el);
                }
            });

            $('#btnTranslateAll').off('click').on('click', function() {
                isAllVietnamese = !isAllVietnamese;
                const $btn = $(this);
                $btn.toggleClass('active', isAllVietnamese);

                $('.text-segment').each(function() {
                    const $el = $(this);
                    const currentLang = $el.data('lang');
                    if (isAllVietnamese && currentLang === 'en') {
                        toggleLanguage($el, 'vi');
                    } else if (!isAllVietnamese && currentLang === 'vi') {
                        toggleLanguage($el, 'en');
                    }
                });

                if (isFocusMode) {
                    $('#focusContentContainer').html($('#paragraphList').html());
                }

                $btn.find('.btn-text').text(isAllVietnamese ? 'Show English' : 'Translate all');
            });
        }

        function toggleLanguage($el, targetLang = null) {
            const currentLang = $el.data('lang');
            const nextLang = targetLang || (currentLang === 'en' ? 'vi' : 'en');
            if (currentLang === nextLang) return;

            $el.text(nextLang === 'vi' ? $el.data('vi') : $el.data('en'));
            $el.data('lang', nextLang);
            $el.toggleClass('is-translated', nextLang === 'vi');
        }

        function changeFontSize(step) {
            currentFontSize += step;
            if (currentFontSize < 14) currentFontSize = 14;
            if (currentFontSize > 32) currentFontSize = 32;

            $('#paragraphList').css('font-size', currentFontSize + 'px');
            $('#focusContentContainer').css('font-size', currentFontSize + 'px');
            $('#fontSizeDisplay').text(currentFontSize + 'px');
        }

        function changeTheme(themeName) {
            currentTheme = themeName;
            const $wrapper = $('#mainWrapper');
            const $overlay = $('#focusModeOverlay');

            $wrapper.removeClass('theme-light theme-sepia theme-dark').addClass('theme-' + themeName);
            $overlay.removeClass('theme-light theme-sepia theme-dark').addClass('theme-' + themeName);
        }

function toggleFocusMode() {
    isFocusMode = !isFocusMode;
    const $overlay = $('#focusModeOverlay');
    const $container = $('#focusContentContainer');
    const $controls = $('#readingControls');
    const $btn = $('#btnFocusMode');
    const $actionBox = $('#rightActionControls'); // Chiếc khay tổng hợp chứa nút

    if (isFocusMode) {
        changeTheme('light'); // Ép nền trắng khi vào Focus

        // 1. Copy nội dung truyện sang lớp phủ
        $container.html($('#paragraphList').html()).css('font-size', currentFontSize + 'px');
        
        // 2. Chuyển đổi thanh chỉnh font/theme thành dạng panel nhỏ gọn
        $controls.addClass('fixed-focus-toolbar');
        
        // 3. Chèn thanh chỉnh font/theme vào giữa (nằm ngay trước nút Chat quả địa cầu)
        $controls.insertBefore('#chat-button');
        
        // 4. Kích hoạt class ép toàn bộ các nút xếp thành một hàng dọc đứng
        $actionBox.addClass('focus-layout-active');

        // Hiển thị lớp phủ và chặn cuộn trang gốc
        $overlay.removeClass('hidden').addClass('block');
        $('body').addClass('overflow-hidden');

        $btn.addClass('bg-amber-500 text-white').find('.btn-text').text('Exit Focus');
        $btn.find('i').removeClass('fa-eye-slash').addClass('fa-eye');
    } else {
        // 1. Gỡ bỏ class hàng dọc, đưa cụm nút hành động về nằm ngang mặc định
        $actionBox.removeClass('focus-layout-active');

        // 2. Trả thanh chỉnh font/theme thoát khỏi cột dọc, đưa về vị trí toolbar đầu trang
        $controls.removeClass('fixed-focus-toolbar').appendTo('.reading-header .toolbar');

        // 3. Ẩn lớp phủ, xóa bản copy dữ liệu
        $overlay.removeClass('block').addClass('hidden');
        $container.empty();
        $('body').removeClass('overflow-hidden');

        $btn.removeClass('bg-amber-500 text-white').find('.btn-text').text('Focus Mode');
        $btn.find('i').removeClass('fa-eye').addClass('fa-eye-slash');
    }
}

        $(document).on('keydown', function(e) {
            if (e.key === "Escape" && isFocusMode) {
                toggleFocusMode();
            }
        });
    </script>
}