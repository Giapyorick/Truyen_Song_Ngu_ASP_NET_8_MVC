<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/content.css">

@{
    ViewData["Title"] = "Reading Experience";
    var chapterId = ViewBag.ChapterId;
}

<div class="reading-wrapper transition-all duration-300" id="mainWrapper">
    <!-- KHỐI TIÊU ĐỀ TRUYỆN VÀ CHƯƠNG -->
    <div id="storyChapterHeader" class="text-center py-6 px-4 border-b border-gray-100 bg-white rounded-t-2xl">
        <h1 id="txtStoryTitle" class="text-2xl md:text-3xl font-bold text-gray-800 tracking-tight mb-2">
            Đang tải tên truyện...
        </h1>
        <h2 id="txtChapterTitle" class="text-base md:text-lg font-medium text-teal-600">
            Đang tải chương...
        </h2>
    </div>

    <!-- Hướng dẫn nháy chuột dịch câu -->
    <div class="text-center py-3 bg-gray-50 border-b border-gray-100 hint-bar">
        <span class="hint text-xs text-gray-500 font-medium">
            <i class="fa-solid fa-circle-info me-1 text-blue-500"></i> Nháy chuột 2 lần trên câu để dịch truyện.
        </span>
    </div>

    <article id="paragraphList" class="reading-content p-8 min-h-[50vh] transition-all duration-300 pb-28" style="font-size: 18px;">
    </article>
</div>

<!-- THANH CÔNG CỤ CỐ ĐỊNH Ở ĐÁY MÀN HÌNH (Bình thường ghim giữa, khi Focus sẽ nhảy dạt góc phải) -->
<div id="fixedBottomBar" class="fixed bottom-5 left-1/2 -translate-x-1/2 flex items-center gap-3 p-2 bg-white/90 backdrop-blur-md border border-gray-200 rounded-2xl shadow-xl z-[1010] transition-all duration-300 max-w-[95vw] overflow-x-auto" style="background: linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%);">
    <!-- 1. Thanh chuyển chương -->
    <div id="chapterNavigation" class="flex items-center gap-1.5 bg-gray-50 border border-gray-200 rounded-xl p-1 text-sm shrink-0">
        <button onclick="goToChapter('first')" class="p-1.5 text-gray-600 hover:bg-white rounded-lg active:scale-95 transition" title="Chương đầu">
            <i class="fa-solid fa-backward-step"></i>
        </button>
        <button onclick="goToChapter('prev')" class="p-1.5 text-gray-600 hover:bg-white rounded-lg active:scale-95 transition" title="Chương trước">
            <i class="fa-solid fa-chevron-left"></i>
        </button>

        <select id="chapterSelect" onchange="onChapterSelectChange(this.value)" class="bg-transparent text-xs font-semibold text-gray-700 py-1 px-1 focus:outline-none cursor-pointer max-w-[120px]">
            <option value="">Đang tải...</option>
        </select>

        <button onclick="goToChapter('next')" class="p-1.5 text-gray-600 hover:bg-white rounded-lg active:scale-95 transition" title="Chương sau">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
        <button onclick="goToChapter('last')" class="p-1.5 text-gray-600 hover:bg-white rounded-lg active:scale-95 transition" title="Chương cuối">
            <i class="fa-solid fa-forward-step"></i>
        </button>
    </div>

    <!-- 2. Bộ chỉnh kích thước chữ -->
    <div class="flex items-center gap-1 border border-gray-200 bg-gray-50 rounded-xl p-1 text-sm shrink-0">
        <button onclick="changeFontSize(-2)" class="px-2.5 py-1 text-gray-600 hover:bg-white rounded-lg active:scale-95 transition" title="Decrease size">A-</button>
        <span id="fontSizeDisplay" class="px-2 text-xs text-gray-400 border-x border-gray-200">18px</span>
        <button onclick="changeFontSize(2)" class="px-2.5 py-1 text-gray-600 hover:bg-white rounded-lg active:scale-95 transition" title="Increase size">A+</button>
    </div>

    <!-- 3. Bộ chọn Theme màu nền -->
    <div id="themeSelectorGroup" class="flex items-center gap-1.5 border border-gray-200 bg-gray-50 rounded-xl p-1 text-sm shrink-0">
        <button onclick="changeTheme('light')" class="w-6 h-6 rounded-full border border-gray-300 bg-white" title="Light theme"></button>
        <button onclick="changeTheme('sepia')" class="w-6 h-6 rounded-full border border-yellow-700/20 bg-[#f4ecd8]" title="Sepia theme"></button>
        <button onclick="changeTheme('dark')" class="w-6 h-6 rounded-full border border-gray-700 bg-[#1e293b]" title="Dark theme"></button>
    </div>
</div>

<!-- CỤM NÚT ACTION GÓC PHẢI -->
<div id="rightActionControls" class="fixed bottom-5 right-5 flex items-center gap-3 z-[1010]">
    <button id="btnFocusMode" onclick="toggleFocusMode()" class="flex items-center gap-2 btn-grad border border-gray-200 text-white px-4 py-3 rounded-full shadow-lg transition-all duration-300 font-medium text-sm whitespace-nowrap" title="Focus Mode">
        <i class="fa-solid fa-eye-slash text-amber-500"></i>
        <span class="btn-text">Focus Mode</span>
    </button>

    <button id="btnTranslateAll" class="flex items-center gap-2 btn-grad border border-gray-200 text-white px-4 py-3 rounded-full shadow-lg transition-all duration-300 font-medium text-sm whitespace-nowrap" title="Translate all">
        <i class="fa-solid fa-language text-blue-600"></i>
        <span class="btn-text">Translate all</span>
    </button>

    <button onclick="toggleChat()" id="chat-button" class="flex items-center gap-2 btn-grad border border-gray-200 text-white px-4 py-3 rounded-full shadow-lg transition-all duration-300 font-medium text-sm whitespace-nowrap" title="Chat bot assistant">
        <span class="btn-text text-2xl leading-none">🌍</span>
    </button>
</div>

<!-- KHUNG CHAT AI -->
<div id="chat-box" class="fixed bottom-24 right-5 w-[400px] max-h-[600px] h-[70vh] bg-white shadow-2xl rounded-2xl overflow-hidden border border-gray-100 flex flex-col font-sans transition-all duration-300 transform translate-y-10 opacity-0 pointer-events-none z-50" style="z-index: 1011;">
    <div class="btn-grad p-4 flex justify-between items-center shadow-md">
        <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-green-600 rounded-full animate-pulse"></div>
            <h3 class="font-bold text-lg tracking-tight">AI Assistant</h3>
        </div>
        <button onclick="toggleChat()" class="hover:bg-white/30 p-2 rounded-full transition hover:rotate-90">
            <i class="fa-solid fa-x text-xl font-bold"></i>
        </button>
    </div>
    <div id="chat-history" class="flex-1 overflow-y-auto p-4 space-y-4 bg-[#f8f9fa]">
        <div class="flex justify-start">
            <div class="btn-grad-gray border border-gray-200 text-gray-700 p-3 rounded-2xl rounded-tl-none max-w-[85%] text-sm shadow-sm">
                Hello! 👋 I'm a translation assistant. Please enter the English word you need explained!
            </div>
        </div>
    </div>
    <div class="p-4 bg-white border-t border-gray-100">
        <textarea id="user-input" rows="1" class="w-full p-3 bg-gray-50 border text-black border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-400 focus:bg-white resize-none transition-all text-sm" placeholder="Type something..."></textarea>
        <div class="flex gap-2 mt-3">
            <button onclick="handleAction('Translate')" class="flex-1 btn-grad-trans text-white py-2.5 rounded-xl hover:bg-gray-200 transition-all text-xs font-bold">Translate</button>
            <button onclick="handleAction('Explain')" class="flex-1 btn-grad text-white py-2.5 rounded-xl shadow-lg transition-all text-xs font-bold">Explain</button>
        </div>
    </div>
</div>

<!-- LỚP PHỦ FOCUS MODE -->
<div id="focusModeOverlay" class="fixed inset-0 z-40 hidden transition-all duration-300">
    <div class="max-w-[800px] mx-auto h-full overflow-y-auto px-4 py-12">
        <div id="focusContentContainer" class="bg-white rounded-3xl p-8 shadow-xl min-h-full font-serif reading-content pb-28"></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.tailwindcss.com"></script>

<style>
