@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Localization
@using WebTruyenTranh
@inject IStringLocalizer<SharedResource> SharedLocalizer

@{
    ViewData["Title"] = SharedLocalizer["Reading_ExperienceTitle"] ?? "Reading Experience";
    var chapterId = ViewBag.ChapterId;
    var ttsEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    ViewBag.HideHotSidebar = true;
}

<!-- Literata: phông thiết kế cho đọc sách dài, hỗ trợ đầy đủ tiếng Việt (Lora giữ lại làm dự phòng) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;0,7..72,700;1,7..72,400&family=Lora:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<link rel="stylesheet" href="~/css/home/reading.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/home/reading-kindle.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/home/reading-tts.css" asp-append-version="true">

<!-- Nạp giao diện đọc truyện từ Partial View -->
<partial name="_ReadingViewPartial" />

<!-- Khung Chatbot AI (nếu có) -->
<partial name="_AiChatBoxPartial" optional="true" />

@section Scripts {
    <script>
        var currentChapterId = @chapterId;

        // Cung cấp từ điển nhãn giao diện cho Reader Component
        window.READER_LANG = {
            Chapter: @Json.Serialize(SharedLocalizer["Story_Chapter"].Value),
            PrevChapter: @Json.Serialize(SharedLocalizer["Reading_PrevChapter"]?.Value ?? "Chương trước"),
            NextChapter: @Json.Serialize(SharedLocalizer["Reading_NextChapter"]?.Value ?? "Chương sau"),
            ChapterList: @Json.Serialize(SharedLocalizer["Story_ChapterList"].Value),
            NoContent: @Json.Serialize(SharedLocalizer["Reading_NoContent"]?.Value ?? "Nội dung chương đang được cập nhật..."),
            BackToStory: @Json.Serialize(SharedLocalizer["Reading_BackToStory"]?.Value ?? "Quay lại trang truyện")
                };
    </script>
    <script src="~/js/home/reading/reading-viewer.js" asp-append-version="true"></script>
    <script src="~/js/home/reading/reading-progress.js" asp-append-version="true"></script>
    <script src="~/js/home/reading/reading-lang-flags.js" asp-append-version="true"></script>
    <script>
        // Nhãn giao diện cho trình nghe truyện (reading-tts.js)
        window.TTS_LANG = @Json.Serialize(ttsEn ? new {
            title = "Listen", play = "Play", pause = "Pause", stop = "Stop", prev = "Previous sentence", next = "Next sentence", close = "Close",
            speed = "Speed", mode = "Mode", modeShown = "Shown language", modeBoth = "Bilingual",
            autoNext = "Auto-play next chapter", hint = "Click any sentence to start reading from there",
            noVoice = "No voice installed on this device for: ", ended = "Finished this chapter.", ready = "Ready", reading = "Reading",
            noSupport = "This browser cannot read aloud.", aiVoice = "AI voice", aiVoiceTitle = "This chapter has AI voice audio (ElevenLabs)"
        } : new {
            title = "Nghe truyện", play = "Phát", pause = "Tạm dừng", stop = "Dừng", prev = "Câu trước", next = "Câu sau", close = "Đóng",
            speed = "Tốc độ", mode = "Chế độ", modeShown = "Ngôn ngữ đang hiện", modeBoth = "Song ngữ",
            autoNext = "Tự đọc chương sau", hint = "Bấm vào câu bất kỳ để đọc từ câu đó",
            noVoice = "Thiết bị chưa có giọng đọc cho ngôn ngữ: ", ended = "Đã đọc hết chương.", ready = "Sẵn sàng", reading = "Đang đọc",
            noSupport = "Trình duyệt này không hỗ trợ đọc to.", aiVoice = "Giọng AI", aiVoiceTitle = "Chương này có audio giọng AI (ElevenLabs)"
        });
    </script>
    <script src="~/js/home/reading/reading-tts.js" asp-append-version="true"></script>
    <script src="~/js/home/reading/ai-chatbox.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            if (typeof ReadingViewer !== 'undefined') {
                window.readerModule = new ReadingViewer({
                    chapterId: currentChapterId
                });
                window.readerModule.init();
            } else {
                console.error("Error: ReadingViewer class not ready. Please check the file path ~/js/home/reading/reading-viewer.js!");
            }
        });
    </script>
}
