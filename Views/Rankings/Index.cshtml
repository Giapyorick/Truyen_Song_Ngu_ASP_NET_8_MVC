@using Microsoft.Extensions.Localization
@using WebTruyenTranh
@using WebTruyenTranh.ViewModels
@inject IStringLocalizer<SharedResource> SharedLocalizer
@model IList<StoryListViewModel>
@{
    ViewData["Title"] = SharedLocalizer["Rank_PageTitle"].Value;
    string currentType = ViewBag.CurrentType ?? "likes";

    // Khởi tạo tiêu đề mặc định theo currentType
    string initTitle = SharedLocalizer["Rank_LikesTitle"].Value;
    string initDesc = SharedLocalizer["Rank_LikesDesc"].Value;
    if (currentType == "rate")
    {
        initTitle = SharedLocalizer["Rank_RateTitle"].Value;
        initDesc = SharedLocalizer["Rank_RateDesc"].Value;
    }
    else if (currentType == "follower")
    {
        initTitle = SharedLocalizer["Rank_FollowerTitle"].Value;
        initDesc = SharedLocalizer["Rank_FollowerDesc"].Value;
    }
    else if (currentType == "most_rated")
    {
        initTitle = SharedLocalizer["Rank_MostRatedTitle"].Value;
        initDesc = SharedLocalizer["Rank_MostRatedDesc"].Value;
    }
}

<div class="min-h-screen bg-[#F8FAFC] py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

        <!-- HEADER & THANH ĐIỀU HƯỚNG NÚT BẤM -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100 pb-5">
                <div>
                    <span class="text-xs font-bold text-cus uppercase tracking-wider flex items-center gap-2">
                         @SharedLocalizer["Rank_TrendingTop"]
                    </span>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-main mt-1">
                        @SharedLocalizer["Rank_PageTitle"]
                    </h1>
                </div>
                <div class="text-xs text-gray-400 font-medium">
                    @SharedLocalizer["Rank_Subtitle"]
                </div>
            </div>

            <!-- DANH SÁCH 4 NÚT XẾP HẠNG -->
            <div class="flex flex-wrap gap-3" id="rankBtnContainer">
                <button type="button"
                        onclick="switchRank('likes', '@Html.Raw(SharedLocalizer["Rank_LikesTitle"].Value)', '@Html.Raw(SharedLocalizer["Rank_LikesDesc"].Value)', this)"
                        class="rank-btn @(currentType == "likes" ? "active-rank" : "")">
                    <i class="fa-solid fa-heart text-rose-500"></i>
                    <span>@SharedLocalizer["Rank_LikesBtn"]</span>
                </button>

                <button type="button"
                        onclick="switchRank('rate', '@Html.Raw(SharedLocalizer["Rank_RateTitle"].Value)', '@Html.Raw(SharedLocalizer["Rank_RateDesc"].Value)', this)"
                        class="rank-btn @(currentType == "rate" ? "active-rank" : "")">
                    <i class="fa-solid fa-star text-amber-400"></i>
                    <span>@SharedLocalizer["Rank_RateBtn"]</span>
                </button>

                <button type="button"
                        onclick="switchRank('follower', '@Html.Raw(SharedLocalizer["Rank_FollowerTitle"].Value)', '@Html.Raw(SharedLocalizer["Rank_FollowerDesc"].Value)', this)"
                        class="rank-btn @(currentType == "follower" ? "active-rank" : "")">
                    <i class="fa-solid fa-bookmark text-teal-600"></i>
                    <span>@SharedLocalizer["Rank_FollowerBtn"]</span>
                </button>

                <button type="button"
                        onclick="switchRank('most_rated', '@Html.Raw(SharedLocalizer["Rank_MostRatedTitle"].Value)', '@Html.Raw(SharedLocalizer["Rank_MostRatedDesc"].Value)', this)"
                        class="rank-btn @(currentType == "most_rated" ? "active-rank" : "")">
                    <i class="fa-solid fa-fire text-orange-500"></i>
                    <span>@SharedLocalizer["Rank_MostRatedBtn"]</span>
                </button>
            </div>
        </div>

        <!-- TIÊU ĐỀ BẢNG HIỆN TẠI -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pl-4">
            <div>
                <h2 class="text-xl sm:text-2xl font-extrabold text-cus">
                    @SharedLocalizer["Rank_TablePrefix"] <span id="currentRankTitle" class="text-main">@initTitle</span>
                </h2>
                <p id="currentRankDesc" class="text-xs sm:text-sm text-gray-500 mt-1">
                    @initDesc
                </p>
            </div>
        </div>

        <!-- CONTAINER CHỨA THẺ TRUYỆN VÀ SENTINEL SCROLL -->
        <div id="rankStoryWrapper">
            <!-- ĐỂ RỖNG ĐỂ rankScroller TỰ TẢI CHUẨN XÁC TỪ PAGE 1, KHÔNG BỊ TRÙNG LẶP -->
            <div class="story-grid" id="mainStoryGrid">
            </div>

            <!-- SENTINEL TRIGGER VÀ LOADING KHI CUỘN ĐÁY -->
            <div id="infiniteScrollTrigger" class="py-10 flex flex-col items-center justify-center gap-2">
                <div id="scrollSpinner" class="flex items-center gap-2 text-teal-600 font-bold text-sm">
                    <i class="fa-solid fa-circle-notch fa-spin text-lg"></i>
                    <span>@SharedLocalizer["Story_LoadingStories"]</span>
                </div>
                <div id="noMoreData" class="hidden text-xs text-gray-400 font-medium py-4">
                    🎉 @SharedLocalizer["Rank_AllCaughtUp"]
                </div>
            </div>
        </div>

    </div>
</div>

<style>
.rank-btn {
    padding: 10px 22px;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 700;
    transition: all 0.5s ease;
    background-color: #ffffff;
    border: 1.5px solid #e2e8f0;
    color: #475569;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}
.rank-btn:hover:not(.active-rank) {
    border-color: #50C9C3;
    color: #0d9488;
    box-shadow: 0 4px 14px rgba(80, 201, 195, 0.18);
    transform: translateY(-2px);
}
.rank-btn.active-rank {
    background-image: linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%);
    background-size: 200% auto;
    color: #ffffff !important;
    border: 1.5px solid transparent;
    box-shadow: 0 6px 18px rgba(80, 201, 195, 0.35);
    transform: translateY(-2px);
}
.rank-btn.active-rank:hover {
    background-position: right center;
    color: #ffffff !important;
}
.rank-btn.active-rank i {
    color: #ffffff !important;
}
#currentRankTitle {
    background: linear-gradient(to right, #0d9488, #50C9C3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
</style>

@section Scripts {
    <script src="~/js/infinite_scroll.js"></script>

    <script>
        $(document).ready(function () {
            window.rankScroller = new InfiniteScroller({
                gridSelector: '#mainStoryGrid',
                triggerSelector: '#infiniteScrollTrigger',
                spinnerSelector: '#scrollSpinner',
                noMoreSelector: '#noMoreData',
                endpoint: '/Stories/GetStoriesInfinite',
                pageSize: 8,
                params: { 
                    type: '@currentType',
                    search: ''
                }
            });
        });

        function switchRank(type, title, desc, btnElem) {
            const newUrl = window.location.pathname + '?type=' + type;
            window.history.pushState({ type: type }, '', newUrl);

            $('.rank-btn').removeClass('active-rank');
            $(btnElem).addClass('active-rank');

            $('#currentRankTitle').text(title);
            $('#currentRankDesc').text(desc);

            if (window.rankScroller) {
                window.rankScroller.reset({ type: type, search: '' });
            }
        }
    </script>
}