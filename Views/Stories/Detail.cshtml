@model WebTruyenTranh.Models.TblStory
<link rel="stylesheet" href="~/css/Index/storyDetail.css" asp-append-version="true">
<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 85vh;">
    <div class="card border-0 shadow-xl overflow-hidden st-detail-card" style="border-radius: 32px; background: #ffffff; max-width: 1180px; width: 100%;">
        <div class="card-body p-4 p-lg-5">

            <!-- ROW PHÍA TRÊN -->
            <div class="row g-4">
                <div class="col-12">
                    <div class="st-top-row">

                        <div class="st-image-col st-image-section">
                            <div class="card st-panel h-100 overflow-hidden position-relative">
                                <div class="st-image-wrapper">
                                    <img src="/@Model.Img" class="st-main-img" alt="@Model.Title">
                                    <div class="st-image-overlay d-flex align-items-center justify-content-center p-4">
                                        <div class="px-3 text-center st-overlay-content w-100">
                                            <span class="st-status-badge">
                                                <span class="st-dot"></span> @Model.Status
                                            </span>
                                            <h2 class="st-overlay-title mt-2">@Model.Title</h2>
                                            <h2 class="st-overlay-title mt-2">@Model.Author.AuthorName</h2>
                                            <div class="st-description-scroll text-white">
                                                @Model.Description
                                            </div>
                                        </div>
                                    </div>
                                    <div class="position-absolute top-0 start-0 m-3" style="z-index: 10;">
                                        <span class="badge st-badge-id">#ID @Model.StoryId</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="st-info-col st-info-section">
                            <div class="card st-panel h-100">
                                <div class="card-body d-flex flex-column p-4">
            
                                    <!-- 1. PHẦN TIÊU ĐỀ & TRẠNG THÁI -->
                                    <div class="mb-2">
                                        <h3 class="fw-bold fs-4 text-cus mb-2"><i class="fas text-cus fa-book me-1"></i> Danh sách thể loại</h3>
                                    </div>

                                    <!-- 2. PHẦN THỂ LOẠI (CATEGORIES) MỚI THÊM VÀO -->
                                    <div class="mt-2 mb-3">
                                        <div class="d-flex flex-wrap gap-1.5 st-category-wrapper">
                                            <!-- Duyệt trực tiếp qua bảng trung gian TblCategoryOfStories đã được Include từ Controller -->
                                            @if (Model.TblCategoryOfStories != null && Model.TblCategoryOfStories.Any())
                                            {
                                                foreach (var item in Model.TblCategoryOfStories)
                                                {
                                                    if (item.Category != null)
                                                    {
                                                        <span class="badge st-badge-cat text-xs px-2.5 py-1.5 fw-semibold">
                                                            <i class="fas fa-tags me-1 text-muted opacity-60"></i> @item.Category.Name
                                                        </span>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic">Chưa phân loại</span>
                                            }
                                        </div>
                                    </div>

                                    <hr class="text-muted opacity-10 my-2">

                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-4 mt-2 w-100 st-stat-box-wrapper">

                                        <div class="st-stat-card flex-grow-1 p-2 text-center text-nowrap">
                                            <div class="st-stat-value text-wait fw-bold fs-6"><i class="fas text-wait fa-star"></i> @Model.Rate<small class="text-muted fs-xs">/5</small></div>
                                            <div class="st-stat-label text-wait opacity-75" style="font-size: 0.7rem;">@Model.CountRate đánh giá</div>
                                        </div>

                                        <div class="st-stat-card flex-grow-1 p-2 text-center text-nowrap">
                                            <div class="st-stat-value text-deny fw-bold fs-6"><i class="fas fa-heart text-deny"></i> @Model.Likes</div>
                                            <div class="st-stat-label text-deny opacity-75" style="font-size: 0.7rem;">Lượt thích</div>
                                        </div>

                                        <div class="st-stat-card flex-grow-1 p-2 text-center text-nowrap">
                                            <div class="st-stat-value text-accepted fw-bold" style="font-size: 0.85rem; padding-top: 2px; padding-bottom: 2px;">
                                                <i class="fas fa-calendar-alt text-accepted"></i> @Model.PublicationDate?.ToString("dd/MM/yyyy")
                                            </div>
                                            <div class="st-stat-label text-accepted opacity-75" style="font-size: 0.7rem;">Ngày đăng</div>
                                        </div>

                                    </div>

                                    <!-- 4. KHỐI NÚT HÀNH ĐỘNG Ở ĐÁY CARD -->
                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-4 mt-2 w-100 st-stat-box-wrapper">
                                        <div class="st-stat-card flex-grow-1 p-2 text-center text-nowrap">
                                            <div class="st-stat-value text-main fw-bold fs-6"><i class="fas fa-book-open text-main" ></i> Đọc ngay</div>
                                            <div class="st-stat-label text-main opacity-75" style="font-size: 0.7rem;">120 lượt đọc</div>

                                        </div>
                                        <div class="st-stat-card flex-grow-1 p-2 text-center text-nowrap">
                                            <div class="st-stat-value text-main fw-bold fs-6"><i class="fas fa-bookmark text-main"></i> Theo dõi</div>
                                            <div class="st-stat-label text-main opacity-75" style="font-size: 0.7rem;">23 lượt theo dõi</div>
                                        </div>
                                        <div class="st-stat-card flex-grow-1 p-2 text-center text-nowrap">
                                            <div class="st-stat-value text-main fw-bold  fs-6"><i class="fas fa-exclamation text-main"></i> Báo cáo</div>
                                            <div class="st-stat-label text-main opacity-75" style="font-size: 0.7rem;">0 lượt báo cáo</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="st-lower-row mt-4 mt-lg-5">
                <div class="st-glass-card st-chapters-container">
                    <div class="st-tabs-header mb-4">
                        <div class="st-tab-capsule ">
                            <i class="fa-solid fa-layer-group text-main"></i>
                            <span class="text-main">Danh Sách Chương</span>
                        </div>
                    </div>

                    <div id="chapters-panel">
                        @await Component.InvokeAsync("ChaptersList", new { storyId = Model.StoryId })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>