</style>

@section Scripts {
    <script>
        function switchProfileTab(tabName, btnElem) {
            $('.profile-tab-btn').removeClass('active-tab');
            $(btnElem).addClass('active-tab');

            $('#tabFollowedSection, #tabLikedSection, #tabReadSection, #tabVocabSection').addClass('hidden');

            if (tabName === 'followed') {
                $('#tabFollowedSection').removeClass('hidden');
            } else if (tabName === 'liked') {
                $('#tabLikedSection').removeClass('hidden');
            } else if (tabName === 'read') {
                $('#tabReadSection').removeClass('hidden');
            } else if (tabName === 'vocab') {
                $('#tabVocabSection').removeClass('hidden');
            }
        }

        function openImagePreview(src) {
            if (!src) return;
            $('#imageModalContent').attr('src', src);
            $('#imageModal').removeClass('hidden').addClass('flex');
        }

        function closeImagePreview() {
            $('#imageModal').addClass('hidden').removeClass('flex');
        }

        $('#imageModal').on('click', function (e) {
            if (e.target.id === 'imageModal') {
                closeImagePreview();
            }
        });

        $(document).on('keydown', function (e) {
            if (e.key === 'Escape' && !$('#imageModal').hasClass('hidden')) {
                closeImagePreview();
            }
        });

        function openEditProfileModal() {
            const $overlay = $('#editProfileModalOverlay');
            const $content = $('#editProfileModalContent');
            $overlay.removeClass('hidden').addClass('flex');
            setTimeout(() => $content.removeClass('translate-y-10 opacity-0').addClass('translate-y-0 opacity-100'), 10);
        }

        function closeEditProfileModal() {
            const $overlay = $('#editProfileModalOverlay');
            const $content = $('#editProfileModalContent');
            $content.removeClass('translate-y-0 opacity-100').addClass('translate-y-10 opacity-0');
            setTimeout(() => $overlay.removeClass('flex').addClass('hidden'), 300);
        }

        function previewEditAvatar(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('#editAvatarPreview').attr('src', e.target.result);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function deleteVocabItem(vocabId) {
            if (!confirm('Bạn có chắc chắn muốn xóa từ này khỏi sổ tay?')) return;

            $.ajax({
                url: '/Profile/DeleteVocabulary',
                type: 'POST',
                data: { id: vocabId },
                success: function (res) {
                    if (res.success) {
                        $(`#vocab-card-${vocabId}`).fadeOut(300, function () {
                            $(this).remove();
                            const countEl = $('#totalVocabCount');
                            if (countEl.length) {
                                countEl.text(Math.max(0, parseInt(countEl.text()) - 1));
                            }
                        });
                        showToast(res.message, 'success');
                    } else {
                        showToast(res.message, 'error');
                    }
                },
                error: function () {
                    showToast('Lỗi máy chủ khi xóa từ vựng!', 'error');
                }
            });
        }

        $('#editProfileForm').on('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(this);
            const $btn = $('#btnUpdateProfileSubmit');

            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i> Saving...');

            $.ajax({
                url: '/Profile/UpdateProfile',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    if (res.success) {
                        showToast(res.message, 'success');
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        showToast(res.message || 'Update failed!', 'error');
                    }
                },
                error: function () {
                    showToast('Cannot connect to the server!', 'error');
                },
                complete: function () {
                    $btn.prop('disabled', false).html('Save Changes');
                }
            });
        });

        function toggleVocabDetail(vocabId, btnElem) {
            const $detail = $(`#vocab-detail-${vocabId}`);
            const $icon = $(btnElem).find('i');
            const $label = $(btnElem).find('.btn-toggle-label');

            if ($detail.hasClass('hidden')) {
                $detail.removeClass('hidden').hide().slideDown(200);
                $icon.addClass('rotate-180'); $label.text('Thu gọn');
            } else {
                $detail.slideUp(200, function () {
                    $detail.addClass('hidden');
                });
                $icon.removeClass('rotate-180'); $label.text('Xem giải nghĩa');
            }
        }
    </script>
}