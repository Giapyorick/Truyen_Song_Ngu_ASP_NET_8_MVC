@using WebTruyenTranh.ViewModels
@model ProfileViewModel

@{
    ViewData["Title"] = SharedLocalizer["Profile_Title"].Value;
    var userAvatar = !string.IsNullOrEmpty(Model.User.Img) ? "/" + Model.User.Img : "/assets/image/placeholder.png";
}

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- 1. KHUNG THÔNG TIN CÁ NHÂN -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-56 h-56 bg-teal-50 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 relative z-10">
            <!-- Avatar -->
            <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden border-2 border-teal-500/30 shadow-md shrink-0 bg-slate-50">
                <img onclick="openImagePreview(this.src)" src="@userAvatar" alt="@Model.User.Name" class="w-full h-full object-cover cursor-pointer" onerror="this.src='/assets/image/placeholder.png';" />
            </div>

            <!-- Chi tiết User -->
            <div class="flex-1 text-center sm:text-left space-y-3">
                <div>
                    <div class="flex items-center justify-center sm:justify-start gap-3 flex-wrap">
                        <h1 class="text-2xl sm:text-3xl font-black text-main tracking-tight">
                            @(Model.User.Name ?? SharedLocalizer["Profile_NameNotUpdated"].Value)
                        </h1>

                        <button type="button"
                                onclick="openEditProfileModal()"
                                class="px-3 py-1.5 bg-white border border-teal-200 text-teal-700 hover:bg-teal-50 hover:border-teal-300 rounded-xl text-xs font-bold transition shadow-sm inline-flex items-center gap-1.5 active:scale-95"
                                title="@SharedLocalizer["Profile_EditProfile"]">
                            <i class="fa-solid fa-user-pen text-[11px]"></i>
                            <span>@SharedLocalizer["Btn_Edit"]</span>
                        </button>
                    </div>

                    <p class="text-xs text-slate-400 mt-1">
                        @SharedLocalizer["Profile_MemberSince"] @(Model.User.CreateAd?.ToString("dd/MM/yyyy") ?? SharedLocalizer["Profile_JoinedDateUnknown"].Value)
                    </p>
                </div>

                <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 text-xs text-slate-600 font-medium">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-slate-50 border border-slate-200">
                        <i class="fa-solid fa-envelope text-teal-600"></i>
                        <span>@(Model.User.Email ?? SharedLocalizer["Profile_NoEmail"].Value)</span>
                    </span>

                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-slate-50 border border-slate-200">
                        <i class="fa-solid fa-phone text-teal-600"></i>
                        <span>@(Model.User.Phone ?? SharedLocalizer["Profile_NoPhone"].Value)</span>
                    </span>

                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-slate-50 border border-slate-200">
                        <i class="fa-solid fa-venus-mars text-teal-600"></i>
                        <span>@(Model.User.Gender ?? SharedLocalizer["Profile_Other"].Value)</span>
                    </span>

                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-slate-50 border border-slate-200">
                        <i class="fa-solid fa-cake-candles text-teal-600"></i>
                        <span>@(Model.User.DoB?.ToString("dd/MM/yyyy") ?? SharedLocalizer["Profile_DateNotUpdated"].Value)</span>
                    </span>
                </div>
            </div>

            <!-- Thống kê -->
            <div class="flex flex-wrap justify-center sm:justify-start gap-3 shrink-0">
                <div class="stat-badge-grad stat-grad-teal">
                    <span class="block text-xl font-black">@Model.FollowedStories.Count</span>
                    <span class="text-[11px] font-bold uppercase tracking-wider opacity-90">@SharedLocalizer["Profile_Following"]</span>
                </div>
                <div class="stat-badge-grad stat-grad-rose">
                    <span class="block text-xl font-black">@Model.LikedStories.Count</span>
                    <span class="text-[11px] font-bold uppercase tracking-wider opacity-90">@SharedLocalizer["Profile_Liked"]</span>
                </div>
                <div class="stat-badge-grad stat-grad-amber">
                    <span class="block text-xl font-black">@Model.ReadStories.Count</span>
                    <span class="text-[11px] font-bold uppercase tracking-wider opacity-90">@SharedLocalizer["Profile_Read"]</span>
                </div>
                <div class="stat-badge-grad stat-grad-indigo">
                    <span class="block text-xl font-black" id="totalVocabCount">@Model.Vocabularies.Count</span>
                    <span class="text-[11px] font-bold uppercase tracking-wider opacity-90">
                        @(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("vi") ? "Sổ trích dẫn" : "Lorebook")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. THANH TAB CHUYỂN DANH SÁCH -->
    <div class="space-y-6">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <div class="flex flex-wrap gap-2 sm:gap-3">
                <button type="button" onclick="switchProfileTab('followed', this)" class="profile-tab-btn active-tab px-4 sm:px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm inline-flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-bookmark text-main"></i>
                    <span>@SharedLocalizer["Profile_FollowingStories"] (@Model.FollowedStories.Count)</span>
                </button>
                <button type="button" onclick="switchProfileTab('liked', this)" class="profile-tab-btn px-4 sm:px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm inline-flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-heart text-deny"></i>
                    <span>@SharedLocalizer["Profile_LikedStories"] (@Model.LikedStories.Count)</span>
                </button>
                <button type="button" onclick="switchProfileTab('read', this)" class="profile-tab-btn px-4 sm:px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm inline-flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-book-open-reader text-wait"></i>
                    <span>@SharedLocalizer["Profile_ReadStories"] (@Model.ReadStories.Count)</span>
                </button>
                <button type="button" onclick="switchProfileTab('vocab', this)" class="profile-tab-btn px-4 sm:px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm inline-flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-book-bookmark text-indigo-500"></i>
                    <span>@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("vi") ? "Sổ trích dẫn & Cốt truyện" : "Quotes & Lorebook") (@Model.Vocabularies.Count)</span>
                </button>
            </div>
        </div>

        <!-- 3. DANH SÁCH TRUYỆN THEO DÕI -->
        <div id="tabFollowedSection" class="profile-tab-content">
            @if (Model.FollowedStories.Any())
            {
                <div class="story-grid">
                    @await Html.PartialAsync("_StoryCardsPartial", Model.FollowedStories)
                </div>
            }
            else
            {
                <div class="text-center py-16 bg-white rounded-3xl border border-dashed border-slate-200 space-y-2">
                    <i class="fa-regular fa-bookmark text-3xl text-slate-300"></i>
                    <p class="text-sm font-bold text-slate-600">@SharedLocalizer["Profile_NoFollowedStories"]</p>
                    <p class="text-xs text-slate-400">@SharedLocalizer["Profile_NoFollowedStoriesHint"]</p>
                </div>
            }
        </div>

        <!-- 4. DANH SÁCH TRUYỆN ĐÃ THÍCH -->
        <div id="tabLikedSection" class="profile-tab-content hidden">
            @if (Model.LikedStories.Any())
            {
                <div class="story-grid">
                    @await Html.PartialAsync("_StoryCardsPartial", Model.LikedStories)
                </div>
            }
            else
            {
                <div class="text-center py-16 bg-white rounded-3xl border border-dashed border-slate-200 space-y-2">
                    <i class="fa-regular fa-heart text-3xl text-slate-300"></i>
                    <p class="text-sm font-bold text-slate-600">@SharedLocalizer["Profile_NoLikedStories"]</p>
                    <p class="text-xs text-slate-400">@SharedLocalizer["Profile_NoLikedStoriesHint"]</p>
                </div>
            }
        </div>

        <!-- 5. DANH SÁCH TRUYỆN ĐÃ ĐỌC -->
        <div id="tabReadSection" class="profile-tab-content hidden">
            @if (Model.ReadStories.Any())
            {
                <div class="story-grid">
                    @await Html.PartialAsync("_StoryCardsPartial", Model.ReadStories)
                </div>
            }
            else
            {
                <div class="text-center py-16 bg-white rounded-3xl border border-dashed border-slate-200 space-y-2">
                    <i class="fa-solid fa-book-open-reader text-3xl text-slate-300"></i>
                    <p class="text-sm font-bold text-slate-600">@SharedLocalizer["Profile_NoReadStories"]</p>
                    <p class="text-xs text-slate-400">@SharedLocalizer["Profile_NoReadStoriesHint"]</p>
                </div>
            }
        </div>

        <!-- 6. SỔ TAY TỪ VỰNG CÁ NHÂN (PILL BADGE GRADIENT & THU GỌN GIAO DIỆN) -->
        <div id="tabVocabSection" class="profile-tab-content hidden">
            @if (Model.Vocabularies.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var item in Model.Vocabularies)
                    {
                        <div id="vocab-card-@item.VocabId" class="bg-white rounded-3xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all space-y-3 relative group">

                            <!-- 1. HÀNG TIÊU ĐỀ: TỪ VỰNG DẠNG PILL BADGE & NÚT XÓA -->
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <div class="btn-grad-vocab bg-main text-xs sm:text-sm">
                                        
                                        <span>@item.WordOrPhrase</span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(item.StoryTitle))
                                    {
                                        <p class="text-[11px] text-slate-400 mt-1 flex items-center gap-1.5 font-medium">
                                            <i class="fa-solid fa-book-open text-main"></i>
                                            <span>@item.StoryTitle @(item.ChapterNumber.HasValue ? $"- Chương {item.ChapterNumber}" : "")</span>
                                        </p>
                                    }
                                </div>

                                <button type="button"
                                        onclick="deleteVocabItem(@item.VocabId)"
                                        class="text-slate-300 hover:text-rose-500 p-2 rounded-xl hover:bg-rose-50 transition active:scale-95"
                                        title="Xóa từ này">
                                    <i class="fa-solid fa-trash-can text-deny text-xs"></i>
                                </button>
                            </div>

                            <!-- 2. NGỮ CẢNH GỐC TRONG TRUYỆN -->
                            @if (!string.IsNullOrEmpty(item.ContextSentence))
                            {
                                <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100 text-xs text-slate-600 italic">
                                    <span class="font-bold not-italic text-slate-400 text-[10px] block uppercase tracking-wider mb-0.5">
                                        <i class="fa-solid fa-quote-left text-teal-500 mr-1"></i> Ngữ cảnh gốc:
                                    </span>
                                    "@item.ContextSentence"
                                </div>
                            }

                            <!-- 3. NÚT BẬT / TẮT XEM GIẢI NGHĨA -->
                            <div class="pt-0.5">
                                <button type="button"
                                        onclick="toggleVocabDetail(@item.VocabId, this)"
                                        class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-600 hover:text-teal-700 transition">
                                    <i class="fa-solid fa-chevron-down text-[10px] transition-transform duration-200"></i>
                                    <span class="btn-toggle-label">Xem giải nghĩa</span>
                                </button>
                            </div>

                            <!-- 4. KHỐI NỘI DUNG ẨN: RENDER NGUYÊN VẸN HTML ĐÃ LƯU BẰNG Html.Raw -->
                            <div id="vocab-detail-@item.VocabId" class="hidden space-y-2.5 pt-2 border-t border-slate-100">
                                <div class="btn-grad-gray ai-content p-3.5 rounded-2xl text-xs sm:text-[13px] leading-relaxed text-slate-800">
                                    @Html.Raw(item.Explanation)
                                </div>

                                <div class="text-[10px] text-slate-400 text-right font-medium">
                                    <i class="fa-regular fa-clock mr-1"></i> Đã lưu: @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-16 bg-white rounded-3xl border border-dashed border-slate-200 space-y-2">
                    <i class="fa-solid fa-book-bookmark text-3xl text-slate-300"></i>
                    <p class="text-sm font-bold text-slate-600">
                        @(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("vi") ? "Chưa có trích dẫn hoặc ghi chú nào" : "No saved quotes or lore notes yet")
                    </p>
                    <p class="text-xs text-slate-400">
                        @(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("vi") ? "Khi đọc truyện, hãy bôi đen đoạn tâm đắc và bấm \"Hỏi AI\" rồi chọn \"Lưu trích dẫn\" nhé!" : "Highlight compelling lines while reading, ask AI, and save them to your lorebook!")
                    </p>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL XEM ẢNH AVATAR -->
<div id="imageModal"
     class="fixed inset-0 bg-black/75 backdrop-blur-sm hidden items-center justify-center z-[999] transition-all duration-300">

    <div class="relative max-w-[90vw] max-h-[90vh] flex items-center justify-center p-2">
        <img id="imageModalContent"
             src=""
             alt="Enlarged Avatar"
             class="max-w-full max-h-[85vh] rounded-2xl shadow-2xl object-contain border border-white/20" />

        <button type="button"
                onclick="closeImagePreview()"
                class="absolute -top-3 -right-3 w-10 h-10 rounded-full bg-slate-900/80 hover:bg-rose-600 text-white flex items-center justify-center shadow-lg transition-colors text-xl font-bold leading-none border border-white/20">
            &times;
        </button>
    </div>
</div>

<!-- MODAL EDIT PROFILE -->
<div id="editProfileModalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[999] transition-all duration-300">
    <div id="editProfileModalContent" class="bg-white w-full max-w-xl rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-10 opacity-0 transition-all duration-300">
        <div class="p-6 border-b border-gray-100 relative bg-gradient-to-r from-gray-50 to-white text-center">
            <h3 class="text-xl font-extrabold text-cus">@SharedLocalizer["Profile_EditProfile"]</h3>
            <p class="text-xs text-gray-400 mt-1">@SharedLocalizer["Profile_UpdateAccountInformation"]</p>
            <button onclick="closeEditProfileModal()" class="absolute right-5 top-5 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-rose-50 hover:text-rose-500 transition-all text-xl">
                &times;
            </button>
        </div>

        <form id="editProfileForm" enctype="multipart/form-data" class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
            <!-- Avatar -->
            <div class="flex flex-col items-center gap-2">
                <div class="relative w-24 h-24 rounded-full border-2 border-dashed border-teal-300 bg-teal-50/40 flex items-center justify-center overflow-hidden">
                    <img id="editAvatarPreview" src="@userAvatar" class="w-full h-full object-cover" />
                </div>
                <input type="file" name="formFile" id="editAvatarInput" accept="image/*" class="hidden" onchange="previewEditAvatar(this)" />
                <button type="button" onclick="$('#editAvatarInput').click()" class="px-3 py-1 bg-white border border-gray-200 rounded-xl text-xs font-semibold text-gray-700 hover:bg-teal-50 hover:text-teal-700 transition">
                    @SharedLocalizer["Profile_ChangeAvatar"]
                </button>
            </div>

            <!-- Name -->
            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["User_FullName"]</label>
                <input type="text" name="Name" value="@Model.User.Name" required
                       class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all">
            </div>

            <!-- Email & Phone -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["Auth_Email"]</label>
                    <input type="email" name="Email" value="@Model.User.Email" required
                           class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all">
                </div>
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["User_Phone"]</label>
                    <input type="text" name="Phone" value="@Model.User.Phone"
                           class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all">
                </div>
            </div>

            <!-- Password -->
            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["Profile_NewPasswordHint"]</label>
                <input type="password" name="Passwork" placeholder="••••••••"
                       class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all">
            </div>

            <!-- Date of Birth & Gender -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["User_DoB"]</label>
                    <input type="date" name="DoB" value="@(Model.User.DoB?.ToString("yyyy-MM-dd"))"
                           class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all datepicker">
                </div>
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["User_Gender"]</label>
                    <select name="Gender" class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all">
                        <!option value="Male" @(Model.User.Gender == "Male" ? "selected" : "")>@SharedLocalizer["Gender_Male"]</!option>
                        <!option value="Female" @(Model.User.Gender == "Female" ? "selected" : "")>@SharedLocalizer["Gender_Female"]</!option>
                    </select>
                </div>
            </div>

            <div class="pt-3">
                <button type="submit" id="btnUpdateProfileSubmit"
                        class="w-full py-3 btn-grad text-white rounded-xl font-bold text-sm shadow-lg hover:shadow-teal-200 active:scale-95 transition-all">
                    @SharedLocalizer["Profile_SaveChanges"]
                </button>
            </div>
        </form>
    </div>
</div>

<style>
.profile-tab-btn {
background-color: #ffffff;
border: 1.5px solid #e2e8f0;
color: #64748b;
cursor: pointer;
}

.profile-tab-btn:hover:not(.active-tab) {
border-color: #50C9C3;
color: #0f766e;
}

.profile-tab-btn.active-tab {
background-image: linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%);
background-size: 200% auto;
color: #ffffff !important;
border-color: transparent;
box-shadow: 0 4px 12px rgba(80, 201, 195, 0.3);
}

.profile-tab-btn.active-tab i {
color: #ffffff !important;
}

.stat-badge-grad {
min-width: 90px;
padding: 10px 18px;
text-align: center;
border-radius: 16px;
color: #ffffff !important;
transition: 0.5s ease;
background-size: 200% auto;
user-select: none;
cursor: default;
}

.stat-badge-grad:hover {
background-position: right center;
transform: translateY(-2px);
}

.stat-grad-teal {
background-image: linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%);
box-shadow: 0 4px 15px rgba(80, 201, 195, 0.35);
}

.stat-grad-teal:hover {
box-shadow: 0 6px 20px rgba(80, 201, 195, 0.5);
}

.stat-grad-rose {
background-image: linear-gradient(to right, #ff416c 0%, #ff4b2b 51%, #ff416c 100%);
box-shadow: 0 4px 15px rgba(255, 65, 108, 0.35);
}

.stat-grad-rose:hover {
box-shadow: 0 6px 20px rgba(255, 65, 108, 0.5);
}

.stat-grad-amber {
background-image: linear-gradient(to right, #f7971e 0%, #ffd200 51%, #f7971e 100%);
box-shadow: 0 4px 15px rgba(247, 151, 30, 0.35);
}

.stat-grad-amber:hover {
box-shadow: 0 6px 20px rgba(247, 151, 30, 0.5);
}

.stat-grad-indigo {
background-image: linear-gradient(to right, #667eea 0%, #764ba2 51%, #667eea 100%);
box-shadow: 0 4px 15px rgba(102, 126, 234, 0.35);
}

.stat-grad-indigo:hover {
box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
}
/* ==========================================================================
BỔ SUNG CSS CHO BADGE TỪ VỰNG TRÊN TRANG PROFILE
========================================================================== */
.badge-pill {
display: inline-flex !important;
align-items: center !important;
gap: 5px !important;
padding: 4px 11px !important;
border-radius: 20px !important;
font-size: 14px !important;
font-weight: 800 !important;
color: #ffffff !important;
line-height: 2 !important;
letter-spacing: -0.01em !important;
border: none !important;
user-select: none !important;
margin: 6px 0 3px 0 !important;
}

.badge-pill i {
color: #ffffff !important;
font-size: 12px !important;
}

/* Các dải màu gradient nền */
.badge-pill.bg-main {
background: linear-gradient(to right, #50C9C3 0%, #96DEDA 100%) !important;
box-shadow: 0 3px 10px rgba(80, 201, 195, 0.35) !important;
}

.badge-pill.bg-cus {
background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
box-shadow: 0 3px 10px rgba(102, 126, 234, 0.3) !important;
}

.badge-pill.bg-info {
background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%) !important;
box-shadow: 0 3px 10px rgba(0, 198, 255, 0.3) !important;
}

.badge-pill.bg-wait {
background: linear-gradient(135deg, #FF8008 0%, #FFC837 100%) !important;
box-shadow: 0 3px 10px rgba(255, 128, 8, 0.3) !important;
}

.badge-pill.bg-accepted {
background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%) !important;
box-shadow: 0 3px 10px rgba(17, 153, 142, 0.3) !important;
}

.badge-pill.bg-deny {
background: linear-gradient(135deg, #EB3349 0%, #F45C43 100%) !important;
box-shadow: 0 3px 10px rgba(235, 51, 73, 0.3) !important;
}

/* Tối ưu danh sách gạch đầu dòng từ vựng hiển thị trong thẻ card */
.ai-content ul {
list-style-type: none !important;
padding-left: 0 !important;
margin: 4px 0 6px 0 !important;
}

.ai-content li {
position: relative;
padding-left: 14px !important;
