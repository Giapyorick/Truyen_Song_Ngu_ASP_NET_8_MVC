                            <i class="fa-solid fa-magnifying-glass absolute left-2.5 text-teal-600 text-[11px] pointer-events-none"></i>

                            <!-- Nút tắt / xóa từ khóa -->
                            <button type="button"
                                    id="btnCloseSearch"
                                    class="absolute right-2 text-slate-400 hover:text-rose-500 text-xs transition">
                                <i class="fa-solid fa-circle-xmark"></i>
                            </button>
                        </div>
                    </div>
                </li>
                <li>
                    <a href="#" class="nav-link">
                        <i class="fa-solid fa-language"></i>
                        <span>Bilingual EN-VI</span>
                        <span class="nav-badge">HOT</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Categories" asp-action="Index"
                       class="nav-link @(currentController.Equals("Categories", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        <i class="fa-solid fa-layer-group"></i>
                        <span>Categories</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Rankings" asp-action="Index"
                       class="nav-link @(currentController.Equals("Rankings", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        <i class="fa-solid fa-chart-simple"></i>
                        <span>Rankings</span>
                    </a>
                </li>
            </ul>
        </nav>

        <!-- KHU VỰC TÀI KHOẢN (ĐĂNG NHẬP / PROFILE) -->
        <div class="header-actions">
            @if (currentUserId > 0)
            {
                <!-- ĐÃ ĐĂNG NHẬP: Hiển thị Avatar/Tên và Nút Đăng xuất -->
                <div class="flex items-center gap-3">
                    <a asp-controller="Profile" asp-action="Index"
                       class="flex items-center gap-2 text-slate-700 hover:text-teal-700 font-bold text-sm bg-slate-50 hover:bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200 transition"
                       title="Profile">
                        <i class="fa-solid fa-circle-user text-main text-lg"></i>
                        <span class="max-w-[120px] text-main truncate">@currentUserName</span>
                    </a>
                    <a asp-controller="Login" asp-action="Logout" class="text-xs font-semibold text-rose-500 hover:text-rose-700 bg-white px-3 py-3 rounded-xl transition" title="Logout">
                        <i class="fa-solid text-deny fa-arrow-right-from-bracket"></i>
                    </a>
