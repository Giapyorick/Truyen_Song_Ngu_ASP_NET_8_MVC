            </div>
            <div class="slide">
                <div class="banner-overlay"></div>
                <div class="banner-content">
                    <span class="badge">Đề cử</span>
                    <h1 class="banner-title">Omniscient Reader</h1>
                    <p class="banner-desc">Khi thế giới bạn đang sống biến thành tình tiết trong một cuốn tiểu thuyết.</p>
                    <div class="banner-actions">
                        <a href="#" class="btn-grad">Đọc ngay</a>
                        <a href="#" class="btn-grad-trans">Thêm thư viện</a>
                    </div>
                </div>
                <div class="banner-visual">
