            .slides-container {
                position: relative;
                width: 100%;
                height: 100%;
            }

            .slide {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
                visibility: hidden;
                transition: opacity 1s ease-in-out, visibility 1s;
                display: flex;
                align-items: center;
            }

                .slide.active {
                    opacity: 1;
                    visibility: visible;
                }

            .banner-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient(to right, #ffffff 45%, rgba(255, 255, 255, 0.2) 100%);
                z-index: 2;
            }

            .banner-content {
                position: relative;
                z-index: 3;
                padding-left: 4rem;
                max-width: 500px;
                transform: translateY(20px);
                transition: 0.8s all ease;
                opacity: 0;
            }

            .slide.active .banner-content {
                transform: translateY(0);
                opacity: 1;
            }

            .badge {
                background: #e0e7ff;
                color: #4f46e5;
                padding: 6px 12px;
                border-radius: 20px;
                font-size: 0.85rem;
                font-weight: 700;
                display: inline-block;
                margin-bottom: 1rem;
            }

            .banner-title {
                font-size: 2.8rem;
                font-weight: 800;
                color: #0f172a;
                line-height: 1.2;
                margin-bottom: 1rem;
            }

            .banner-desc {
                color: #475569;
                font-size: 1rem;
                margin-bottom: 2rem;
            }

            .banner-actions {
                display: flex;
                gap: 12px;
            }

            .btn-main {
                background: #4f46e5;
                color: white !important;
                padding: 12px 28px;
                border-radius: 12px;
                font-weight: 600;
                box-shadow: 0 4px 14px rgba(79, 70, 229, 0.3);
                transition: 0.3s;
            }

                .btn-main:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(79, 70, 229, 0.4);
                }

            .btn-sub {
                background: #ffffff;
                color: #475569 !important;
                border: 1px solid #cbd5e1;
                padding: 12px 28px;
                border-radius: 12px;
                font-weight: 600;
                transition: 0.3s;
            }

                .btn-sub:hover {
                    background: #f8fafc;
                    border-color: #94a3b8;
                }

            .banner-visual {
                position: absolute;
                right: 0;
                top: 0;
                width: 60%;
                height: 100%;
                z-index: 1;
            }

                .banner-visual img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

            .slide-dots {
                position: absolute;
                bottom: 25px;
                left: 4rem;
                z-index: 4;
                display: flex;
                gap: 8px;
            }

            .dot {
                width: 8px;
                height: 8px;
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                border-radius: 50%;
                cursor: pointer;
                transition: 0.3s;
            }

                .dot.active {
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    width: 24px;
                    border-radius: 10px;
                }

            .hot-sidebar {
                background-color: #ffffff;
                border-radius: 12px;
                padding: 16px;
                box-shadow: 0 4px 12px rgba(80, 201, 195, 0.15);
                max-width: 360px;
                border: 1px solid rgba(80, 201, 195, 0.2);
            }

            /* Tiêu đề: Giữ nguyên màu gradient gốc nổi bật nhất */
            .sidebar-title {
                font-size: 1.1rem;
                font-weight: 800;
                text-transform: uppercase;
                margin-bottom: 16px;
                padding-bottom: 8px;
                display: flex;
                align-items: center;
                gap: 8px;
                /* Dùng gradient cho chữ */
                background: linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                /* Viền dưới dùng gradient */
                border-bottom: 2px solid transparent;
                border-image: linear-gradient(to right, #50C9C3, #96DEDA) 1;
            }

            .hot-list {
                display: flex;
                flex-direction: column;
                gap: 12px;
            }

            .hot-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 8px;
                border-radius: 8px;
                transition: background-color 0.2s ease, transform 0.2s ease;
            }

                /* Khi hover chuyển sang màu ánh teal mờ nhẹ */
                .hot-item:hover {
                    background-color: rgba(80, 201, 195, 0.08);
                    transform: translateX(4px);
                }

                /* Kiểu dáng chung cho huy hiệu thứ hạng */
                .hot-item .rank {
                    font-size: 1rem;
                    font-weight: 800;
                    min-width: 28px;
                    height: 28px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 50%;
                    background-color: #f1f5f9;
                    color: #64748b;
                    flex-shrink: 0;
                    transition: all 0.3s ease;
                }

                /* Top 1: Màu rõ nét nhất (Đậm nhất theo bảng màu) */
                .hot-item:nth-child(1) .rank {
                    background: linear-gradient(135deg, #50C9C3 0%, #96DEDA 100%);
                    color: #ffffff;
                    box-shadow: 0 2px 8px rgba(80, 201, 195, 0.4);
                }

                /* Top 2: Mờ dần (Giảm độ đậm và độ mờ opacity còn ~75%) */
                .hot-item:nth-child(2) .rank {
                    background: linear-gradient(135deg, rgba(80, 201, 195, 0.75) 0%, rgba(150, 222, 218, 0.75) 100%);
                    color: #ffffff;
                    box-shadow: 0 2px 6px rgba(80, 201, 195, 0.25);
                }

                /* Top 3: Mờ hơn nữa (Độ mờ opacity còn ~50%) */
                .hot-item:nth-child(3) .rank {
                    background: linear-gradient(135deg, rgba(80, 201, 195, 0.5) 0%, rgba(150, 222, 218, 0.5) 100%);
                    color: #ffffff;
                    box-shadow: 0 2px 4px rgba(80, 201, 195, 0.15);
                }

                /* Top 4 trở đi: Rất nhạt, hòa với nền */
                .hot-item:nth-child(n+4) .rank {
                    background-color: rgba(80, 201, 195, 0.15);
                    color: #50C9C3;
                }

            .hot-item-img {
                width: 50px;
                height: 65px;
                flex-shrink: 0;
                overflow: hidden;
                border-radius: 6px;
            }

                .hot-item-img img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    transition: transform 0.3s ease;
                }

            .hot-item:hover .hot-item-img img {
                transform: scale(1.08);
            }

            .hot-item-info {
                display: flex;
                flex-direction: column;
                justify-content: center;
                gap: 3px;
                overflow: hidden;
            }

            .hot-item-title {
                font-size: 0.95rem;
                font-weight: 600;
                color: #2b2b2b;
                text-decoration: none;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                transition: color 0.2s ease;
            }

                .hot-item-title:hover {
                    color: #e63946;
                }

            .hot-item-author {
                font-size: 0.8rem;
                color: #6c757d;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .hot-item-view {
                font-size: 0.75rem;
                color: #8c8c8c;
            }
    </style>
</body>
</html>