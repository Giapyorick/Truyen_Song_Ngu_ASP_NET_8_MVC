@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Localization
@using WebTruyenTranh.ViewModels
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Hosting
@inject IStringLocalizer<SharedResource> SharedLocalizer
@inject Microsoft.Extensions.Configuration.IConfiguration AppConfig
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnv

@{
    int currentUserId = Context.Session.GetInt32("UserId") ?? 0;
    string currentUserName = Context.Session.GetString("UserName") ?? "";
    var requestCultureFeature = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCultureFeature?.RequestCulture.UICulture.Name ?? "vi-VN";
    // Lấy URL hiện tại bao gồm cả Query String (ví dụ: /Stories/Detail?id=71)
    var returnUrl = string.Concat(Context.Request.Path, Context.Request.QueryString);

    // --- Dùng cho giao diện mobile (css/home/mobile.css) ---
    string mController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool mIsVi = currentCulture.StartsWith("vi", StringComparison.OrdinalIgnoreCase);
    bool mIsReading = mController.Equals("Paragraphs", StringComparison.OrdinalIgnoreCase);
    Func<string, string> mTabActive = c => mController.Equals(c, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    // --- Google AdSense (cấu hình trong appsettings.json > "GoogleAdSense") ---
    var adCfg = AppConfig.GetSection("GoogleAdSense");
    string adClient = adCfg["ClientId"] ?? "";
    bool adEnabled = adCfg.GetValue<bool>("Enabled") && adClient.StartsWith("ca-pub-") && !adClient.EndsWith("0000000000000000");
    bool adPreview = !adEnabled && HostEnv.IsDevelopment();   // máy dev: hiện khung giữ chỗ để xem bố cục
    // Chỉ đặt quảng cáo ở trang có nội dung (AdSense không cho đặt ở trang đăng nhập, lỗi, trang trống...)
    string[] adPages = { "Home", "Stories", "Categories", "Rankings" };
    // Không đặt quảng cáo ở các trang thông tin (Giới thiệu / Liên hệ / Chính sách)
    string mAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string[] adExcludedActions = { "About", "Contact", "Privacy" };
    bool adOnThisPage = (adEnabled || adPreview) && !mIsReading
                        && adPages.Any(p => p.Equals(mController, StringComparison.OrdinalIgnoreCase))
                        && !adExcludedActions.Any(a => a.Equals(mAction, StringComparison.OrdinalIgnoreCase));
    string adLabel = mIsVi ? "Quảng cáo" : "Advertisement";
    string adTopSlot = adCfg["TopBannerSlot"] ?? "";
    string adFeedSlot = adCfg["InFeedSlot"] ?? "";
    int adRows = adCfg.GetValue<int?>("RowsBetweenFeedAds") ?? 4;

    // --- Chế độ sáng / tối (css/home/dark-theme.css + js/home/common/theme-toggle.js) ---
    // Bật ở mọi trang người đọc, TRỪ trang đọc truyện (đã có theme sáng/sepia/tối riêng).
    // Trang nào muốn tắt: đặt ViewBag.DarkModeReady = false trong view.
    bool themeReady = (ViewBag.DarkModeReady as bool?) ?? !mIsReading;
}
<!DOCTYPE html>
<html lang="en" @(themeReady ? "data-theme-ready" : "")>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @if (themeReady)
    {
        <!-- Áp chế độ tối TRƯỚC khi trang hiện ra để không bị nháy trắng (lựa chọn lưu ở localStorage "site-theme") -->
        <script>
            (function () {
                try {
                    var t = localStorage.getItem('site-theme');
                    if (t !== 'dark' && t !== 'light') {
                        t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                    }
                    if (t === 'dark') document.documentElement.classList.add('dark');
                } catch (e) { }
            })();
        </script>
        <meta name="color-scheme" content="light dark">
    }
    <title>Bilingual Manga</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- CSS Modal Auth, Select2 & Flatpickr -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
    <link rel="stylesheet" href="~/css/home/auth-modal.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/home/layout.css" asp-append-version="true">
    <!-- Giao diện mobile: chỉ có tác dụng ở màn hình nhỏ -->
    <link rel="stylesheet" href="~/css/home/mobile.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/home/hero-banner.css" asp-append-version="true">
    <!-- Hiệu ứng nút gradient dùng chung (chỉ hiệu ứng, giữ màu cũ) -->
    <link rel="stylesheet" href="~/css/buttons-fx.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/home/ads.css" asp-append-version="true">
    <!-- Nút trái tim "Ủng hộ" + hộp mã QR -->
    <link rel="stylesheet" href="~/css/home/donate.css" asp-append-version="true">
    @if (themeReady)
    {
        <!-- Chế độ tối: chỉ có tác dụng khi <html> có class "dark" -->
        <link rel="stylesheet" href="~/css/home/dark-theme.css" asp-append-version="true">
    }

    @if (adEnabled && adOnThisPage)
    {
        <!-- Google AdSense -->
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=@adClient" crossorigin="anonymous"></script>
    }

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
            tailwind.config = {
                darkMode: 'class'
            }
    </script>
</head>
<body class="bg-white @(mIsReading ? "m-reading" : "")">

<header class="app-header">
    <!-- Logo -->
    <a asp-controller="Home" asp-action="Index" class="logo-group">
        <div class="logo-icon">
            <i class="fa-solid fa-book-journal-whills"></i>
        </div>
        <div class="logo-text">
            <span class="logo-title">BILINGUAL</span>
            <span class="logo-sub">NOVEL</span>
        </div>
    </a>

<!-- CỤM THANH ĐIỀU HƯỚNG TRUNG TÂM -->
    <nav class="main-nav">
        @{
            string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        }
        <ul class="flex items-center gap-1">
            <!-- 1. Trang chủ -->
            <li class="nav-menu-item transition-all duration-200">
                <a asp-controller="Home" asp-action="Index"
                   class="nav-link @(currentController.Equals("Home", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <i class="fa-solid fa-house"></i>
                    <span>@SharedLocalizer["Nav_Home"]</span>
                </a>
            </li>

            <li class="relative flex items-center">
                <button type="button"
                        id="btnOpenSearch"
                        class="nav-link flex items-center justify-center p-2 text-slate-600 hover:text-teal-700 transition"
                        title="@SharedLocalizer["Nav_SearchTooltip"]">
                    <i class="fa-solid fa-magnifying-glass text-base"></i>
                </button>

                <div id="searchBarContainer"
                     class="hidden opacity-0 scale-95 transition-all duration-300 origin-right items-center pl-1 pr-2">
                    <div class="relative flex items-center w-full">
                        <!-- Tăng kích thước ô input: w-72 sm:w-96 md:w-[450px], py-2, text-sm -->
                        <input type="text"
                               id="liveSearchInput"
                               autocomplete="off"
                               placeholder="@SharedLocalizer["Nav_SearchPlaceholder"]"
                               class="w-72 sm:w-96 md:w-[450px] pl-9 pr-8 py-2 text-sm rounded-full border border-teal-400 bg-white focus:border-teal-500 focus:ring-2 focus:ring-teal-200 outline-none transition text-slate-800 shadow-md font-medium" />
                        
                        <i class="fa-solid fa-magnifying-glass absolute left-3 text-teal-600 text-xs pointer-events-none"></i>

                        <button type="button"
                                id="btnCloseSearch"
                                class="absolute right-3 text-slate-400 hover:text-rose-500 text-sm transition">
                            <i class="fa-solid fa-circle-xmark"></i>
                        </button>
                    </div>
                </div>
            </li>

            <!-- 3. Song ngữ Novel -->
            <li class="nav-menu-item transition-all duration-200">
                <a href="#" class="nav-link">
                    <i class="fa-solid fa-language"></i>
                    <span>@SharedLocalizer["Nav_Bilingual"]</span>
                    <span class="nav-badge">@SharedLocalizer["Nav_BilingualBadge"]</span>
                </a>
            </li>

            <!-- 4. Thể loại -->
            <li class="nav-menu-item transition-all duration-200">
                <a asp-controller="Categories" asp-action="Index"
                   class="nav-link @(currentController.Equals("Categories", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>@SharedLocalizer["Nav_Categories"]</span>
                </a>
            </li>

            <!-- 5. Xếp hạng -->
            <li class="nav-menu-item transition-all duration-200">
                <a asp-controller="Rankings" asp-action="Index"
                   class="nav-link @(currentController.Equals("Rankings", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <i class="fa-solid fa-chart-simple"></i>
                    <span>@SharedLocalizer["Nav_Rankings"]</span>
                </a>
            </li>

            <!-- 6. Cộng đồng -->
            <li class="nav-menu-item transition-all duration-200">
                <a asp-controller="Community" asp-action="Index"
                   class="nav-link @(currentController.Equals("Community", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                    <i class="fa-solid fa-users"></i>
                    <span>@SharedLocalizer["Nav_Community"]</span>
                </a>
            </li>

            <!-- 7. NÚT ĐỔI NGÔN NGỮ -->
            <li class="nav-menu-item transition-all duration-200 flex items-center pl-2 ml-1 border-l border-slate-200">
                <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post"
                      class="flex items-center bg-slate-100/80 p-0.5 rounded-full border border-slate-200 shadow-inner">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <!-- VN -->
                    <button type="submit" name="culture" value="vi-VN"
                            title="Tiếng Việt"
                            class="px-2.5 py-1 text-xs font-bold rounded-full transition-all flex items-center gap-1.5 @(currentCulture.StartsWith("vi", StringComparison.OrdinalIgnoreCase)
                                ? "bg-white text-teal-700 shadow-sm"
                                : "text-slate-500 hover:text-slate-800")">
                        <span class="text-xs">🇻🇳</span>
                        <span class="text-[11px] uppercase tracking-wide">VN</span>
                    </button>

                    <!-- EN -->
                    <button type="submit" name="culture" value="en-US"
                            title="English"
                            class="px-2.5 py-1 text-xs font-bold rounded-full transition-all flex items-center gap-1.5 @(currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase)
                                ? "bg-white text-teal-700 shadow-sm"
                                : "text-slate-500 hover:text-slate-800")">
                        <span class="text-xs">🇺🇸</span>
                        <span class="text-[11px] uppercase tracking-wide">EN</span>
                    </button>
                </form>
            </li>
        </ul>
    </nav>

    <!-- KHU VỰC TÀI KHOẢN GÓC PHẢI -->
    <div class="header-actions">
        <!-- Nút ủng hộ tác giả (hộp: Views/Shared/_DonateModalPartial.cshtml, JS: js/home/common/donate.js) -->
        <button type="button" class="donate-btn" data-donate-open
                title="@(mIsVi ? "Ủng hộ tác giả" : "Support the author")"
                aria-label="@(mIsVi ? "Ủng hộ tác giả" : "Support the author")" aria-haspopup="dialog" aria-controls="donateModal">
            <i class="fa-solid fa-heart" aria-hidden="true"></i>
        </button>
        @if (themeReady)
        {
            <!-- Nút chuyển sáng / tối (js/home/common/theme-toggle.js) -->
            <button type="button" id="btnThemeToggle" class="theme-toggle"
                    aria-pressed="false"
                    data-label-dark="@(mIsVi ? "Chuyển sang giao diện tối" : "Switch to dark mode")"
                    data-label-light="@(mIsVi ? "Chuyển sang giao diện sáng" : "Switch to light mode")"
                    title="@(mIsVi ? "Chuyển sang giao diện tối" : "Switch to dark mode")"
                    aria-label="@(mIsVi ? "Chuyển sang giao diện tối" : "Switch to dark mode")">
                <i class="fa-solid fa-moon theme-icon-moon" aria-hidden="true"></i>
                <i class="fa-solid fa-sun theme-icon-sun" aria-hidden="true"></i>
            </button>
        }
        <!-- MOBILE: nút tìm kiếm + đổi ngôn ngữ (menu chính bị ẩn trên điện thoại) -->
        <button type="button" id="btnMobileSearch" class="m-only m-icon-btn" aria-label="@SharedLocalizer["Nav_SearchTooltip"]" aria-expanded="false" aria-controls="mobileSearchBar">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        </button>
        <form asp-area="" asp-controller="Language" asp-action="SetLanguage" method="post" class="m-only m-lang-form">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" name="culture" value="@(mIsVi ? "en-US" : "vi-VN")" class="m-icon-btn" title="@(mIsVi ? "English" : "Tiếng Việt")" aria-label="@(mIsVi ? "Switch to English" : "Chuyển sang Tiếng Việt")">
                @(mIsVi ? "EN" : "VI")
            </button>
        </form>

        @if (currentUserId > 0)
        {
            <!-- ĐÃ ĐĂNG NHẬP -->
            <div class="flex items-center gap-3">
                <a asp-controller="Profile" asp-action="Index"
                   class="flex items-center gap-2 text-slate-700 hover:text-teal-700 font-bold text-sm bg-slate-50 hover:bg-slate-100 px-3 py-1.5 rounded-xl border border-slate-200 transition"
                   title="@SharedLocalizer["Nav_Profile"]">
                    <i class="fa-solid fa-circle-user text-main text-lg"></i>
                    <span class="max-w-[120px] text-main truncate inline-block [direction:rtl] text-left">
                        @currentUserName&#x200E;
                    </span>
                </a>
                <a asp-controller="Login" asp-action="Logout" class="text-xs font-semibold text-rose-500 hover:text-rose-700 bg-white px-3 py-3 rounded-xl transition" title="@SharedLocalizer["Nav_Logout"]">
                    <i class="fa-solid text-deny fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        }
        else
        {
            <button type="button" onclick="openLoginModal()" class="btn-header-login flex items-center gap-2">
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
                <span>@SharedLocalizer["Nav_SignIn"]</span>
            </button>
        }
    </div>
</header>

<!-- MOBILE: thanh tìm kiếm (ô type="search" được infinite-scroll.js lắng nghe để lọc truyện) -->
<div id="mobileSearchBar" class="m-search-bar">
    <div class="m-search-field">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" id="mobileSearchInput" autocomplete="off" aria-label="@SharedLocalizer["Nav_SearchPlaceholder"]" placeholder="@SharedLocalizer["Nav_SearchPlaceholder"]" />
        <button type="button" id="btnCloseMobileSearch" aria-label="Close">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
    </div>
</div>

    @await Component.InvokeAsync("HeroSlideshow")

    @if (adOnThisPage)
    {
        <!-- QUẢNG CÁO 1: thanh ngang dưới Hero (CSS: css/home/ads.css) -->
        <div class="ad-slot ad-slot--banner">
            <span class="ad-label">@adLabel</span>
            @if (adEnabled && !string.IsNullOrWhiteSpace(adTopSlot))
            {
                <ins class="adsbygoogle"
                     style="display:block"
                     data-ad-client="@adClient"
                     data-ad-slot="@adTopSlot"
                     data-ad-format="horizontal"
                     data-full-width-responsive="true"></ins>
                <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
            }
            else if (adPreview)
            {
                <div class="ad-placeholder">728 × 90 · Top banner</div>
            }
        </div>

        <!-- Cấu hình cho quảng cáo chèn giữa lưới truyện (js/home/common/feed-ads.js) -->
        <div id="adConfig" hidden
             data-enabled="@(adEnabled ? "true" : "false")"
             data-client="@adClient"
             data-slot="@adFeedSlot"
             data-rows="@adRows"
             data-label="@adLabel"></div>
    }

    <main role="main" class="w-full main-container page-@mController.ToLowerInvariant()">
        <section class="primary-content">
            @RenderBody()
        </section>

        <aside class="hot-sidebar">
            <h3 class="sidebar-title">@SharedLocalizer["Story_WeeklyHotManga"]</h3>
            <div class="hot-list">
                @await Component.InvokeAsync("TopViewList")
            </div>
        </aside>
    </main>

    <!-- NẠP MODAL ĐĂNG NHẬP / ĐĂNG KÝ VÀO ĐÂY ĐỂ TRANG NÀO CŨNG DÙNG ĐƯỢC -->
    @await Html.PartialAsync("_AuthModalsPartial", new UsersViewModel())

    <!-- HỘP ỦNG HỘ (mã QR + số tài khoản) -->
    @await Html.PartialAsync("_DonateModalPartial")

    <!-- MOBILE: thanh điều hướng dưới đáy (ẩn trên desktop, xem css/home/mobile.css) -->
    <nav class="m-tabbar" aria-label="Menu">
        <a asp-controller="Home" asp-action="Index" class="m-tab @mTabActive("Home")">
            <i class="fa-solid fa-house" aria-hidden="true"></i><span>@SharedLocalizer["Nav_Home"]</span>
        </a>
        <a asp-controller="Categories" asp-action="Index" class="m-tab @mTabActive("Categories")">
            <i class="fa-solid fa-layer-group" aria-hidden="true"></i><span>@SharedLocalizer["Nav_Categories"]</span>
        </a>
        <a asp-controller="Rankings" asp-action="Index" class="m-tab @mTabActive("Rankings")">
            <i class="fa-solid fa-chart-simple" aria-hidden="true"></i><span>@SharedLocalizer["Nav_Rankings"]</span>
        </a>
        <a asp-controller="Community" asp-action="Index" class="m-tab @mTabActive("Community")">
            <i class="fa-solid fa-users" aria-hidden="true"></i><span>@SharedLocalizer["Nav_Community"]</span>
        </a>
        @if (currentUserId > 0)
        {
            <a asp-controller="Profile" asp-action="Index" class="m-tab @mTabActive("Profile")">
                <i class="fa-solid fa-circle-user" aria-hidden="true"></i><span>@SharedLocalizer["Nav_Profile"]</span>
            </a>
        }
        else
        {
            <button type="button" class="m-tab" onclick="openLoginModal()">
                <i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i><span>@SharedLocalizer["Nav_SignIn"]</span>
            </button>
        }
    </nav>

    <footer class="app-footer">
        <div class="footer-glow"></div>
        <div class="footer-container">
            <div class="footer-grid">
                <!-- Cột 1: Giới thiệu & Thương hiệu -->
                <div class="footer-col">
                    <div class="footer-brand">
                        <i class="fa-solid fa-book-journal-whills brand-icon"></i>
                        <span class="brand-title">BilingualManga</span>
                    </div>
                    <p class="brand-desc">
                        @SharedLocalizer["Footer_Description"]
                    </p>
                    <div class="footer-badge">
                        <i class="fa-solid fa-sparkles"></i>
                        <span>@SharedLocalizer["Footer_SmartLearning"]</span>
                    </div>
                </div>

                <!-- Cột 2: Điều hướng nhanh -->
                <div class="footer-col">
                    <h4 class="col-title">@SharedLocalizer["Footer_Discover"]</h4>
                    <ul class="footer-links">
                        <li><a href="/"><i class="fa-solid fa-angle-right"></i> @SharedLocalizer["Footer_Home"]</a></li>
                        <li><a href="/Stories"><i class="fa-solid fa-angle-right"></i> @SharedLocalizer["Footer_MangaList"]</a></li>
                        <li><a href="/Profile"><i class="fa-solid fa-angle-right"></i> @SharedLocalizer["Footer_Library"]</a></li>
                        <li><a href="/Rankings"><i class="fa-solid fa-angle-right"></i> @SharedLocalizer["Footer_Rankings"]</a></li>
                        <li><a href="/about"><i class="fa-solid fa-angle-right"></i> @SharedLocalizer["Footer_AboutUs"]</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Chính sách & Pháp lý -->
                <div class="footer-col">
                    <h4 class="col-title">@SharedLocalizer["Footer_Policies"]</h4>
                    <ul class="footer-links">
                        <li><a href="#"><i class="fa-solid fa-angle-right"></i> @SharedLocalizer["Footer_Terms"]</a></li>
                        <li><a href="/privacy"><i class="fa-solid fa-angle-right"></i> @SharedLocalizer["Footer_Privacy"]</a></li>
                        <li><a href="/contact"><i class="fa-solid fa-angle-right"></i> @SharedLocalizer["Footer_CopyrightNotices"]</a></li>
                        <li><a href="/contact"><i class="fa-solid fa-angle-right"></i> @SharedLocalizer["Footer_Contact"]</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Mạng xã hội & Cộng đồng -->
                <div class="footer-col">
                    <h4 class="col-title">@SharedLocalizer["Footer_Community"]</h4>
                    <p class="community-text">@SharedLocalizer["Footer_CommunityDescription"]</p>
                    <div class="social-links">
                        <a href="#" class="social-btn facebook" title="Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>
                        <a href="#" class="social-btn discord" title="Discord">
                            <i class="fa-brands fa-discord"></i>
                        </a>
                        <a href="#" class="social-btn youtube" title="Youtube">
                            <i class="fa-brands fa-youtube"></i>
                        </a>
                        <a href="#" class="social-btn telegram" title="Telegram">
                            <i class="fa-brands fa-telegram"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Dòng phân cách & Copyright -->
            <div class="footer-bottom">
                <div class="copyright-text">
                    © 2026 <span class="highlight">BilingualManga</span>. @SharedLocalizer["Footer_AllRightsReserved"]
                </div>
                <div class="made-by">
                    @SharedLocalizer["Footer_MadeForLearners"] <i class="fa-solid fa-heart heart-beat"></i> @SharedLocalizer["Footer_MangaLearners"]
                </div>
            </div>
        </div>
    </footer>

    <div id="toast-container"></div>
    <div id="ai-selection-tooltip"
         class="fixed hidden z-[1020] bg-gray-900 text-white text-xs font-semibold px-3 py-1.5 rounded-full shadow-xl cursor-pointer hover:bg-teal-600 transition-all duration-200 transform -translate-x-1/2 -translate-y-full flex items-center gap-1.5 select-none animate-bounce">
        <i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i>
        <span>@SharedLocalizer["SharedChat_AskAiTooltip"]</span>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/home/common/auth-modal.js" asp-append-version="true"></script>
    <script src="~/js/home/common/infinite-scroll.js" asp-append-version="true"></script>
    <script src="~/js/home/common/feed-ads.js" asp-append-version="true"></script>
    <script src="~/js/home/common/donate.js" asp-append-version="true"></script>
    @if (themeReady)
    {
        <script src="~/js/home/common/theme-toggle.js" asp-append-version="true"></script>
    }

    @RenderSection("Scripts", required: false)

    <script>
    // ==========================================
    // 1. CÁC HÀM TIỆN ÍCH TOÀN CỤC
    // ==========================================
    function showToast(message, type = 'success', duration = 4000) {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `toast-notification ${type === 'error' ? 'toast-error' : ''}`;
        toast.innerHTML = `
            <span class="toast-message">${message}</span>
            <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
        `;

        container.appendChild(toast);
        setTimeout(() => { toast.classList.add('show'); }, 10);
        setTimeout(() => {
            toast.classList.remove('show');
            setTimeout(() => { toast.remove(); }, 500);
        }, duration);
    }

    // ==========================================
    // 2. HERO SLIDESHOW (5 TRUYỆN MỚI NHẤT)
    // ==========================================
    let currentHeroIndex = 0;
    let heroInterval = null;

    function initHeroSlideshow() {
        const $slides =$('.hero-slideshow .slide');
        if ($slides.length <= 1) return;

        heroInterval = setInterval(() => {
            let next = (currentHeroIndex + 1) % $slides.length;
            goToHeroSlide(next);
        }, 5000);
    }

    function goToHeroSlide(index) {
        const $slides =$('.hero-slideshow .slide');
        const $dots =$('.hero-dot, .slide-dots .dot');
        if ($slides.length === 0) return;

        currentHeroIndex = index;

        $slides.stop(true, true).fadeOut(400).removeClass('active');$slides.eq(index).stop(true, true).fadeIn(400).addClass('active');

        $dots.removeClass('bg-teal-400 w-8 active').addClass('bg-white/40');$dots.eq(index).removeClass('bg-white/40').addClass('bg-teal-400 w-8 active');
    }

    // Xử lý nút Follow trên Hero Banner
    function toggleHeroFollow(storyId, btnElem) {
        const $btn =$(btnElem);
        const $icon =$btn.find('i');
        const $text =$btn.find('.follow-text');

        $.post('/Stories/ToggleFollow', { storyId: storyId }, function (res) {
            if (res.requireLogin) {
                showToast('@SharedLocalizer["Banner_PleaseLogin"]', 'warning');
                return;
            }

            if (res.success) {
                if (res.isFollowed) {
                    $btn.removeClass('bg-white/10 hover:bg-white/20 border-white/20')
                        .addClass('bg-teal-600/90 border-teal-400');
                    $icon.removeClass('fa-plus').addClass('fa-check');$text.text('@SharedLocalizer["Banner_Followed"]');
                } else {
                    $btn.removeClass('bg-teal-600/90 border-teal-400')
                        .addClass('bg-white/10 hover:bg-white/20 border-white/20');
                    $icon.removeClass('fa-check').addClass('fa-plus');$text.text('@SharedLocalizer["Banner_Follow"]');
                }
            }
        }).fail(function () {
            showToast('Error connecting to server!', 'error');
        });
    }

    // ==========================================
    // 3. KHỞI CHẠY CHÍNH KHI DOM SẴN SÀNG
    // ==========================================
    $(document).ready(function () {     
        // --- B. Khởi chạy Slideshow ---
        initHeroSlideshow();

        // Click vào các dot chuyển slide
        $(document).on('click', '.slide-dots .dot, .hero-dot', function () {
            clearInterval(heroInterval);
            const index = $(this).index();
            goToHeroSlide(index);
            initHeroSlideshow();
        });

        // --- C. Mở Modal Đăng nhập qua Query URL (?openLogin=1) ---
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('openLogin') === 'true' || urlParams.get('openLogin') === '1') {
            if (typeof openLoginModal === 'function') {
                openLoginModal();
            }
            window.history.replaceState({}, document.title, window.location.pathname);
        }

       // --- D. Xử lý Thanh Tìm Kiếm Thời Gian Thực (Live Search) ---
        let searchDebounce = null;
        const $btnOpen = $('#btnOpenSearch');
        const $container = $('#searchBarContainer');
        const $input = $('#liveSearchInput');
        const $btnClose = $('#btnCloseSearch');
        const $btnClear = $('#btnClearSearch');

        // Mở thanh tìm kiếm: Chỉ ẩn các item menu xung quanh (.nav-menu-item)
        $btnOpen.on('click', function (e) {
            e.stopPropagation();

            // Ẩn mượt tất cả các menu item khác
            $('.nav-menu-item').addClass('hidden');

            $btnOpen.addClass('hidden');
            $container.removeClass('hidden flex').addClass('flex');
            requestAnimationFrame(() => {
                $container.removeClass('opacity-0 scale-95').addClass('opacity-100 scale-100');
                $input.focus();
            });
        });

        // Đóng thanh tìm kiếm
        $btnClose.on('click', function (e) {
            e.stopPropagation();
            closeSearchBar();
        });

        // Nút xóa nhanh nội dung
        $btnClear.on('click', function () {
            $input.val('');
            $btnClear.addClass('hidden');
            if (typeof onSearchStory === 'function') {
                onSearchStory('');
            }
            $input.focus();
        });

        // Click ra ngoài tự đóng nếu ô trống
        $(document).on('click', function (e) {
            if (!$(e.target).closest('#searchBarContainer, #btnOpenSearch').length) {
                if ($input.val().trim().length === 0) {
                    closeSearchBar();
                }
            }
        });

        // Nhấn phím Escape để đóng
        $(document).on('keydown', function (e) {
            if (e.key === 'Escape' && !$container.hasClass('hidden')) {
                closeSearchBar();
            }
        });

        function closeSearchBar() {
            if ($input.val().trim().length > 0) {
                $input.val('');
                if (typeof onSearchStory === 'function') {
                    onSearchStory('');
                }
            }
            $btnClear.addClass('hidden');
            $container.removeClass('opacity-100 scale-100').addClass('opacity-0 scale-95');
            setTimeout(() => {
                $container.removeClass('flex').addClass('hidden');
                $btnOpen.removeClass('hidden');

                // Hiện lại tất cả menu item
                $('.nav-menu-item').removeClass('hidden');
            }, 200);
        }

        // Lắng nghe gõ phím
        $input.on('input', function () {
            const keyword = $(this).val();

            if (keyword.trim().length > 0) {
                $btnClear.removeClass('hidden');
            } else {
                $btnClear.addClass('hidden');
            }

            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(function () {
                if (typeof onSearchStory === 'function') {
                    onSearchStory(keyword);
                }
            }, 300);
        });

        // --- E. MOBILE: bật/tắt thanh tìm kiếm ---
        const $mSearchBar = $('#mobileSearchBar');
        const $mSearchBtn = $('#btnMobileSearch');
        const $mSearchInput = $('#mobileSearchInput');

        function toggleMobileSearch(open) {
            $mSearchBar.toggleClass('is-open', open);
            $mSearchBtn.attr('aria-expanded', open ? 'true' : 'false');
            if (open) {
                $mSearchInput.trigger('focus');
            } else if ($mSearchInput.val().trim().length > 0) {
                $mSearchInput.val('');
                if (typeof onSearchStory === 'function') onSearchStory('');
            }
        }

        $mSearchBtn.on('click', function () { toggleMobileSearch(!$mSearchBar.hasClass('is-open')); });
        $('#btnCloseMobileSearch').on('click', function () { toggleMobileSearch(false); });

        function performLiveSearch(keyword) {
            const $grid =$('#mainStoryGrid');
            if ($grid.length === 0) return;

            $grid.addClass('opacity-50 pointer-events-none');

            $.ajax({
                url: '/Home/FilterStories',
                type: 'GET',
                data: { keyword: keyword },
                success: function (html) {
                    if (html && html.trim().length > 0) {
                        $grid.html(html);$('#noMoreData').addClass('hidden');
                    } else {
                        $grid.html(`
                            <div class="col-span-full py-16 text-center text-slate-400 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                <i class="fa-solid fa-magnifying-glass text-3xl mb-2 text-slate-300"></i>
                                <p class="text-sm font-semibold">${$('<div>').text('@SharedLocalizer["Story_NoSearchMatches"]').html()}</p>
                            </div>
                        `);
                    }

                    const $title =$('.section-title');
                    if (keyword.trim().length > 0) {
                        $title.html(`${$('<div>').text('@SharedLocalizer["Story_SearchResultsFor"]').html()} <span class="text-teal-600">"${keyword}"</span>`);
                        $('#infiniteScrollTrigger').addClass('hidden');
                    } else {
                        $title.text('@SharedLocalizer["Story_LatestStories"]');
                        $('#infiniteScrollTrigger').removeClass('hidden');
                    }
                },
                error: function () {
                    showToast('@SharedLocalizer["Story_SearchFailed"]', 'error');
                },
                complete: function () {
                    $grid.removeClass('opacity-50 pointer-events-none');
                }
            });
        }
    });
</script>

<script>
    window.ADMIN_LANG = {
        // Table & Status
        NotFoundAccounts: "@Html.Raw(SharedLocalizer["Admin_NotFoundAccounts"])",
        NoDisplayName: "@Html.Raw(SharedLocalizer["Admin_NoDisplayName"])",
        StatusActive: "@Html.Raw(SharedLocalizer["Admin_StatusActive"])",
        StatusInactive: "@Html.Raw(SharedLocalizer["Admin_StatusInactive"])",
        Never: "@Html.Raw(SharedLocalizer["Admin_Never"])",
        TitleEditAccount: "@Html.Raw(SharedLocalizer["Admin_TitleEditAccount"])",
        TitleDeleteAccount: "@Html.Raw(SharedLocalizer["Admin_TitleDeleteAccount"])",
        
        // Errors & Toasts
        ErrLoadAccounts: "@Html.Raw(SharedLocalizer["Admin_ErrLoadAccounts"])",
        ErrConnectServerLoad: "@Html.Raw(SharedLocalizer["Admin_ErrConnectServerLoad"])",
        ViewerNoPermissionDelete: "@Html.Raw(SharedLocalizer["Admin_ViewerNoPermissionDelete"])",
        ViewerNoPermissionSave: "@Html.Raw(SharedLocalizer["Admin_ViewerNoPermissionSave"])",
        ViewerNoPermissionModal: "@Html.Raw(SharedLocalizer["Admin_ViewerNoPermissionModal"])",
        SelectAtLeastOne: "@Html.Raw(SharedLocalizer["Admin_SelectAtLeastOne"])",
        ErrConnectDelete: "@Html.Raw(SharedLocalizer["Admin_ErrConnectDelete"])",
        ErrConnectServer: "@Html.Raw(SharedLocalizer["Admin_ErrConnectServer"])",
        CannotFetchInfo: "@Html.Raw(SharedLocalizer["Admin_CannotFetchInfo"])",

        // Confirm Dialogs & Actions
        ConfirmDeleteSingleTitle: "@Html.Raw(SharedLocalizer["Admin_ConfirmDeleteSingleTitle"])",
        ConfirmDeleteSingleMsg: "@Html.Raw(SharedLocalizer["Admin_ConfirmDeleteSingleMsg"])",
        ConfirmDeleteMultiTitle: "@Html.Raw(SharedLocalizer["Admin_ConfirmDeleteMultiTitle"])",
        ConfirmDeleteMultiMsg: "@Html.Raw(SharedLocalizer["Admin_ConfirmDeleteMultiMsg"])",
        ActionCannotUndo: "@Html.Raw(SharedLocalizer["Admin_ActionCannotUndo"])",
        Processing: "@Html.Raw(SharedLocalizer["Admin_Processing"])",
        SaveChanges: "@Html.Raw(SharedLocalizer["Admin_SaveChanges"])",
        BtnDeleteText: "@Html.Raw(SharedLocalizer["Admin_BtnDeleteText"])",

        // Modal Form
        ModalTitleAdd: "@Html.Raw(SharedLocalizer["Admin_ModalTitleAdd"])",
        ModalTitleEdit: "@Html.Raw(SharedLocalizer["Admin_ModalTitleEdit"])",
        PwdNoticeAdd: "@Html.Raw(SharedLocalizer["Admin_PwdNoticeAdd"])",
        PwdNoticeEdit: "@Html.Raw(SharedLocalizer["Admin_PwdNoticeEdit"])",
        ReqVerifyPassword: "@Html.Raw(SharedLocalizer["AdminAdmins_ReqVerifyPassword"])"
    };
</script>

</body>
</html>