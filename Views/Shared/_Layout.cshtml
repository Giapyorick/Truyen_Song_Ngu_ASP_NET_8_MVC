    <div id="toast-container"></div>

    <!-- SCRIPT CHUNG CHO TOÀN BỘ WEBSITE -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/auth/auth-modal.js" asp-append-version="true"></script>
    <script src="~/js/infinite_scroll.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

    <script>
            $(document).ready(function () {
                let currentSlide = 0;
                const slides = $('.slide');
                const dots = $('.dot');
                const slideInterval = 5000;

                function nextSlide() {
                    slides.eq(currentSlide).removeClass('active');
                    dots.eq(currentSlide).removeClass('active');
                    currentSlide = (currentSlide + 1) % slides.length;
                    slides.eq(currentSlide).addClass('active');
                    dots.eq(currentSlide).addClass('active');
                }

                let timer = setInterval(nextSlide, slideInterval);

                dots.click(function () {
                    clearInterval(timer);
                    const index = $(this).index();
                    slides.eq(currentSlide).removeClass('active');
                    dots.eq(currentSlide).removeClass('active');
                    currentSlide = index;
                    slides.eq(currentSlide).addClass('active');
                    dots.eq(currentSlide).addClass('active');
                    timer = setInterval(nextSlide, slideInterval);
                });
            });

            function showToast(message, type = 'success', duration = 4000) {
                const container = document.getElementById('toast-container');
                if (!container) return;

                const toast = document.createElement('div');
                toast.className = `toast-notification ${type === 'error' ? 'toast-error' : ''}`;
                toast.innerHTML = `
                            <span class="toast-message">${message}</span>
                            <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
                        `;

                container.appendChild(toast);
                setTimeout(() => { toast.classList.add('show'); }, 10);
                setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => { toast.remove(); }, 500);
                }, duration);
            }
            $(document).ready(function () {
                let searchDebounce = null;
                const $input = $('#liveSearchInput');
                const $btnClear = $('#btnClearSearch');

                $input.on('input', function () {
                    const keyword = $(this).val();

                    if (keyword.trim().length > 0) {
                        $btnClear.removeClass('hidden');
                    } else {
                        $btnClear.addClass('hidden');
                    }

                    clearTimeout(searchDebounce);
                    // Đợi người dùng dừng gõ 300ms rồi mới gửi AJAX cập nhật danh sách
                    searchDebounce = setTimeout(function () {
                        performLiveSearch(keyword);
                    }, 300);
                });

                $btnClear.on('click', function () {
                    $input.val('').trigger('input').focus();
                });

                function performLiveSearch(keyword) {
                    const $grid = $('#mainStoryGrid');
                    if ($grid.length === 0) return; // Nếu đang không ở trang có danh sách truyện thì bỏ qua

                    // Hiệu ứng mờ nhẹ danh sách trong khi tải
                    $grid.addClass('opacity-50 pointer-events-none');

                    $.ajax({
                        url: '/Home/FilterStories',
                        type: 'GET',
                        data: { keyword: keyword },
                        success: function (html) {
                            if (html && html.trim().length > 0) {
                                $grid.html(html); $('#noMoreData').addClass('hidden');
                            } else {
                                $grid.html(`
                                    <div class="col-span-full py-16 text-center text-slate-400 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                        <i class="fa-solid fa-magnifying-glass text-3xl mb-2 text-slate-300"></i>
                                        <p class="text-sm font-semibold">No stories match your search keyword.</p>
                                    </div>
                                `);
                            }

                            // Cập nhật tiêu đề hiển thị
                            const $title = $('.section-title');
                            if (keyword.trim().length > 0) {
                                $title.html(`Search Results for: <span class="text-teal-600">"${keyword}"</span>`);
                                $('#infiniteScrollTrigger').addClass('hidden'); // Tạm ẩn trigger cuộn trang khi đang search
                            } else {
                                $title.text('Latest Stories'); $('#infiniteScrollTrigger').removeClass('hidden');
                            }
                        },
                        error: function () {
                            showToast('Failed to search stories!', 'error');
                        },
                        complete: function () {
                            $grid.removeClass('opacity-50 pointer-events-none');
                        }
                    });
                }
            });
            $(document).ready(function () {
                let searchDebounce = null;
                const $btnOpen = $('#btnOpenSearch');
                const $container = $('#searchBarContainer');
                const $input = $('#liveSearchInput');
                const $btnClose = $('#btnCloseSearch');

                // 1. Nhấp vào kính lúp: ẩn icon, mở ô nhập văn bản
                $btnOpen.on('click', function (e) {
                    e.stopPropagation();
                    $btnOpen.addClass('hidden'); $container.removeClass('hidden flex').addClass('flex');

                    requestAnimationFrame(() => {
                        $container.removeClass('opacity-0 scale-95').addClass('opacity-100 scale-100'); $input.focus();
                    });
                });

                // 2. Nhấp nút X: đóng thanh tìm kiếm và khôi phục danh sách truyện
                $btnClose.on('click', function (e) {
                    e.stopPropagation();
                    closeSearchBar();
                });

                // 3. Nhấp chuột ra ngoài: tự đóng nếu không có nội dung tìm kiếm
                $(document).on('click', function (e) {
                    if (!$(e.target).closest('#searchBarContainer, #btnOpenSearch').length) {
                        if ($input.val().trim().length === 0) {
                            closeSearchBar();
                        }
                    }
                });

                // 4. Nhấn phím Escape: đóng thanh tìm kiếm
                $(document).on('keydown', function (e) {
                    if (e.key === 'Escape' && !$container.hasClass('hidden')) {
                        closeSearchBar();
                    }
                });

                function closeSearchBar() {
                    if ($input.val().trim().length > 0) {
                        $input.val('');
                        performLiveSearch(''); // Khôi phục lại danh sách ban đầu
                    }

                    $container.removeClass('opacity-100 scale-100').addClass('opacity-0 scale-95');
                    setTimeout(() => {
                        $container.removeClass('flex').addClass('hidden'); $btnOpen.removeClass('hidden');
                    }, 200);
                }

                // 5. Lắng nghe gõ phím và gọi AJAX lọc danh sách truyện (Debounce 300ms)
                $input.on('input', function () {
                    const keyword = $(this).val();

                    clearTimeout(searchDebounce);
                    searchDebounce = setTimeout(function () {
                        performLiveSearch(keyword);
                    }, 300);
                });

                function performLiveSearch(keyword) {
                    const $grid = $('#mainStoryGrid');
                    if ($grid.length === 0) return;

                    $grid.addClass('opacity-50 pointer-events-none');

                    $.ajax({
                        url: '/Home/FilterStories',
                        type: 'GET',
                        data: { keyword: keyword },
                        success: function (html) {
                            if (html && html.trim().length > 0) {
                                $grid.html(html); $('#noMoreData').addClass('hidden');
                            } else {
                                $grid.html(`
                                    <div class="col-span-full py-16 text-center text-slate-400 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                        <i class="fa-solid fa-magnifying-glass text-3xl mb-2 text-slate-300"></i>
                                        <p class="text-sm font-semibold">No stories match your search keyword.</p>
                                    </div>
                                `);
                            }

                            const $title = $('.section-title');
                            if (keyword.trim().length > 0) {
                                $title.html(`Search Results for: <span class="text-teal-600">"${keyword}"</span>`);
                                $('#infiniteScrollTrigger').addClass('hidden');
                            } else {
                                $title.text('Latest Stories'); $('#infiniteScrollTrigger').removeClass('hidden');
                            }
                        },
                        error: function () {
                            if (typeof showToast === 'function') {
                                showToast('Failed to search stories!', 'error');
                            }
                        },
                        complete: function () {
                            $grid.removeClass('opacity-50 pointer-events-none');
                        }
                    });
                }
            });
            $(document).ready(function () {
                // Đọc tham số trên URL
                const urlParams = new URLSearchParams(window.location.search);

                if (urlParams.get('openLogin') === 'true' || urlParams.get('openLogin') === '1') {
                    // Mở Modal Login
                    if (typeof openLoginModal === 'function') {
                        openLoginModal();
                    } else {
                        // Fallback nếu chưa định nghĩa hàm openLoginModal
                        $('#loginModalOverlay').removeClass('hidden').addClass('flex');
                        setTimeout(() => {
                            $('#loginModalContent').removeClass('translate-y-10 opacity-0').addClass('translate-y-0 opacity-100');
                        }, 10);
                    }

                    // Xóa sạch '?openLogin=true' trên thanh địa chỉ URL để giữ link đẹp và không bị lặp lại khi F5
                    const cleanUrl = window.location.pathname;
                    window.history.replaceState({}, document.title, cleanUrl);
                }
            });
            function openLoginModal() {
                const $overlay = $('#loginModalOverlay');
                const $content = $('#loginModalContent');

                $overlay.removeClass('hidden').addClass('flex');
                setTimeout(() => {
                    $content.removeClass('translate-y-10 opacity-0').addClass('translate-y-0 opacity-100');
                }, 10);
            }

            function closeLoginModal() {
                const $overlay = $('#loginModalOverlay');
                const $content = $('#loginModalContent');

                $content.removeClass('translate-y-0 opacity-100').addClass('translate-y-10 opacity-0');
                setTimeout(() => {
                    $overlay.removeClass('flex').addClass('hidden');
                }, 300);
            }
    </script>

    <style>
