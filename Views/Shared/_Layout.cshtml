            }

            .text-info-btn {
                background: none;
                border: 1px solid #667eea;
                padding: 5px 15px;
                border-radius: 20px;
                cursor: pointer;
                font-weight: 600;
                color: #4f46e5;
                transition: all 0.3s ease;
            }

                .text-info-btn:hover {
                    background: #4f46e5;
                    color: #ffffff;
                }

            .hero-slideshow {
                position: relative;
                margin: 2rem 5%;
                height: 400px;
                border-radius: 24px;
                overflow: hidden;
                background: #f8fafc;
