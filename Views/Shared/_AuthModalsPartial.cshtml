@model WebTruyenTranh.ViewModels.UsersViewModel

@* 1. MODAL ĐĂNG NHẬP *@
<div id="loginModalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[999] transition-all duration-300">
    <div id="loginModalContent" class="bg-white w-full max-w-md rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-10 opacity-0 transition-all duration-300 ease-out">
        <div class="p-6 border-b border-gray-100 relative bg-gradient-to-r from-gray-50 to-white text-center">
            <h3 class="text-xl font-extrabold text-cus">@SharedLocalizer["Auth_SignIn"]</h3>
            <p class="text-xs text-gray-400 mt-1">@SharedLocalizer["Auth_LoginModalSubtitle"]</p>
            <button onclick="closeLoginModal()" class="absolute right-5 top-5 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-rose-50 hover:text-rose-500 transition-all text-xl">
                &times;
            </button>
        </div>

        <form id="loginForm" action="javascript:void(0);" onsubmit="return false;" class="p-6 space-y-4">
            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["Auth_Email"]</label>
                <input type="email" name="Email" id="loginEmail" required
                       class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all"
                       placeholder="yourname@gmail.com">
            </div>

            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["Auth_Password"]</label>
                <input type="password" name="Password" id="loginPassword" required
                       class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all"
                       placeholder="••••••••">
            </div>

            <div class="flex justify-end">
                <button type="button" onclick="switchToForgotModal()" class="text-xs text-teal-600 hover:underline font-semibold">
                    @SharedLocalizer["Auth_ForgotPassword"]
                </button>
            </div>

            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["Auth_SecurityQuestion"]</label>
                <div class="flex items-center gap-2">
                    <div class="px-3.5 py-2.5 bg-teal-50 border border-teal-200 text-teal-700 font-extrabold text-sm rounded-xl select-none flex items-center gap-1.5 shadow-inner">
                        <i class="fa-solid fa-calculator text-xs"></i>
                        <span id="loginCaptchaQuestion">@SharedLocalizer["Auth_CaptchaAnswer"]</span>
                    </div>
                    <input type="text" name="captchaAnswer" id="loginCaptchaInput" required placeholder="@SharedLocalizer["Auth_CaptchaPlaceholder"]"
                           class="flex-1 px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 focus:bg-white rounded-xl outline-none text-sm transition-all" autocomplete="off" />
                    <button type="button" onclick="refreshLoginCaptcha()" class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-500 transition" title="@SharedLocalizer["Auth_CaptchaRefresh"]">
                        <i class="fa-solid fa-arrows-rotate text-xs"></i>
                    </button>
                </div>
            </div>

            <div class="pt-2">
                <button type="submit" id="btnLoginSubmit"
                        class="w-full py-3 btn-grad text-white rounded-xl font-bold text-sm shadow-lg hover:shadow-teal-200 active:scale-95 transition-all">
                    @SharedLocalizer["Auth_SignIn"]
                </button>
            </div>

            <div class="text-center text-xs text-gray-500 pt-2">
                @SharedLocalizer["Auth_DontHaveAccount"]
                <button type="button" onclick="switchToRegisterModal()" class="font-bold text-teal-600 hover:underline">
                    @SharedLocalizer["Auth_CreateAccount"]
                </button>
            </div>
        </form>
    </div>
</div>

@* 2. MODAL ĐĂNG KÝ (REGISTER MODAL) *@
<div id="registerModalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[999] transition-all duration-300">
    <div id="registerModalContent" class="bg-white w-full max-w-xl rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-10 opacity-0 transition-all duration-300 ease-out">
        <div class="p-6 border-b border-gray-100 relative bg-gradient-to-r from-gray-50 to-white text-center">
            <h3 class="text-xl font-extrabold text-cus">@SharedLocalizer["Auth_CreateAccount"]</h3>
            <p class="text-xs text-gray-400 mt-1">@SharedLocalizer["Auth_RegisterSubtitle"]</p>
            <button onclick="closeRegisterModal()" class="absolute right-5 top-5 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-rose-50 hover:text-rose-500 transition-all text-xl">
                &times;
            </button>
        </div>

        <form id="registerForm" enctype="multipart/form-data" class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">

            <!-- KHU VỰC CHỌN AVATAR -->
            <div class="flex flex-col items-center gap-3">
                <div class="relative w-24 h-24 rounded-full border-2 border-dashed border-teal-300 bg-teal-50/40 flex items-center justify-center overflow-hidden group">
                    <img id="regAvatarPreview" src="" alt="@SharedLocalizer["Auth_Avatar"]" class="w-full h-full object-cover hidden" />
                    <div id="regAvatarPlaceholder" class="flex flex-col items-center justify-center text-teal-600">
                        <i class="fa-solid fa-camera text-xl mb-1"></i>
                        <span class="text-[10px] font-semibold">@SharedLocalizer["Auth_Avatar"]</span>
                    </div>
                </div>
                <div>
                    <input type="file" name="formFile" id="regAvatarInput" accept="image/*" class="hidden" onchange="previewRegisterAvatar(this)" />
                    <button type="button" onclick="$('#regAvatarInput').click()"
                            class="px-3.5 py-1.5 bg-white border border-gray-200 rounded-xl text-xs font-semibold text-gray-700 hover:bg-teal-50 hover:text-teal-700 hover:border-teal-200 transition shadow-sm">
                        @SharedLocalizer["Btn_ChooseImage"]
                    </button>
                </div>
                <p class="text-[10px] text-gray-400 -mt-1">@SharedLocalizer["Auth_AvatarSpecification"]</p>
            </div>

            <!-- Full Name -->
            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["User_FullName"] <span class="text-rose-500">*</span></label>
                <input type="text" name="Name" id="regName" required
                       class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all"
                       placeholder="@SharedLocalizer["User_PlaceholderName"]">
            </div>

            <!-- Email & Phone -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["Auth_Email"] <span class="text-rose-500">*</span></label>
                    <input type="email" name="Email" id="regEmail" required
                           class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all"
                           placeholder="abc@gmail.com">
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["User_Phone"]</label>
                    <input type="text" name="Phone" id="regPhone"
                           class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all"
                           placeholder="0912xxxxxx">
                </div>
            </div>

            <!-- Password & Confirm Password -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["Auth_Password"] <span class="text-rose-500">*</span></label>
                    <input type="password" name="Passwork" id="regPassword" required
                           class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all"
                           placeholder="@SharedLocalizer["Auth_PasswordMinLength"]">
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["Auth_ConfirmPassword"] <span class="text-rose-500">*</span></label>
                    <input type="password" id="regConfirmPassword" required
                           class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all"
                           placeholder="@SharedLocalizer["Auth_ReenterPassword"]">
                </div>
            </div>

            <!-- Date of Birth & Gender -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["User_DoB"]</label>
                    <input type="date" name="DoB" id="regDoB"
                           class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all datepicker"
                           placeholder="yyyy-mm-dd">
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["User_Gender"]</label>
                    <select name="Gender" id="regGender"
                            class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all">
                        <option value="Male">@SharedLocalizer["Gender_Male"]</option>
                        <option value="Female">@SharedLocalizer["Gender_Female"]</option>
                    </select>
                </div>
            </div>

            <!-- Captcha -->
            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["Auth_SecurityQuestion"] *</label>
                <div class="flex items-center gap-2">
                    <div class="px-3.5 py-2.5 bg-teal-50 border border-teal-200 text-teal-700 font-extrabold text-sm rounded-xl select-none flex items-center gap-1.5 shadow-inner">
                        <i class="fa-solid fa-calculator text-xs"></i>
                        <span id="registerCaptchaQuestion">@SharedLocalizer["Auth_CaptchaAnswer"]</span>
                    </div>
                    <input type="text" name="captchaAnswer" id="registerCaptchaInput" required placeholder="@SharedLocalizer["Auth_CaptchaPlaceholder"]"
                           class="flex-1 px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 focus:bg-white rounded-xl outline-none text-sm transition-all" autocomplete="off" />
                    <button type="button" onclick="refreshRegisterCaptcha()" class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-500 transition" title="@SharedLocalizer["Auth_CaptchaRefresh"]">
                        <i class="fa-solid fa-arrows-rotate text-xs"></i>
                    </button>
                </div>
            </div>

            <div class="pt-3">
                <button type="button" onclick="initiateRegistration()" id="btnRegisterSubmit"
                        class="w-full py-3 btn-grad text-white rounded-xl font-bold text-sm shadow-lg hover:shadow-teal-200 active:scale-95 transition-all cursor-pointer">
                    @SharedLocalizer["Auth_RegisterAccount"]
                </button>
            </div>

            <div class="text-center text-xs text-gray-500 pt-1">
                @SharedLocalizer["Auth_AlreadyHaveAccount"]
                <button type="button" onclick="switchToLoginModal()" class="font-bold text-teal-600 hover:underline">
                    @SharedLocalizer["Auth_SignIn"]
                </button>
            </div>

            <div style="opacity: 0; position: absolute; top: 0; left: 0; height: 0; width: 0; z-index: -1;">
                <input type="text" name="SystemSecurity_FakeTrap" id="SystemSecurity_FakeTrap" tabindex="-1" autocomplete="off" />
            </div>
        </form>
    </div>
</div>

@* 3. MODAL XÁC THỰC MÃ OTP EMAIL (ĐÃ ĐỒNG BỘ NGHỆ THUẬT VỚI HỆ THỐNG) *@
<div id="otpModalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[1000] transition-all duration-300">
    <div id="otpModalContent" class="bg-white w-full max-w-md rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-10 opacity-0 transition-all duration-300 ease-out relative">
        
        <!-- Header Modal -->
        <div class="p-6 border-b border-gray-100 relative bg-gradient-to-r from-gray-50 to-white text-center">
            <div class="w-12 h-12 mx-auto mb-2 rounded-2xl bg-teal-50 border border-teal-100 flex items-center justify-center text-teal-600 text-xl shadow-xs">
                <i class="fa-solid fa-envelope-circle-check"></i>
            </div>
            <h3 class="text-xl font-extrabold text-cus">
                @(SharedLocalizer["Auth_VerifyEmailTitle"]?.Value ?? "Xác thực Gmail")
            </h3>
            <p class="text-xs text-gray-400 mt-1 leading-relaxed px-4">
                @(SharedLocalizer["Auth_OtpSentNotice"]?.Value ?? "Mã xác thực 6 chữ số đã được gửi đến:")<br>
                <strong id="otpDisplayEmail" class="text-teal-600 font-bold break-all"></strong>
            </p>
            
            <button type="button" onclick="closeOtpModal()" class="absolute right-5 top-5 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-rose-50 hover:text-rose-500 transition-all text-xl cursor-pointer">
                &times;
            </button>
        </div>

        <!-- Body Form -->
        <div class="p-6 space-y-5">
            <div class="space-y-1.5 text-center">
                <label class="text-[11px] font-bold text-cus uppercase">
                    @(SharedLocalizer["Auth_EnterOtpLabel"]?.Value ?? "Nhập mã OTP 6 số")
                </label>
                <div class="relative max-w-xs mx-auto">
                    <input type="text" id="regOtpInput" maxlength="6" autocomplete="off"
                           class="w-full px-4 py-3 bg-gray-100 border-2 border-transparent focus:border-teal-400 focus:bg-white rounded-xl text-center text-2xl font-black tracking-[0.4em] text-teal-700 outline-none transition-all shadow-inner"
                           placeholder="••••••">
                </div>
            </div>

            <!-- Đếm ngược & Nút gửi lại -->
            <div class="flex items-center justify-center text-xs h-6">
                <span id="otpCountdownText" class="text-gray-400 font-medium flex items-center gap-1">
                    <i class="fa-regular fa-clock text-teal-500"></i>
                    <span>Resend code in 60s</span>
                </span>
                <button type="button" id="btnResendOtp" onclick="resendOtpCode()" class="font-bold text-teal-600 hover:text-teal-700 hover:underline hidden cursor-pointer transition">
                    <i class="fa-solid fa-rotate-right mr-1"></i>
                    @(SharedLocalizer["Auth_ResendCode"]?.Value ?? "Gửi lại mã")
                </button>
            </div>

            <!-- Nút Hành động -->
            <div class="pt-1 flex items-center gap-3">
                <button type="button" onclick="closeOtpModal()" class="w-1/3 py-3 bg-gray-100 hover:bg-gray-200 text-gray-600 rounded-xl font-bold text-xs transition active:scale-95 cursor-pointer">
                    @(SharedLocalizer["Btn_Cancel"]?.Value ?? "Hủy")
                </button>
                <button type="button" onclick="submitFinalRegistration()" id="btnVerifyOtpSubmit"
                        class="w-2/3 py-3 btn-grad text-white rounded-xl font-bold text-xs uppercase tracking-wider shadow-lg hover:shadow-teal-200 active:scale-95 transition-all cursor-pointer">
                    @(SharedLocalizer["Auth_ConfirmAndCreate"]?.Value ?? "Xác nhận & Tạo")
                </button>
            </div>
        </div>

    </div>
</div>

@* 4. MODAL FORGOT PASSWORD & FORCE CHANGE PASSWORD (GIỮ NGUYÊN) *@
<div id="forgotModalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[999] transition-all duration-300">
    <div id="forgotModalContent" class="bg-white w-full max-w-md rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-10 opacity-0 transition-all duration-300 ease-out">
        <div class="p-6 border-b border-gray-100 relative bg-gradient-to-r from-gray-50 to-white text-center">
            <h3 class="text-xl font-extrabold text-cus">@SharedLocalizer["Auth_ResetPassword"]</h3>
            <p class="text-xs text-gray-400 mt-1">@SharedLocalizer["Auth_ResetPasswordSubtitle"]</p>
            <button onclick="closeForgotModal()" class="absolute right-5 top-5 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-rose-50 hover:text-rose-500 transition-all text-xl">
                &times;
            </button>
        </div>

        <form id="forgotForm" class="p-6 space-y-4">
            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["Auth_RegisteredEmail"]</label>
                <input type="email" name="email" id="forgotEmail" required
                       class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-400 rounded-xl outline-none text-sm transition-all"
                       placeholder="yourname@gmail.com">
            </div>

            <div class="pt-2">
                <button type="submit" id="btnForgotSubmit"
                        class="w-full py-3 btn-grad text-white rounded-xl font-bold text-sm shadow-lg hover:shadow-teal-200 active:scale-95 transition-all">
                    @SharedLocalizer["Auth_SendTemporaryPassword"]
                </button>
            </div>

            <div class="text-center text-xs text-gray-500 pt-2">
                @SharedLocalizer["Auth_RememberPassword"]
                <button type="button" onclick="switchToLoginModal()" class="font-bold text-teal-600 hover:underline">
                    @SharedLocalizer["Auth_BackToSignIn"]
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let otpTimerInterval = null;

    // 1. Kiểm tra tính hợp lệ của Form Đăng ký & Gửi OTP đến Gmail
    function initiateRegistration() {
        const name = $('#regName').val().trim();
        const email = $('#regEmail').val().trim();
        const password = $('#regPassword').val().trim();
        const confirmPassword = $('#regConfirmPassword').val().trim();
        const captchaAnswer = $('#registerCaptchaInput').val().trim();

        if (!name || !email || !password || !captchaAnswer) {
            showToast("@(SharedLocalizer["Auth_FillRequiredFields"]?.Value ?? "Please fill in all required fields!")", "error");
            return;
        }

        if (password.length < 6) {
            showToast("@(SharedLocalizer["Auth_PasswordMinLength"]?.Value ?? "Password must be at least 6 characters!")", "error");
            return;
        }

        if (password !== confirmPassword) {
            showToast("@(SharedLocalizer["Auth_PasswordMismatch"]?.Value ?? "Confirm password does not match!")", "error");
            return;
        }

        const $btn =$('#btnRegisterSubmit');
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i> Sending OTP...');

        $.ajax({
            url: '/Login/SendRegisterOtp',
            type: 'POST',
            data: { email: email, captchaAnswer: captchaAnswer },
            success: function (res) {
                if (res.success) {
                    showToast(res.message, "success");
                    $('#otpDisplayEmail').text(email);
                    openOtpModal();
                    startOtpTimer(60);
                } else {
                    showToast(res.message || "Failed to send OTP", "error");
                    if (res.needNewCaptcha) refreshRegisterCaptcha();
                }
            },
            error: function () {
                showToast("Cannot connect to server!", "error");
            },
            complete: function () {
                $btn.prop('disabled', false).html("@SharedLocalizer["Auth_RegisterAccount"]");
            }
        });
    }

    // 2. Mở / Đóng Modal OTP
    function openOtpModal() {
        const $overlay = $('#otpModalOverlay');
        const $content = $('#otpModalContent');
        $overlay.removeClass('hidden').addClass('flex');
        setTimeout(() => {
            $content.removeClass('translate-y-10 opacity-0').addClass('translate-y-0 opacity-100');
        }, 10);
        $('#regOtpInput').val('').focus();
    }

    // Đóng Modal OTP
    function closeOtpModal() {
        const $overlay = $('#otpModalOverlay');
        const $content = $('#otpModalContent');
        $content.removeClass('translate-y-0 opacity-100').addClass('translate-y-10 opacity-0');
        setTimeout(() => {
            $overlay.removeClass('flex').addClass('hidden');
        }, 300);
        if (otpTimerInterval) clearInterval(otpTimerInterval);
    }

    // 3. Đếm ngược gửi lại OTP
    function startOtpTimer(seconds) {
        let counter = seconds;
        $('#btnResendOtp').addClass('hidden');
        $('#otpCountdownText').removeClass('hidden').text(`Resend code in ${counter}s`);

        if (otpTimerInterval) clearInterval(otpTimerInterval);

        otpTimerInterval = setInterval(() => {
            counter--;
            if (counter > 0) {
                $('#otpCountdownText').text(`Resend code in ${counter}s`);
            } else {
                clearInterval(otpTimerInterval);
                $('#otpCountdownText').addClass('hidden');
                $('#btnResendOtp').removeClass('hidden');
            }
        }, 1000);
    }

    function resendOtpCode() {
        const email = $('#regEmail').val().trim();
        const captchaAnswer = $('#registerCaptchaInput').val().trim();

        $.ajax({
            url: '/Login/SendRegisterOtp',
            type: 'POST',
            data: { email: email, captchaAnswer: captchaAnswer },
            success: function (res) {
                if (res.success) {
                    showToast(res.message, "success");
                    startOtpTimer(60);
                } else {
                    showToast(res.message, "error");
                }
            }
        });
    }

    // 4. Gửi Form Đăng ký kèm Mã OTP xác nhận
    function submitFinalRegistration() {
        const otpCode = $('#regOtpInput').val().trim();
        if (!otpCode || otpCode.length < 6) {
            showToast("Please enter the 6-digit OTP code!", "error");
            return;
        }

        const formData = new FormData(document.getElementById('registerForm'));
        formData.append('otpCode', otpCode);

        const $btn =$('#btnVerifyOtpSubmit');
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i> Creating...');

        $.ajax({
            url: '/Login/Register',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                if (res.success) {
                    showToast(res.message, "success");
                    closeOtpModal();
                    closeRegisterModal();
                    setTimeout(() => openLoginModal(), 600);
                } else {
                    showToast(res.message || "Registration failed!", "error");
                }
            },
            error: function () {
                showToast("System error during registration!", "error");
            },
            complete: function () {
                $btn.prop('disabled', false).html("@(SharedLocalizer["Auth_ConfirmAndCreate"]?.Value ?? "Confirm & Create")");
            }
        });
    }
</script>