<div id="chat-box"
     class="fixed bottom-20 right-5 w-[92vw] sm:w-[480px] md:w-[500px] max-h-[680px] h-[75vh] bg-white shadow-2xl rounded-2xl overflow-hidden border border-gray-100 flex flex-col font-sans transition-all duration-300 transform translate-y-10 opacity-0 pointer-events-none z-50"
     style="z-index: 1011;"
     data-no-response="@SharedLocalizer["SharedChat_NoResponse"]"
     data-http-error="@SharedLocalizer["SharedChat_HttpError"]"
     data-connection-error="@SharedLocalizer["SharedChat_ConnectionError"]">

    <!-- Header Chatbox -->
    <div class="btn-grad px-5 py-3.5 flex justify-between items-center shadow-md select-none">
        <div class="flex items-center gap-3">
            <div class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse shadow-sm"></div>
            <h3 class="font-bold text-white text-base tracking-wide flex items-center gap-2">
                <i class="fa-solid fa-wand-magic-sparkles text-xs"></i>
                @SharedLocalizer["SharedChat_Title"]
            </h3>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" onclick="clearChatHistory()" title="@SharedLocalizer["SharedChat_ClearHistory"]" class="hover:bg-white/20 text-white w-8 h-8 rounded-full flex items-center justify-center transition">
                <i class="fa-regular fa-trash-can text-xs"></i>
            </button>
            <button type="button" onclick="toggleChat()" title="@SharedLocalizer["Btn_Close"]" class="hover:bg-white/20 text-white w-8 h-8 rounded-full flex items-center justify-center transition hover:rotate-90">
                <i class="fa-solid fa-xmark text-sm font-bold"></i>
            </button>
        </div>
    </div>

    <!-- Khung lịch sử tin nhắn -->
    <div id="chat-history" class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-4 bg-[#f8f9fa]">
        <div class="flex justify-start">
            <div class="btn-grad-gray border border-gray-200 text-gray-800 p-4 rounded-2xl rounded-tl-none max-w-[90%] text-xs sm:text-[13px] shadow-sm leading-relaxed whitespace-pre-line line-height-relaxed">
                @SharedLocalizer["SharedChat_Welcome"]
            </div>
        </div>
    </div>

    <!-- Footer nhập liệu và thanh Actions -->
    <div class="p-4 bg-white border-t border-gray-100 space-y-2.5">
        <!-- Thanh Action Chips -->
        <div class="flex gap-1.5 overflow-x-auto no-scrollbar py-1">
            <button type="button" onclick="triggerChapterAnalysis('Summary', this)" class="ai-action-chip">
                <i class="fa-solid fa-bolt"></i>
                <span>@SharedLocalizer["Ai_Action_ChapterSummary"]</span>
            </button>

            <button type="button" onclick="triggerChapterAnalysis('Feelings', this)" class="ai-action-chip active badge-pill bg-main">
                <i class="fa-solid fa-book-open-reader"></i>
                <span>@SharedLocalizer["Ai_Action_Impression"]</span>
            </button>

            <button type="button" onclick="triggerChapterAnalysis('Lore', this)" class="ai-action-chip">
                <i class="fa-solid fa-compass"></i>
                <span>@SharedLocalizer["Ai_Action_LoreDecode"]</span>
            </button>

            <button type="button" onclick="setModeAndTrigger('Explain')" class="ai-action-chip">
                <i class="fa-solid fa-lightbulb"></i>
                <span>@SharedLocalizer["Ai_Action_ExplainPassage"]</span>
            </button>

            <button type="button" onclick="setModeAndTrigger('Grammar')" class="ai-action-chip">
                <i class="fa-solid fa-layer-group"></i>
                <span>@SharedLocalizer["Ai_Action_Grammar"]</span>
            </button>
        </div>

        <!-- Ô nhập văn bản -->
        <div class="relative flex items-center">
            <textarea id="user-input" rows="2"
                      class="w-full pl-3.5 pr-12 py-2.5 bg-gray-50 border border-gray-200 text-black rounded-xl focus:outline-none focus:ring-2 focus:ring-teal-400 focus:bg-white resize-none transition-all text-xs sm:text-[13px] leading-relaxed"
                      placeholder="@SharedLocalizer["SharedChat_Placeholder"]"></textarea>

            <button id="btnSendChat" onclick="submitCurrentChat()"
                    class="absolute right-2.5 w-8 h-8 flex items-center justify-center rounded-lg btn-grad text-white shadow-md active:scale-95 transition-all">
                <i class="fa-solid fa-paper-plane text-xs"></i>
            </button>
        </div>
    </div>
</div>

@* Dictionary bản dịch Client-Side JS *@
<script>
    window.AI_LANG = {
        SaveQuote: @Json.Serialize(SharedLocalizer["Ai_SaveQuote"].Value),
        Copy: @Json.Serialize(SharedLocalizer["Ai_Copy"].Value),
        CopiedToClipboard: @Json.Serialize(SharedLocalizer["Ai_CopiedToClipboard"].Value),
        NetworkErrorSave: @Json.Serialize(SharedLocalizer["Ai_NetworkErrorSave"].Value),
        ReqSummary: @Json.Serialize(SharedLocalizer["Ai_ReqSummary"].Value),
        ReqLore: @Json.Serialize(SharedLocalizer["Ai_ReqLore"].Value),
        ReqImpression: @Json.Serialize(SharedLocalizer["Ai_ReqImpression"].Value)
    };
</script>