@model WebTruyenTranh.ViewModels.ChaptersPagedViewModel

<div class="tab-content w-100" id="storyTabsContent">
    <div class="d-flex flex-column gap-3 w-100" id="chapter-list">

        @if (Model.Chapters != null && Model.Chapters.Any())
        {
            foreach (var item in Model.Chapters)
            {
                <a href="/Paragraphs/Content?chapterId=@item.ChapterId"
                   class="chapter-item">

                    <div class="chapter-thumb-wrapper">
                        <img src="https://picsum.photos/300/180?random=@item.ChapterId"
                             alt="Chương @item.ChapterNumber"
                             class="chapter-thumb-img"
                             loading="lazy" />
                    </div>

                    <div class="chapter-info-wrapper">
                        <div class="chapter-title text-main">
                            Chương @item.ChapterNumber: @item.Title
                        </div>

                        <div class="chapter-meta">
                            <span class="text-main">
                                <i class="far text-main fa-clock me-1"></i>
                                @item.CreatedDate?.ToString("dd/MM/yyyy")
                            </span>
                            <span class="text-main">
                                <i class="far text-main fa-eye me-1"></i>Tự động cập nhật
                            </span>
                        </div>
                    </div>

                    <div class="chapter-arrow">
                        <i class="fas fa-chevron-right"></i>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="text-center p-4 text-muted bg-white rounded-4 border border-light" style="border-radius: 20px;">
                <p class="mb-0 small fst-italic">Truyện hiện chưa có chương nào.</p>
            </div>
        }

    </div>

    <div class="w-100 py-4 d-flex justify-content-center">
        <nav aria-label="Chapter pagination">
            <ul class="pagination pagination-modern mb-0" data-story-id="@Model.StoryId">

                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link page-nav-link" href="#" data-page="@(Model.CurrentPage - 1)" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link page-nav-link" href="#" data-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link page-nav-link" href="#" data-page="@(Model.CurrentPage + 1)" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>

            </ul>
        </nav>
    </div>
</div>