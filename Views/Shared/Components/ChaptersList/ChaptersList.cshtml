@model WebTruyenTranh.ViewModels.ChaptersPagedViewModel

@{
    bool chapIsVi = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("vi", StringComparison.OrdinalIgnoreCase);
    string totalText = Model.TotalChapters.ToString("00");
}
<div class="tab-content w-100" id="storyTabsContent">
    <!-- Tiêu đề mục: cùng phong cách với từng dòng chương bên dưới -->
    <div class="chap-header">
        <div class="chap-header-text">
            <h2 class="chap-header-title">@SharedLocalizer["Story_ChapterList"]</h2>
            <span class="chap-header-sub">@(chapIsVi ? "Mục lục" : "Table of contents")</span>
        </div>
        <div class="chap-header-count" aria-label="@Model.TotalChapters @SharedLocalizer["Story_Chapter"]">
            <span class="chap-num" aria-hidden="true"><span class="chap-num-head">@totalText.Substring(0, totalText.Length - 1)</span><span class="chap-num-tail">@totalText.Substring(totalText.Length - 1)</span></span>
            <span class="chap-header-sub">@SharedLocalizer["Story_Chapter"]</span>
        </div>
    </div>

    <div class="chap-list w-100" id="chapter-list">

        @if (Model.Chapters != null && Model.Chapters.Any())
        {
            int rowIndex = 0;
            foreach (var item in Model.Chapters)
            {
                // Số chương dạng 01, 02... : phần đầu xám nhạt, chữ số cuối màu teal
                string num = item.ChapterNumber.ToString("00");
                string numHead = num.Substring(0, num.Length - 1);
                string numTail = num.Substring(num.Length - 1);
                string chapterLabel = $"{SharedLocalizer["Story_Chapter"]} {num}";
                string title = string.IsNullOrWhiteSpace(item.Title) ? chapterLabel : item.Title;
                bool isRight = rowIndex % 2 == 1;   // dòng chẵn đảo sang phải (kiểu zigzag)
                rowIndex++;

                <a href="/Paragraphs/Content?chapterId=@item.ChapterId"
                   class="chap-row @(isRight ? "is-right" : "")"
                   title="@chapterLabel: @title">

                    <div class="chap-head">
                        <span class="chap-num" aria-hidden="true"><span class="chap-num-head">@numHead</span><span class="chap-num-tail">@numTail</span></span>
                        <span class="chap-text">
                            <span class="chap-title">@title</span>
                            <span class="chap-sub">
                                @chapterLabel
                                @if (item.CreatedDate.HasValue)
                                {
                                    <span class="chap-dot">·</span>
                                    <span>@item.CreatedDate.Value.ToString("dd/MM/yyyy")</span>
                                }
                            </span>
                        </span>
                    </div>

                    <span class="chap-tag">
                        <i class="fas fa-book-open"></i>
                        @SharedLocalizer["Story_ReadNow"]
                    </span>
                </a>
            }
        }
        else
        {
            <div class="text-center p-4 text-muted bg-white rounded-4 border border-light" style="border-radius: 20px;">
                <p class="mb-0 small fst-italic">@SharedLocalizer["Chapter_NoChaptersYet"]</p>
            </div>
        }

    </div>

    <div class="w-100 py-4 d-flex justify-content-center">
        <nav aria-label="@SharedLocalizer["Chapter_Pagination"]">
            <ul class="pagination pagination-modern mb-0" data-story-id="@Model.StoryId">

                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link page-nav-link" href="#" data-page="@(Model.CurrentPage - 1)" aria-label="@SharedLocalizer["Chapter_PreviousPage"]">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link page-nav-link" href="#" data-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link page-nav-link" href="#" data-page="@(Model.CurrentPage + 1)" aria-label="@SharedLocalizer["Chapter_NextPage"]">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>

            </ul>
        </nav>
    </div>
</div>