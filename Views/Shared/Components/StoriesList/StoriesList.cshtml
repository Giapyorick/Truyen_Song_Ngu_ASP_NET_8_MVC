@using WebTruyenTranh.ViewModels
@model IList<StoryListViewModel>

<div class="w-full space-y-6" data-story-no-search-matches="@SharedLocalizer["Story_NoSearchMatches"]" data-story-search-results-for="@SharedLocalizer["Story_SearchResultsFor"]" data-story-search-failed="@SharedLocalizer["Story_SearchFailed"]">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h2 class="section-title text-cus text-xl sm:text-2xl font-black uppercase tracking-tight">
            @SharedLocalizer["Story_LatestStories"]
        </h2>
        <span class="text-xs text-slate-400 font-medium">@SharedLocalizer["Story_ScrollToDiscover"]</span>
    </div>

    <!-- KHUNG CHỨA THẺ TRUYỆN -->
    <div class="story-grid" id="mainStoryGrid">
    </div>

    <!-- PHẦN TỬ QUAN SÁT ĐÁY MÀN HÌNH -->
    <div id="infiniteScrollTrigger" class="py-10 flex flex-col items-center justify-center gap-2">
        <div id="scrollSpinner" class="flex items-center gap-2 text-teal-600 font-bold text-sm">
            <i class="fa-solid fa-circle-notch fa-spin text-lg"></i>
            <span>@SharedLocalizer["Story_LoadingStories"]</span>
        </div>
        <div id="noMoreData" class="hidden text-xs text-gray-400 font-medium py-4">
            🎉 @SharedLocalizer["Story_AllCaughtUp"]
        </div>
    </div>
</div>