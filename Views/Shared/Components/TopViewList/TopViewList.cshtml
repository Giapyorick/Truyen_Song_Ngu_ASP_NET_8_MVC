@using WebTruyenTranh.ViewModels
@model IList<TopViewListViewModel>

@{
    int stt = 1; // Khởi tạo biến đếm cho số thứ tự
}

@foreach (var t in Model)
{
    <div class="hot-item">
        <span class="rank">@(stt++)</span>

        <div class="hot-item-img">
            <a href="#">
                <img src="~/@t.img" alt="@t.Title" />
            </a>
        </div>

        <div class="hot-item-info">
            <a href="#" class="hot-item-title">@t.Title</a>

            <span class="hot-item-author">Tác giả: @t.author</span>

            <span class="hot-item-view">@t.Likes lượt thích</span>
        </div>
    </div>
}