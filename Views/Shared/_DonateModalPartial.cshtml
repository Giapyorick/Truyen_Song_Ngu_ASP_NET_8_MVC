@* Không dùng "@using WebTruyenTranh.Helpers" vì trong Helpers cũng có class SharedResource -> trùng tên với _ViewImports *@
@{
    bool dnVi = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("vi", StringComparison.OrdinalIgnoreCase);
    bool dnQrOk = WebTruyenTranh.Helpers.DonationInfo.PayloadMatchesAccount();
