<div id="donateModal" class="donate-modal" hidden role="dialog" aria-modal="true" aria-labelledby="donateTitle">
    <div class="donate-backdrop" data-donate-close></div>

    <div class="donate-box" role="document">
        <button type="button" class="donate-x" data-donate-close aria-label="@(dnVi ? "Đóng" : "Close")">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="donate-head">
            <span class="donate-heart-badge"><i class="fa-solid fa-heart"></i></span>
            <div>
                <h3 id="donateTitle">@(dnVi ? "Ủng hộ tác giả" : "Support the author")</h3>
                <p>@(dnVi ? "Bạn có thể quét mã QR hoặc chuyển khoản theo thông tin bên dưới." : "Scan the QR code or transfer using the details below.")</p>
            </div>
        </div>

        <div class="donate-grid">
            <!-- CỘT TRÁI: mã QR + chọn số tiền -->
