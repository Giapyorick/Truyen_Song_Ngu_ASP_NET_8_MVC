                        <span class="donate-field-label">@(dnVi ? "Ngân hàng" : "Bank")</span>
                        <span class="donate-field-value">@WebTruyenTranh.Helpers.DonationInfo.BankName</span>
                        <span class="donate-field-sub">@WebTruyenTranh.Helpers.DonationInfo.BankBranch</span>
                    </div>
                    <button type="button" class="donate-copy" data-copy="@WebTruyenTranh.Helpers.DonationInfo.BankName"
                            aria-label="@(dnVi ? "Sao chép ngân hàng" : "Copy bank")" title="@(dnVi ? "Sao chép" : "Copy")">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>
                <div class="donate-field">
                    <div class="donate-field-text">
                        <span class="donate-field-label">@(dnVi ? "Chủ tài khoản" : "Account name")</span>
                        <span class="donate-field-value">@WebTruyenTranh.Helpers.DonationInfo.AccountName</span>
                    </div>
                    <button type="button" class="donate-copy" data-copy="@WebTruyenTranh.Helpers.DonationInfo.AccountName"
                            aria-label="@(dnVi ? "Sao chép chủ tài khoản" : "Copy account name")" title="@(dnVi ? "Sao chép" : "Copy")">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>
                <div class="donate-field">
                    <div class="donate-field-text">
                        <span class="donate-field-label">@(dnVi ? "Số tài khoản" : "Account number")</span>
                        <span class="donate-field-value"><span class="donate-number">@WebTruyenTranh.Helpers.DonationInfo.AccountNumber</span></span>
                    </div>
                    <button type="button" class="donate-copy" data-copy="@WebTruyenTranh.Helpers.DonationInfo.AccountNumber"
                            aria-label="@(dnVi ? "Sao chép số tài khoản" : "Copy account number")" title="@(dnVi ? "Sao chép" : "Copy")">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>
                <div class="donate-field donate-field--note">
                    <div class="donate-field-text">
                        <span class="donate-field-label">@(dnVi ? "Nội dung chuyển khoản" : "Transfer note")</span>
                        <span class="donate-field-value">@WebTruyenTranh.Helpers.DonationInfo.TransferNote</span>
                    </div>
                    <button type="button" class="donate-copy" data-copy="@WebTruyenTranh.Helpers.DonationInfo.TransferNote"
                            aria-label="@(dnVi ? "Sao chép nội dung chuyển khoản" : "Copy transfer note")" title="@(dnVi ? "Sao chép" : "Copy")">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>
            </div>
        </div>

        <p class="donate-note">
            <i class="fa-solid fa-shield-halved"></i>
            <span>@(dnVi
                ? "Mã QR theo chuẩn VietQR (Napas 247), tự đổi theo số tiền bạn chọn. Hãy kiểm tra đúng người nhận "
                : "The QR follows the VietQR standard (Napas 247) and changes with the amount you pick. Please check the recipient ")<b>@WebTruyenTranh.Helpers.DonationInfo.AccountName</b>@(dnVi
                ? " và số tiền trong ứng dụng ngân hàng trước khi chuyển."
                : " and the amount in your banking app before sending.")</span>
        </p>

        <div class="donate-divider"></div>

        <p class="donate-foot">
            @(dnVi
                ? "Bilingual Novel không yêu cầu đóng góp để đọc truyện – mọi ủng hộ đều tự nguyện. Mình không bao giờ nhắn tin xin chuyển vào tài khoản khác. Cần hỏi gì, bạn có thể "
                : "Reading on Bilingual Novel is always free – every contribution is voluntary. I will never message you asking to transfer to another account. Questions? Feel free to ")<a href="/contact">@(dnVi ? "liên hệ mình" : "contact me")</a>.
        </p>
    </div>
</div>
