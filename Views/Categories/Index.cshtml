@using Microsoft.Extensions.Localization
@using WebTruyenTranh
@using WebTruyenTranh.ViewModels
@inject IStringLocalizer<SharedResource> SharedLocalizer
@model IList<StoryListViewModel>
@{
    ViewData["Title"] = SharedLocalizer["Cat_Category"].Value + " " + (ViewBag.SelectedCategoryName ?? "");
    var categories = ViewBag.Categories as List<CategoryItemDto> ?? new List<CategoryItemDto>();
    int selectedCatId = ViewBag.SelectedCategoryId ?? 0;
}

<div class="min-h-screen bg-[#F8FAFC] py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

        <!-- THANH DANH SÁCH THỂ LOẠI -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm space-y-6">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                <div>
                    <span class="text-xs font-bold text-cus uppercase tracking-wider flex items-center gap-2">
                        <i class="fas fa-layer-group"></i> @SharedLocalizer["Cat_StoryCategories"]
                    </span>
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-main mt-1">
                        @SharedLocalizer["Cat_DiscoverByCategory"]
                    </h1>
                </div>
                <div class="text-xs text-gray-400 font-medium">
                    @SharedLocalizer["Cat_Total"] <strong class="text-main font-bold">@categories.Count</strong> @SharedLocalizer["Cat_Unit"]
                </div>
            </div>

            <!-- List thẻ tab đổi thể loại -->
            <div class="flex flex-wrap gap-2.5" id="categoryTabContainer">
                @foreach (var cat in categories)
                {
                    bool isSelected = (cat.CategoryId == selectedCatId);
                    <button type="button"
                            onclick="selectCategory(@cat.CategoryId, '@Html.Raw(cat.Name)', '@Html.Raw(cat.Description ?? "")', this)"
                            class="cat-pill @(isSelected ? "active-cat" : "")">
                        <span>@cat.Name</span>
                        <span class="cat-count">@cat.StoryCount</span>
                    </button>
                }
            </div>
        </div>

        <!-- HEADER THỂ LOẠI ĐANG CHỌN -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pl-4">
            <div>
                <h2 class="text-xl sm:text-2xl font-extrabold text-cus">
                    @SharedLocalizer["Cat_Category"] <span id="currentCategoryTitle" class="text-main">@ViewBag.SelectedCategoryName</span>
                </h2>
                <p id="currentCategoryDesc" class="text-xs sm:text-sm text-gray-500 mt-1">
                    @ViewBag.SelectedCategoryDesc
                </p>
            </div>
        </div>

        <!-- KHUNG HIỂN THỊ TRUYỆN -->
        <div id="storyListWrapper">
            <!-- Để rỗng hoàn toàn để storyScroller tự nạp -->
            <div class="story-grid" id="mainStoryGrid">
            </div>

            <div id="infiniteScrollTrigger" class="py-10 flex flex-col items-center justify-center gap-2">
                <div id="scrollSpinner" class="flex items-center gap-2 text-teal-600 font-bold text-sm">
                    <i class="fa-solid fa-circle-notch fa-spin text-lg"></i>
                    <span>@SharedLocalizer["Story_LoadingStories"]</span>
                </div>
                <div id="noMoreData" class="hidden text-xs text-gray-400 font-medium py-4">
                    🎉 @SharedLocalizer["Cat_AllCaughtUp"]
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/infinite_scroll.js"></script>

    <script>
        $(document).ready(function () {
            window.storyScroller = new InfiniteScroller({
                gridSelector: '#mainStoryGrid',
                triggerSelector: '#infiniteScrollTrigger',
                spinnerSelector: '#scrollSpinner',
                noMoreSelector: '#noMoreData',
                endpoint: '/Stories/GetStoriesInfinite',
                pageSize: 8,
                params: { 
                    categoryId: @selectedCatId,
                    search: ''
                }
            });
        });

        function selectCategory(categoryId, categoryName, categoryDesc, buttonElem) {
            window.history.pushState({ categoryId: categoryId }, '', '?categoryId=' + categoryId);

            $('.cat-pill').removeClass('active-cat');
            $(buttonElem).addClass('active-cat');

            $('#currentCategoryTitle').text(categoryName);
            $('#currentCategoryDesc').text(categoryDesc);

            if (window.storyScroller) {
                window.storyScroller.reset({ categoryId: categoryId, search: '' });
            }
        }
    </script>
}

<style>
    .cat-pill {
        padding: 10px 22px;
        border-radius: 14px;
        font-size: 13px;
        font-weight: 700;
        transition: all 0.5s ease;
        background-color: #ffffff;
        border: 1.5px solid #e2e8f0;
        color: #475569;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .cat-pill:hover:not(.active-cat) {
        border-color: #50C9C3;
        color: #0d9488;
        box-shadow: 0 4px 14px rgba(80, 201, 195, 0.18);
        transform: translateY(-2px);
    }

    .cat-pill.active-cat {
        background-image: linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%);
        background-size: 200% auto;
        color: #ffffff !important;
        border: 1.5px solid transparent;
        box-shadow: 0 6px 18px rgba(80, 201, 195, 0.35);
        transform: translateY(-2px);
    }

    .cat-pill.active-cat:hover {
        background-position: right center;
        color: #ffffff !important;
    }

    .cat-pill .cat-count {
        font-size: 11px;
        padding: 2px 7px;
        border-radius: 9999px;
        transition: all 0.3s ease;
        background-color: #f1f5f9;
        color: #64748b;
    }

    .cat-pill.active-cat .cat-count {
        background-color: rgba(255, 255, 255, 0.25);
        color: #ffffff;
    }

    #currentCategoryTitle {
        background: linear-gradient(to right, #0d9488, #50C9C3);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>