@model WebTruyenTranh.Models.TblStory
<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 85vh;">
    <div class="card border-0 shadow-xl overflow-hidden st-detail-card" style="border-radius: 32px; background: #ffffff; max-width: 1180px; width: 100%;">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-5 align-items-stretch">

                <!-- BÊN TRÁI: ẢNH + OVERLAY -->
                <div class="col-lg-5">
                    <div class="st-image-wrapper position-relative h-100 rounded-4 overflow-hidden shadow-sm">
                        <img src="/@Model.Img" class="st-main-img w-100 h-100" alt="@Model.Title">

                        <div class="st-image-overlay d-flex align-items-end p-4">
                            <div class="w-100">
                                <div class="st-line-glow mb-3"></div>
                                <h2 class="st-overlay-title text-white mb-3">@Model.Title</h2>
                                <div class="st-description-scroll text-white-50">
                                    @Model.Description
                                </div>
                            </div>
                        </div>

                        <div class="position-absolute top-0 start-0 m-4">
                            <span class="badge st-badge-id">#ID @Model.StoryId</span>
                        </div>
                    </div>
                </div>

                <!-- BÊN PHẢI: THÔNG TIN + STATS -->
                <div class="col-lg-7 d-flex flex-column">
                    <div class="st-info-panel flex-grow-1">
                        <h1 class="fw-bold st-text-gradient mb-3">@Model.Title</h1>

                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="st-author-tag">
                                <i class="fas fa-user-edit me-2"></i>
                                Tác giả ID: @Model.AuthorId
                            </div>
                            <span class="st-status-badge">
                                <span class="st-dot"></span>
                                @Model.Status
                            </span>
                        </div>

                        <!-- Thống kê -->
                        <div class="row g-3 mb-5">
                            <div class="col-4">
                                <div class="st-stat-card text-center h-100">
                                    <div class="st-stat-icon icon-star"><i class="fas fa-star"></i></div>
                                    <div class="st-stat-value">@Model.Rate</div>
                                    <div class="st-stat-label">@Model.CountRate đánh giá</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="st-stat-card text-center h-100">
                                    <div class="st-stat-icon icon-heart"><i class="fas fa-heart"></i></div>
                                    <div class="st-stat-value">@Model.Likes</div>
                                    <div class="st-stat-label">Lượt thích</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="st-stat-card text-center h-100">
                                    <div class="st-stat-icon icon-date"><i class="fas fa-calendar"></i></div>
                                    <div class="st-stat-value text-sm">@Model.PublicationDate?.ToString("dd/MM/yyyy")</div>
                                    <div class="st-stat-label">Ngày đăng</div>
                                </div>
                            </div>
                        </div>

                        <!-- Nút hành động -->
                        <div class="d-grid gap-3 mt-auto">
                            <button class="st-btn-grad py-3 fw-bold">
                                <i class="fas fa-book-open me-3"></i>ĐỌC NGAY
                            </button>
                            <button class="st-btn-grad-trans py-3 fw-bold">
                                <i class="fas fa-heart me-3"></i>THEO DÕI (@Model.CountFolower)
                            </button>
                            <button class="st-btn-grad-cancel py-2">
                                <i class="fas fa-flag me-2"></i>Báo cáo
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Phần dưới: Tab Chương & Bình luận -->
            <div class="mt-5">
                <ul class="nav nav-tabs mb-4" id="storyTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#chapters-panel" type="button">
                            <i class="fas fa-list me-2"></i>Danh sách chương
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#comments-panel" type="button">
                            <i class="fas fa-comments me-2"></i>Bình luận
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="chapters-panel">
                        <!-- Nội dung chương -->
                        <div class="list-group list-group-flush rounded-4 overflow-hidden border">
                            <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 px-4">
                                <span><i class="fas fa-file-alt me-3 text-muted"></i>Chương 1: Khởi đầu một hành trình mới</span>
                                <small class="text-muted">Vừa xong</small>
                            </a>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="comments-panel">
                        <!-- Bình luận mẫu -->
                        <div class="p-3 bg-light rounded-4 d-flex gap-3">
                            <div class="w-10 h-10 rounded-circle bg-info flex-shrink-0 d-flex align-items-center justify-content-center text-white fw-bold">A</div>
                            <div>
                                <div class="fw-bold">Độc Giả Thân Thiết <small class="text-muted">5 phút trước</small></div>
                                <div class="text-muted">Giao diện mới đẹp và chuyên nghiệp hơn hẳn!</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .st-detail-card {
        font-family: 'Inter', system-ui, sans-serif;
    }

    .st-image-wrapper {
        height: 520px;
        background: #f8f9fa;
    }

    .st-main-img {
        object-fit: cover;
        transition: all 0.6s ease;
    }

    .st-image-wrapper:hover .st-main-img {
        transform: scale(1.04);
    }

    .st-image-overlay {
        background: linear-gradient(to top, rgba(0,0,0,0.85), rgba(0,0,0,0.3));
        opacity: 0;
        transition: all 0.4s ease;
    }

    .st-image-wrapper:hover .st-image-overlay {
        opacity: 1;
    }

    .st-overlay-title {
        font-size: 1.65rem;
        font-weight: 800;
        text-shadow: 0 2px 10px rgba(0,0,0,0.6);
    }

    .st-description-scroll {
        max-height: 180px;
        overflow-y: auto;
        font-size: 0.95rem;
        line-height: 1.75;
    }

    .st-info-panel {
        background: #fff;
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
        height: 100%;
    }

    .st-stat-card {
        background: #f8f9fa;
        padding: 16px 12px;
        border-radius: 18px;
        transition: all 0.3s ease;
    }

        .st-stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        }

    .st-stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: #2d3436;
    }

    .st-text-gradient {
        background: linear-gradient(90deg, #2d3436, #0984e3);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .st-status-badge {
        background: #e3fcef;
        color: #00b894;
        padding: 6px 18px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .st-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        background: #00b894;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    .st-badge-id {
        background: rgba(0,0,0,0.65);
        color: white;
        padding: 6px 14px;
        border-radius: 10px;
        font-weight: 700;
    }

    .st-btn-grad {
        background: linear-gradient(90deg, #50C9C3, #96DEDA);
        border: none;
        color: white;
        font-weight: 700;
        border-radius: 16px;
        transition: all 0.4s;
    }

    .st-btn-grad-trans {
        background: linear-gradient(90deg, #ff6b6b, #ee5a24);
        border: none;
        color: white;
        font-weight: 700;
        border-radius: 16px;
    }

    .st-btn-grad-cancel {
        background: #f1f3f5;
        color: #666;
        border-radius: 12px;
    }

    .st-btn-grad:hover, .st-btn-grad-trans:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15);
    }

    @<style>
    ...
    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.4;
        }
    }
    ...
</style> pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.4;
        }
    }

    @media (max-width: 992px) {
        .st-image-wrapper {
            height: 420px;
        }

        .st-info-panel {
            padding: 1.5rem;
        }
    }
</style>