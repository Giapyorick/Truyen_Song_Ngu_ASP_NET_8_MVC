@model WebTruyenTranh.Models.TblStory

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card border-0 shadow-lg overflow-hidden st-detail-card" style="border-radius: 30px; background: #ffffff; max-width: 1150px; width: 100%;">
        <div class="row g-3">

            <!-- TOP ROW: red (70%) and blue (30%) -->
            <div class="col-12">
                <div class="st-top-row d-flex flex-wrap">

                    <div class="st-red-col st-red-section">
                        <div class="card st-panel h-100">
                            <div class="card-body d-flex flex-column">

                                <h2 class="fw-bold st-text-gradient mb-2">
                                    @Model.Title
                                </h2>

                                <div class="mb-3 st-author-tag">
                                    <i class="fas fa-user-edit me-2"></i>
                                    @Model.AuthorId
                                </div>

                                <div class="mb-4">
                                    <span class="st-status-badge">
                                        <span class="st-dot"></span>
                                        @Model.Status
                                    </span>
                                </div>

                                <div class="row g-3">

                                    <div class="col-12">
                                        <div class="st-stat-card">
                                            <div class="st-stat-icon icon-star">
                                                <i class="fas fa-star"></i>
                                            </div>

                                            <div class="st-stat-value">
                                                @Model.Rate
                                            </div>

                                            <div class="st-stat-label">
                                                @Model.CountRate lượt đánh giá
                                            </div>

                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="st-stat-card">
                                            <div class="st-stat-icon icon-heart">
                                                <i class="fas fa-heart"></i>
                                            </div>

                                            <div class="st-stat-value">
                                                @Model.Likes
                                            </div>

                                            <div class="st-stat-label">
                                                Lượt thích
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="st-stat-card">

                                            <div class="st-stat-icon icon-date">
                                                <i class="fas fa-calendar"></i>
                                            </div>

                                            <div class="st-stat-value fs-6">
                                                @Model.PublicationDate?.ToString("dd/MM/yyyy")
                                            </div>

                                            <div class="st-stat-label">
                                                Ngày đăng
                                            </div>

                                        </div>
                                    </div>

                                </div>

                                <div class="mt-auto pt-4">

                                    <div class="d-grid gap-2">

                                        <button class="st-btn-grad">
                                            <i class="fas fa-book-open me-2"></i>
                                            ĐỌC NGAY
                                        </button>

                                        <button class="st-btn-grad-trans">
                                            <i class="fas fa-heart me-2"></i>
                                            THEO DÕI (@Model.CountFolower)
                                        </button>

                                        <button class="st-btn-grad-cancel">
                                            Báo cáo
                                        </button>

                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="st-blue-col st-blue-section">
                        <div class="card st-panel h-100">

                            <div class="st-image-wrapper">

                                <img src="/@Model.Img"
                                     class="img-fluid st-main-img w-100"
                                     alt="@Model.Title">

                                <div class="st-image-overlay rounded-4 d-flex align-items-center justify-content-center">
                                    <div class="px-4 text-center">

                                        <h2 class="st-overlay-title">
                                            @Model.Title
                                        </h2>

                                        <div class="st-line-glow mb-3"></div>

                                        <p class="text-white">
                                            @Model.Description
                                        </p>

                                    </div>
                                </div>

                                <div class="position-absolute top-0 start-0 m-3">
                                    <span class="badge st-badge-id">
                                        #ID @Model.StoryId
                                    </span>
                                </div>

                            </div>

                        </div>
                    </div>

                </div>
            </div>

            <!-- BOTTOM (Green: comments & chapters) -->
            <div class="col-12 st-green-section">

                <div class="card st-panel">

                    <div class="card-body">

                        <ul class="nav nav-tabs mb-4">

                            <li class="nav-item">
                                <button class="nav-link active">
                                    Danh sách chương
                                </button>
                            </li>

                            <li class="nav-item">
                                <button class="nav-link">
                                    Bình luận
                                </button>
                            </li>

                        </ul>

                        <!-- chapter list -->
                        <!-- comments -->

                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

<style>
    /* 1. Reset & Global - Chống xung đột tuyệt đối */
    .st-detail-card { font-family: 'Inter', sans-serif !important; border: 1px solid rgba(0,0,0,0.05) !important; }
    
.st-image-wrapper {
        overflow: hidden;
        cursor: pointer;
        position: relative;
    }

    .st-main-img {
        width: 100%;
        max-height: 450px;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), filter 0.6s ease;
    }

    .st-image-overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.4); /* Nền tối nhẹ */
        backdrop-filter: blur(0px); /* Mặc định không mờ */
        opacity: 0;
        transition: all 0.5s ease;
        z-index: 2;
    }

    .st-overlay-title {
        color: white !important;
        font-weight: 800;
        text-transform: uppercase;
        transform: translateY(30px);
        transition: all 0.5s ease;
        text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
        font-size: 1.5rem;
    }

    .st-line-glow {
        height: 3px;
        width: 0;
        background: #00c6ff;
        margin: 10px auto;
        transition: width 0.6s ease;
        box-shadow: 0 0 10px #00c6ff;
    }

    /* Hover vào cụm ảnh */
    .st-image-wrapper:hover .st-main-img {
        transform: scale(1.1);
        filter: blur(3px); /* Làm mờ ảnh khi hover */
    }

    .st-image-wrapper:hover .st-image-overlay {
        opacity: 1;
        backdrop-filter: blur(4px);
    }

    .st-image-wrapper:hover .st-overlay-title {
        transform: translateY(0);
    }

    .st-image-wrapper:hover .st-line-glow {
        width: 80%;
    }

    /* 3. Nút bấm bên trái - Style Gradient mượt */
    .st-btn-main {
        border: none; padding: 14px; border-radius: 15px; color: white !important;
        transition: 0.3s all cubic-bezier(0.4, 0, 0.2, 1); background-size: 200% auto;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .st-btn-read { background-image: linear-gradient(45deg, #00b09b, #96c93d); }
    .st-btn-follow { background-image: linear-gradient(45deg, #ff512f, #dd2476); }
    .st-btn-report { background-color: #f8f9fa !important; color: #666 !important; border: 1px solid #ddd; }
    .st-btn-main:hover { background-position: right center; transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.2); }

    /* 4. Thẻ thống kê (Stats Card) - Glassmorphism nhẹ */
    .st-stat-card {
        background: #ffffff; padding: 20px; border-radius: 20px; border: 1px solid #f0f0f0;
        text-align: center; transition: 0.4s; height: 100%;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
    .st-stat-card:hover { transform: translateY(-10px); border-color: #0072ff; box-shadow: 0 15px 35px rgba(0,114,255,0.15); }
    .st-stat-icon { font-size: 1.2rem; margin-bottom: 10px; }
    .icon-star { color: #ffc107; }
    .icon-heart { color: #ff4757; }
    .icon-date { color: #2ed573; }
    .st-stat-value { font-size: 1.4rem; font-weight: 800; color: #2d3436; }
    .st-stat-label { font-size: 0.8rem; color: #a4b0be; text-uppercase: uppercase; letter-spacing: 0.5px; }

    /* 5. Typography & Nội dung */
    .st-text-gradient {
        background: linear-gradient(90deg, #2d3436, #0984e3);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .st-author-tag { color: #747d8c; font-weight: 500; }
    .st-status-badge {
        background: #e3fcef; color: #00b894; padding: 6px 16px; border-radius: 50px;
        font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; gap: 8px;
    }
    .st-dot { width: 8px; height: 8px; background: #00b894; border-radius: 50%; display: inline-block; animation: pulse 2s infinite; }
    
    .st-section-title { font-weight: 700; color: #2d3436; margin-bottom: 15px; position: relative; padding-left: 15px; }
    .st-section-title::before { content: ''; position: absolute; left: 0; top: 5px; bottom: 5px; width: 4px; background: #0984e3; border-radius: 4px; }
    .st-description-box { color: #636e72; line-height: 1.8; text-align: justify; font-size: 1.05rem; }

    /* 6. Nút hành động cuối trang */
    .st-action-link {
        padding: 15px 30px; border-radius: 15px; font-weight: 700; text-decoration: none !important;
        transition: 0.4s; display: inline-flex; align-items: center;
    }
    .st-btn-chapters { background: #f1f2f6; color: #2f3542 !important; }
    .st-btn-ai { background: #000; color: #fff !important; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
    .st-action-link:hover { transform: scale(1.05); filter: brightness(1.1); }

    @@keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
    
    @@media (max-width: 991px) {
        .border-end { border-right: none !important; border-bottom: 1px solid #eee !important; }
    }

    .st-panel {
        border: none;
        border-radius: 25px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .st-image-wrapper {
        height: 100%;
        min-height: 520px;
    }

    .st-main-img {
        width: 100%;
        height: 520px;
        object-fit: cover;
    }

    .st-image-overlay p {
        max-width: 85%;
        margin: auto;
        line-height: 1.8;
        opacity: .95;
    }

    .nav-tabs {
        border: none;
    }

        .nav-tabs .nav-link {
            border: none;
            font-weight: 600;
            color: #666;
        }

    .nav-tabs .nav-link.active {
                color: #0d6efd;
                border-bottom: 3px solid #0d6efd;
            }

    /* Section color accents - only layout / accent changes, preserve existing hover effects */
    .st-blue-section .st-panel {
        border-left: 6px solid #0d6efd; /* blue accent for image area */
        background: linear-gradient(180deg, #f0f7ff, #ffffff);
    }

    /* Keep overlay behavior unchanged; the blue accent is on the panel border only */

    .st-red-section .st-panel {
        border-left: 6px solid #ff4d4f; /* red accent for like / rate area */
        background: linear-gradient(180deg, #fff5f5, #ffffff);
    }

    .st-red-section .st-stat-card {
        border-color: rgba(255,77,79,0.12);
    }

    .st-red-section .icon-heart, .st-red-section .icon-star {
        color: #ff4d4f; /* emphasize like/rate icons */
    }

    .st-green-section .st-panel {
        border-top: 6px solid #2ed573; /* green accent for comments & chapters */
        background: linear-gradient(180deg, #f6fff6, #ffffff);
    }

    /* Small responsive tweak so accents don't create overflow on mobile */
    @@media (max-width: 991px) {
        .st-blue-section .st-panel,
        .st-red-section .st-panel,
        .st-green-section .st-panel { border-left: none; border-top: 4px solid transparent; }
        .st-green-section .st-panel { border-top-color: #2ed573; }
    }
</style>
