@* MODAL CRUD CATEGORY SONG NGỮ *@
<div id="modalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[99] transition-all duration-500">
    <div id="modalContent" class="bg-white w-full max-w-4xl rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-20 opacity-0 transition-all duration-500 ease-out">
        <div class="p-8 border-b border-gray-50 relative mx-5 mt-0 mb-0 bg-gradient-to-r from-gray-50 to-white">
            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center">
                <h3 id="modalTitle" class="text-xl font-extrabold text-cus">@SharedLocalizer["AdminCategories_CategoryName"]</h3>
                <p class="text-xs text-gray-400 mt-1">@SharedLocalizer["AdminCommon_FillAllInfo"]</p>
            </div>

            <button onclick="closeModal()"
                    class="absolute right-6 top-6 w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-red-50 hover:text-red-500 transition-all text-2xl">
                &times;
            </button>
        </div>

        <form id="userForm" class="p-8 space-y-6 max-h-[70vh] overflow-y-auto">
            <input type="hidden" name="CategoryId" id="categoryId">

            <!-- Thanh trạng thái & Nút mở panel dịch -->
            <div class="flex items-center justify-between p-3.5 bg-indigo-50/70 border border-indigo-200 rounded-2xl shadow-sm">
                <div class="text-xs font-bold text-indigo-900 flex items-center gap-2" id="currentLangModeText">
                    <span id="currentLangFlag">🇺🇸</span>
                    <span id="currentLangTitleDesc">Bản nhập chính: <strong>Tiếng Anh</strong></span>
                </div>
                <button type="button" id="btnToggleTranslatePanel" onclick="toggleTranslationPanel()"
                        class="px-4 py-2 bg-gradient-to-r from-teal-500 to-cyan-500 text-white rounded-xl text-xs font-bold shadow-md hover:shadow-teal-200/50 hover:opacity-95 active:scale-95 transition-all flex items-center gap-2">
                    <i class="fas fa-language text-sm"></i> <span id="btnToggleTranslateLabel">Thêm / Sửa Tiếng Việt 🇻🇳</span>
                </button>
            </div>

            <!-- KHỐI 1: Ô NHẬP LIỆU CHÍNH -->
            <div class="space-y-4">
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1" id="lblTitlePrimary">@SharedLocalizer["AdminCategories_CategoryName"] <span class="text-red-500">*</span></label>
                    <input type="text" id="primaryName"
                           class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all text-sm font-medium"
                           placeholder="@SharedLocalizer["AdminCategories_NamePlaceholder"]" required>
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1" id="lblDescPrimary">@SharedLocalizer["AdminCategories_Description"]</label>
                    <textarea id="primaryDesc" rows="3"
                              class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all text-sm"
                              placeholder="@SharedLocalizer["AdminCategories_DescriptionPlaceholder"]"></textarea>
                </div>
            </div>

            <!-- KHỐI 2: KHUNG ĐỐI CHIẾU & BẢN DỊCH PHỤ -->
            <div id="secondaryLangPanel" class="hidden p-5 bg-teal-50/40 border border-teal-200 rounded-2xl space-y-4 transition-all duration-300">
                <div class="flex items-center justify-between pb-2 border-b border-teal-100">
                    <div class="space-y-0.5">
                        <span class="text-xs font-bold text-teal-900 flex items-center gap-1.5" id="secondaryPanelHeader">
                            <i class="fas fa-layer-group text-teal-600"></i> Bản dịch song song
                        </span>
                        <p class="text-[11px] text-teal-700" id="secondaryPanelNotice">
                            * Dịch sang ngôn ngữ phụ để hỗ trợ giao diện song ngữ.
                        </p>
                    </div>

                    <button type="button" id="btnAiTranslate" onclick="translateCurrentViaAi()"
                            class="px-3.5 py-2 bg-gradient-to-r from-amber-500 to-amber-600 text-white text-xs font-bold rounded-xl shadow-md hover:from-amber-600 hover:to-amber-700 active:scale-95 transition-all flex items-center gap-1.5">
                        <i class="fas fa-wand-magic-sparkles text-amber-200"></i> <span id="btnAiTranslateLabel">Dịch tự động bằng AI</span>
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Ô Tham khảo (Read-only) -->
                    <div class="space-y-3 bg-gray-100/80 p-3.5 rounded-xl border border-gray-200">
                        <div class="text-[10px] font-extrabold text-gray-500 uppercase tracking-wider flex items-center gap-1" id="lblRefBoxTitle">
                            <i class="fas fa-eye text-gray-400"></i> Bản gốc đối chiếu (Tham khảo)
                        </div>
                        <div>
                            <label class="text-[10px] text-gray-500 font-semibold" id="lblRefName">Tên thể loại gốc</label>
                            <input type="text" id="refName" readonly
                                   class="w-full px-3 py-2 bg-gray-200/90 text-gray-700 font-semibold rounded-lg text-xs outline-none cursor-not-allowed">
                        </div>
                        <div>
                            <label class="text-[10px] text-gray-500 font-semibold" id="lblRefDesc">Mô tả gốc</label>
                            <textarea id="refDesc" rows="3" readonly
                                      class="w-full px-3 py-2 bg-gray-200/90 text-gray-600 text-xs rounded-lg outline-none cursor-not-allowed"></textarea>
                        </div>
                    </div>

                    <!-- Ô Nhập bản dịch -->
                    <div class="space-y-3 bg-white p-3.5 rounded-xl border border-teal-300 shadow-sm">
                        <div class="text-[10px] font-extrabold text-teal-700 uppercase tracking-wider flex items-center gap-1" id="lblTargetHeader">
                            <i class="fas fa-pen text-teal-500"></i> Nhập bản dịch
                        </div>
                        <div>
                            <label class="text-[10px] text-gray-600 font-semibold" id="lblTargetName">Tên thể loại dịch</label>
                            <input type="text" id="targetName"
                                   class="w-full px-3 py-2 bg-gray-50 border border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-200 rounded-lg text-xs outline-none transition-all font-medium">
                        </div>
                        <div>
                            <label class="text-[10px] text-gray-600 font-semibold" id="lblTargetDesc">Mô tả dịch</label>
                            <textarea id="targetDesc" rows="3"
                                      class="w-full px-3 py-2 bg-gray-50 border border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-200 rounded-lg text-xs outline-none transition-all"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Trạng thái -->
            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminCommon_Status"]</label>
                <select name="Status" id="categoryStatus"
                        class="select2-custom w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all">
                    <option data-color="linear-gradient(135deg, #93F9B9, #1D976C)" value="Active">@SharedLocalizer["AdminCommon_Active"]</option>
                    <option data-color="linear-gradient(135deg, #F45C43, #EB3349)" value="Inactive">@SharedLocalizer["AdminCommon_Inactive"]</option>
                </select>
            </div>

            <div class="pt-6 flex gap-4">
                <button type="button" onclick="closeModal()"
                        class="flex-1 py-3 btn-grad-cancel text-white rounded-xl font-bold shadow-lg hover:shadow-indigo-200/50 active:scale-95 transition-all duration-300">
                    @SharedLocalizer["AdminCommon_Cancel"]
                </button>

                <button type="submit" id="btnSave"
                        class="flex-1 py-3 btn-grad text-white rounded-xl font-bold shadow-lg hover:shadow-indigo-200/50 active:scale-95 transition-all duration-300">
                    @SharedLocalizer["AdminCommon_SaveChanges"]
                </button>
            </div>
        </form>
    </div>
</div>
<!-- MODAL IMPORT EXCEL ĐỒNG BỘ CHO CHAPTER -->
<div id="importModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm transition-all duration-300">
    <div id="importContent" class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl transform scale-95 opacity-0 transition-all duration-300">
        <div class="p-8">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-bold text-cus">
                    @(SharedLocalizer["AdminAuthors_ImportHeading"]?.Value ?? SharedLocalizer["Btn_Import"].Value + " Chapter")
                </h3>
                <button type="button" onclick="closeImportModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <!-- Vùng kéo thả file -->
            <div id="dropZone" class="relative border-2 border-dashed border-indigo-200 rounded-2xl p-10 flex flex-col items-center justify-center bg-indigo-50/30 hover:bg-indigo-50 hover:border-indigo-400 transition-all cursor-pointer group">
                <input type="file" id="excelFile" accept=".xlsx, .xls" class="absolute inset-0 opacity-0 cursor-pointer">
                
                <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i class="fas fa-file-excel text-green-500 text-3xl"></i>
                </div>
                
                <p class="text-gray-600 font-semibold text-center" id="fileStatus">
                    @SharedLocalizer["AdminCommon_DropOrClickImport"]
                </p>
                <p class="text-xs text-gray-400 mt-2">
                    @SharedLocalizer["AdminCommon_SupportedFormats"]
                </p>
            </div>

            <!-- Link tải file mẫu Chapter -->
            <div class="mt-4 flex items-center justify-between px-2">
                <a href="/assets/template/Chapter_Template.xlsx" download class="text-sm text-cus text-indigo-600 font-medium hover:underline flex items-center gap-2">
                    <i class="fas fa-download text-xs"></i> @SharedLocalizer["AdminCommon_DownloadTemplate"]
                </a>
            </div>

            <!-- Nút hành động -->
            <div class="flex gap-4 mt-8">
                <button type="button" onclick="closeImportModal()" class="flex-1 py-3 btn-grad-cancel font-bold text-white rounded-xl shadow-md active:scale-95 transition-all">
                    @SharedLocalizer["AdminCommon_Cancel"]
                </button>
                <button type="button" id="btnDoImport" onclick="executeImport()" class="flex-1 py-3 btn-grad rounded-xl font-bold text-white shadow-lg active:scale-95 transition-all">
                    @SharedLocalizer["AdminCommon_ConfirmImport"]
                </button>
            </div>
        </div>
    </div>
</div>