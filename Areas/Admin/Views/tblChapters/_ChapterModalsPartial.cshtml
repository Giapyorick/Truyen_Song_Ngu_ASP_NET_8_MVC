@* MODAL CRUD CHAPTER SONG NGỮ *@
<div id="modalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[99] transition-all duration-500">
    <div id="modalContent" class="bg-white w-full max-w-3xl rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-20 opacity-0 transition-all duration-500 ease-out">

        <!-- Header -->
        <div class="p-8 border-b border-gray-50 relative mx-5 mt-0 mb-0 bg-gradient-to-r from-gray-50 to-white">
            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center">
                <h3 id="modalTitle" class="text-xl font-extrabold text-cus">@SharedLocalizer["AdminChapters_ChapterDetails"]</h3>
                <p class="text-xs text-gray-400 mt-1">@SharedLocalizer["AdminCommon_FillChapterInfo"]</p>
            </div>

            <button onclick="closeModal()" type="button"
                    class="absolute right-6 top-6 w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-red-50 hover:text-red-500 transition-all text-2xl">
                &times;
            </button>
        </div>

        <!-- Form -->
        <form id="chapterForm" class="p-8 space-y-5 max-h-[75vh] overflow-y-auto">
            <input type="hidden" name="ChapterId" id="chapterId" value="0">

            <!-- Thanh trạng thái & Nút mở panel dịch -->
            <div class="flex items-center justify-between p-3.5 bg-indigo-50/70 border border-indigo-200 rounded-2xl shadow-sm">
                <div class="text-xs font-bold text-indigo-900 flex items-center gap-2" id="currentLangModeText">
                    <span id="currentLangFlag">🇺🇸</span>
                    <span id="currentLangTitleDesc">Bản nhập chính: <strong>Tiếng Anh</strong></span>
                </div>
                <button type="button" id="btnToggleTranslatePanel" onclick="toggleTranslationPanel()"
                        class="px-4 py-2 bg-gradient-to-r from-teal-500 to-cyan-500 text-white rounded-xl text-xs font-bold shadow-md hover:shadow-teal-200/50 hover:opacity-95 active:scale-95 transition-all flex items-center gap-2">
                    <i class="fas fa-language text-sm"></i> <span id="btnToggleTranslateLabel">Thêm / Sửa Tiếng Việt 🇻🇳</span>
                </button>
            </div>

            <!-- Thuộc về truyện & Số thứ tự chương -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminChapters_AssignedStory"] <span class="text-red-500">*</span></label>
                    <select name="StoryId" id="chapterStoryId"
                            class="select2-custom w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-300 rounded-xl outline-none transition-all" required>
                    </select>
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminChapters_ChapterNumber"] <span class="text-red-500">*</span></label>
                    <input type="number" name="ChapterNumber" id="chapterChapterNumber" min="1" step="1"
                           class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-300 focus:bg-white rounded-xl outline-none transition-all text-sm font-medium"
                           placeholder="@SharedLocalizer["AdminChapters_NumberPlaceholder"]" required>
                </div>
            </div>

            <!-- Tiêu đề chương chính -->
            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase ml-1" id="lblTitlePrimary">Tiêu đề chương <span class="text-red-500">*</span></label>
                <input type="text" id="primaryTitle"
                       class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-300 focus:bg-white rounded-xl outline-none transition-all text-sm font-medium"
                       placeholder="Enter chapter title..." required autocomplete="off">
            </div>

            <!-- Panel dịch song ngữ phụ & AI Translate -->
            <div id="secondaryLangPanel" class="hidden p-5 bg-teal-50/40 border border-teal-200 rounded-2xl space-y-4 transition-all duration-300">
                <div class="flex items-center justify-between pb-2 border-b border-teal-100">
                    <div class="space-y-0.5">
                        <span class="text-xs font-bold text-teal-900 flex items-center gap-1.5" id="secondaryPanelHeader">
                            <i class="fas fa-layer-group text-teal-600"></i> Bản dịch song song
                        </span>
                        <p class="text-[11px] text-teal-700" id="secondaryPanelNotice">
                            * Dịch tiêu đề chương sang ngôn ngữ phụ để hỗ trợ độc giả song ngữ.
                        </p>
                    </div>

                    <button type="button" id="btnAiTranslate" onclick="translateCurrentViaAi()"
                            class="px-3.5 py-2 bg-gradient-to-r from-amber-500 to-amber-600 text-white text-xs font-bold rounded-xl shadow-md hover:from-amber-600 hover:to-amber-700 active:scale-95 transition-all flex items-center gap-1.5">
                        <i class="fas fa-wand-magic-sparkles text-amber-200"></i> <span id="btnAiTranslateLabel">Dịch tự động bằng AI</span>
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Ô Đối chiếu gốc (Read-only) -->
                    <div class="space-y-2 bg-gray-100/80 p-3.5 rounded-xl border border-gray-200">
                        <div class="text-[10px] font-extrabold text-gray-500 uppercase tracking-wider flex items-center gap-1" id="lblRefBoxTitle">
                            <i class="fas fa-eye text-gray-400"></i> Bản gốc đối chiếu
                        </div>
                        <input type="text" id="refTitle" readonly
                               class="w-full px-3 py-2 bg-gray-200/90 text-gray-700 font-semibold rounded-lg text-xs outline-none cursor-not-allowed">
                    </div>

                    <!-- Ô Nhập bản dịch -->
                    <div class="space-y-2 bg-white p-3.5 rounded-xl border border-teal-300 shadow-sm">
                        <div class="text-[10px] font-extrabold text-teal-700 uppercase tracking-wider flex items-center gap-1" id="lblTargetHeader">
                            <i class="fas fa-pen text-teal-500"></i> Nhập bản dịch
                        </div>
                        <input type="text" id="targetTitle"
                               class="w-full px-3 py-2 bg-gray-50 border border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-200 rounded-lg text-xs outline-none transition-all font-medium"
                               placeholder="Nhập tiêu đề chương dịch...">
                    </div>
                </div>
            </div>

            <!-- Nút hành động -->
            <div class="pt-6 flex gap-4">
                <button type="button" onclick="closeModal()"
                        class="flex-1 py-3 btn-grad-cancel text-white rounded-xl font-bold shadow-lg hover:shadow-red-200/50 active:scale-95 transition-all duration-300">
                    @SharedLocalizer["AdminCommon_Cancel"]
                </button>

                <button type="submit" id="btnSave"
                        class="flex-1 py-3 btn-grad text-white rounded-xl font-bold shadow-lg hover:shadow-teal-200/50 active:scale-95 transition-all duration-300">
                    @SharedLocalizer["AdminCommon_SaveChanges"]
                </button>
            </div>
        </form>
    </div>
</div>

@* MODAL IMPORT EXCEL *@
<div id="importModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm transition-all duration-300">
    <div id="importContent" class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl transform scale-95 opacity-0 transition-all duration-300">
        <div class="p-8">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-bold text-cus">@SharedLocalizer["AdminCommon_ImportFromExcel"]</h3>
                <button onclick="closeImportModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <div id="dropZone" class="relative border-2 border-dashed border-indigo-200 rounded-2xl p-10 flex flex-col items-center justify-center bg-indigo-50/30 hover:bg-indigo-50 hover:border-indigo-400 transition-all cursor-pointer group">
                <input type="file" id="excelFile" accept=".xlsx, .xls" class="absolute inset-0 opacity-0 cursor-pointer">

                <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i class="fas fa-file-excel text-green-500 text-3xl"></i>
                </div>

                <p class="text-gray-600 font-semibold" id="fileStatus">@SharedLocalizer["AdminCommon_DropOrClickImport"]</p>
                <p class="text-xs text-gray-400 mt-2">@SharedLocalizer["AdminCommon_SupportedFormats"]</p>
            </div>

            <div class="mt-4 flex items-center justify-between px-2">
                <a href="/assets/template/Chapter_Template.xlsx" class="text-sm text-cus text-indigo-600 font-medium hover:underline flex items-center gap-2">
                    <i class="fas fa-download text-xs"></i> @SharedLocalizer["AdminCommon_DownloadTemplate"]
                </a>
            </div>

            <div class="flex gap-4 mt-8">
                <button onclick="closeImportModal()" class="flex-1 py-3 btn-grad-cancel font-bold hover:bg-gray-50 rounded-xl transition-all">
                    @SharedLocalizer["AdminCommon_Cancel"]
                </button>
                <button id="btnDoImport" onclick="executeImport()" class="flex-1 py-3 bg-indigo-600 btn-grad rounded-xl font-bold shadow-lg hover:bg-indigo-700 active:scale-95 transition-all disabled:opacity-50 disabled:pointer-events-none">
                    @SharedLocalizer["AdminCommon_ConfirmImport"]
                </button>
            </div>
        </div>
    </div>
</div>

@* MODAL SHOW IMAGE *@
<div id="imageModal" class="fixed inset-0 bg-black/70 hidden items-center justify-center z-[999]">
    <img id="imageModalContent" class="max-w-[90%] max-h-[90%] rounded-2xl shadow-2xl" />
    <button onclick="closeImagePreview()" class="absolute top-5 right-5 text-white text-3xl hover:text-red-400">
        &times;
    </button>
</div>