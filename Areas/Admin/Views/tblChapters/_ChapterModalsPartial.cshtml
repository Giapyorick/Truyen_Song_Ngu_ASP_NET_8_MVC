@* MODAL CRUD CHAPTER *@
<div id="modalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[99] transition-all duration-500">
    <div id="modalContent" class="bg-white w-full max-w-2xl rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-20 opacity-0 transition-all duration-500 ease-out">
        
        <!-- Modal Header -->
        <div class="p-8 border-b border-gray-50 relative mx-5 mt-0 mb-0 bg-gradient-to-r from-gray-50 to-white">
            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center">
                <h3 id="modalTitle" class="text-xl font-extrabold text-cus">Chapter Details</h3>
                <p class="text-xs text-gray-400 mt-1">Please fill in all chapter information</p>
            </div>

            <button onclick="closeModal()" type="button"
                    class="absolute right-6 top-6 w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-red-50 hover:text-red-500 transition-all text-2xl">
                &times;
            </button>
        </div>

        <!-- Modal Form -->
        <form id="chapterForm" class="p-8 space-y-5 max-h-[75vh] overflow-y-auto">
            <input type="hidden" name="ChapterId" id="chapterId" value="0">

            <!-- Row 1: Chapter Title (Full Width) -->
            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase ml-1">Chapter Title *</label>
                <input type="text" name="Title" id="chapterTitle"
                       class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-300 focus:bg-white rounded-xl outline-none transition-all text-sm"
                       placeholder="e.g. Chapter 1: The Beginning" required autocomplete="off">
            </div>

            <!-- Row 2: Story Select & Chapter Number (Balanced 2 Columns) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">Assigned Story *</label>
                    <select name="StoryId" id="chapterStoryId"
                            class="select2-custom w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-300 rounded-xl outline-none transition-all" required>
                    </select>
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">Chapter Number *</label>
                    <input type="number" name="ChapterNumber" id="chapterChapterNumber" min="1" step="1"
                           class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-teal-300 focus:bg-white rounded-xl outline-none transition-all text-sm" 
                           placeholder="e.g. 1" required>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-6 flex gap-4">
                <button type="button" onclick="closeModal()"
                        class="flex-1 py-3 btn-grad-cancel text-white rounded-xl font-bold shadow-lg hover:shadow-red-200/50 active:scale-95 transition-all duration-300">
                    Cancel
                </button>

                <button type="submit" id="btnSave"
                        class="flex-1 py-3 btn-grad text-white rounded-xl font-bold shadow-lg hover:shadow-teal-200/50 active:scale-95 transition-all duration-300">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@* MODAL IMPORT EXCEL *@
<div id="importModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm transition-all duration-300">
    <div id="importContent" class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl transform scale-95 opacity-0 transition-all duration-300">
        <div class="p-8">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-bold text-cus">Import từ Excel</h3>
                <button onclick="closeImportModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <div id="dropZone" class="relative border-2 border-dashed border-indigo-200 rounded-2xl p-10 flex flex-col items-center justify-center bg-indigo-50/30 hover:bg-indigo-50 hover:border-indigo-400 transition-all cursor-pointer group">
                <input type="file" id="excelFile" accept=".xlsx, .xls" class="absolute inset-0 opacity-0 cursor-pointer">

                <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i class="fas fa-file-excel text-green-500 text-3xl"></i>
                </div>

                <p class="text-gray-600 font-semibold" id="fileStatus">Kéo thả file vào đây hoặc click để chọn</p>
                <p class="text-xs text-gray-400 mt-2">Hỗ trợ định dạng .xlsx, .xls (Tối đa 5MB)</p>
            </div>

            <div class="mt-4 flex items-center justify-between px-2">
                <a href="/assets/template/Chapter_Template.xlsx" class="text-sm text-cus text-indigo-600 font-medium hover:underline flex items-center gap-2">
                    <i class="fas fa-download text-xs"></i> Tải file mẫu tại đây
                </a>
            </div>

            <div class="flex gap-4 mt-8">
                <button onclick="closeImportModal()" class="flex-1 py-3 btn-grad-cancel font-bold hover:bg-gray-50 rounded-xl transition-all">
                    Hủy bỏ
                </button>
                <button id="btnDoImport" onclick="executeImport()" class="flex-1 py-3 bg-indigo-600 btn-grad rounded-xl font-bold shadow-lg hover:bg-indigo-700 active:scale-95 transition-all disabled:opacity-50 disabled:pointer-events-none">
                    Xác nhận Import
                </button>
            </div>
        </div>
    </div>
</div>

@* MODAL SHOW IMAGE *@
<div id="imageModal" class="fixed inset-0 bg-black/70 hidden items-center justify-center z-[999]">
    <img id="imageModalContent" class="max-w-[90%] max-h-[90%] rounded-2xl shadow-2xl" />
    <button onclick="closeImagePreview()" class="absolute top-5 right-5 text-white text-3xl hover:text-red-400">
        &times;
    </button>
</div>