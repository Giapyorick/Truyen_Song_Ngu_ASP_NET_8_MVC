@using Microsoft.Extensions.Localization
@using WebTruyenTranh
@inject IStringLocalizer<SharedResource> SharedLocalizer

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- CSS Thư viện & Custom CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/admin/tblChapters/chapters-management.css" asp-append-version="true" />

<main class="flex-1 flex flex-col overflow-y-auto">
    <div class="space-y-10 m-10">
        <div class="flex flex-col items-center gap-4">
            <h2 class="text-2xl font-bold text-cus tracking-tight">
                @SharedLocalizer["Chapter_PageTitle"]
            </h2>
        </div>

        <div class="bg-white rounded-[2rem] shadow-xl shadow-gray-200/50 border border-gray-100 overflow-hidden">
            <!-- Thanh tìm kiếm, lọc và các nút thao tác -->
            <div class="p-6 border-b border-gray-50 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="relative w-40 sm:w-64">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                    <input type="text" id="filterSearch" placeholder="@SharedLocalizer["Chapter_SearchPlaceholder"]" 
                           class="w-full pl-11 pr-4 py-2.5 bg-gray-200 border border-transparent focus:border-purple-300 focus:bg-white rounded-xl outline-none transition-all text-sm">
                </div>

                <div class="w-80">
                    <select id="filterStory" class="select2-custom w-full mt-1 p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none shadow-sm">
                        <option data-color="linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%)" value="all">@SharedLocalizer["Chapter_FilterAllStories"]</option>
                    </select>
                </div>

                <div class="flex items-center gap-4">
                    <button onclick="exportExcel()" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300">
                        <i class="fas fa-file-export mr-2"></i>@SharedLocalizer["Btn_Export"]
                    </button>
                    <button onclick="openImportModal()" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300">
                        <i class="fas fa-file-import mr-2"></i>@SharedLocalizer["Btn_Import"]
                    </button>
                    <button id="btnDeleteSelected" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300">
                        <i class="fas fa-trash-alt mr-2"></i>@SharedLocalizer["Admin_BtnDeleteText"]
                    </button>
                    <button onclick="openModal('add')" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300">
                        <i class="fas fa-plus-circle mr-2"></i> @SharedLocalizer["Admin_BtnAdd"]
                    </button>
                </div>
            </div>

            <!-- Bảng hiển thị danh sách chương -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/50 text-gray-400 text-[11px] uppercase tracking-[0.15em] border-b border-gray-100">
                            <th class="px-6 py-4 w-10">
                                <div class="flex items-center justify-center">
                                    <input type="checkbox" id="selectAll" class="w-5 h-5 rounded-md border-gray-300 text-purple-600 focus:ring-purple-500 cursor-pointer transition-all">
                                </div>
                            </th>
                            <th class="px-4 py-4 text-gray font-bold text-left">@SharedLocalizer["Chapter_ColInfo"]</th>
                            <th class="px-6 py-4 text-gray font-bold text-left">@SharedLocalizer["Chapter_ColCreateDate"]</th>
                            <th class="px-6 py-4 text-gray font-bold text-left">@SharedLocalizer["Chapter_ColNumber"]</th>
                            <th class="px-8 py-4 text-gray font-bold text-right">@SharedLocalizer["Admin_ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody id="user-list-body" class="divide-y divide-gray-50"></tbody>
                </table>
            </div>

            <!-- Khung phân trang -->
            <div id="pagination-container" class="flex justify-center items-center gap-2 py-4"></div>
        </div>
    </div>
</main>

<!-- Nhúng Partial View chứa các Modal -->
@await Html.PartialAsync("_ChapterModalsPartial")
<style>
    .select2-container--open {
        z-index: 999999999 !important;
    }

    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        border: 2px solid #edf2f7 !important;
        border-radius: 12px !important;
        height: 50px !important;
        min-height: 50px !important;
        display: flex !important;
        align-items: center !important;
        background-color: #ffffff !important;
        transition: all 0.3s ease !important;
        outline: none !important;
    }

        .select2-container--default .select2-selection--single:focus,
        .select2-container--default.select2-container--open .select2-selection--single {
            border-color: #764ba2 !important;
            box-shadow: 0 0 0 4px rgba(118, 75, 162, 0.12) !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: normal !important;
            padding-left: 15px !important;
            font-size: 14px !important;
            font-weight: 600 !important;
            color: #374151 !important;
            display: flex !important;
            align-items: center !important;
            width: 100% !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 48px !important;
            right: 12px !important;
            display: flex !important;
            align-items: center !important;
        }

    .status-dot {
        height: 10px;
        width: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 10px;
        flex-shrink: 0;
    }

    .select2-dropdown {
        border: 1px solid #edf2f7 !important;
        border-radius: 12px !important;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1) !important;
        overflow: hidden !important;
        background-color: #ffffff !important;
    }

    .select2-results__option {
        padding: 10px 15px !important;
        font-size: 13.5px !important;
        font-weight: 500 !important;
        color: #4b5563 !important;
        transition: all 0.2s ease !important;
    }

    .select2-results__option--highlighted[aria-selected] {
        background-color: #f3f0ff !important;
        color: #764ba2 !important;
        font-weight: 700 !important;
    }

    .select2-container--default .select2-results__option[aria-selected="true"] {
        background-color: #faf5ff !important;
        color: #6b21a8 !important;
        font-weight: 700 !important;
    }
</style>

@section Scripts {
    <!-- Thư viện phụ trợ -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <!-- Inject từ điển ngôn ngữ cho Chapter JS Module an toàn bằng Json.Serialize -->
    <script>


        window.ADMIN_LANG = Object.assign(window.ADMIN_LANG || {}, {
            TitleAddChapter: @Json.Serialize(SharedLocalizer["Chapter_TitleAdd"].Value),
            TitleEditChapter: @Json.Serialize(SharedLocalizer["Chapter_TitleEdit"].Value),
            NotFoundChapters: @Json.Serialize(SharedLocalizer["Chapter_NotFound"].Value),
            ErrLoadChapters: @Json.Serialize(SharedLocalizer["Chapter_ErrLoad"].Value),
            SelectStoryPlaceholder: @Json.Serialize(SharedLocalizer["Chapter_SelectStory"].Value),
            FilterAllStories: @Json.Serialize(SharedLocalizer["Chapter_FilterAllStories"].Value),
            ReqChapterTitle: @Json.Serialize(SharedLocalizer["Chapter_ReqTitle"].Value),
            ReqSourceBeforeTranslate: @Json.Serialize(SharedLocalizer["Category_ReqSourceBeforeTranslate"].Value),
            AiTranslatingStatus: @Json.Serialize(SharedLocalizer["Category_AiTranslatingStatus"].Value),
            AiTranslateCompleted: @Json.Serialize(SharedLocalizer["Category_AiTranslateCompleted"].Value),
            BtnAiTranslating: @Json.Serialize(SharedLocalizer["Category_BtnAiTranslating"].Value),
            BtnAiTranslateDefault: @Json.Serialize(SharedLocalizer["Category_BtnAiTranslateDefault"].Value),
            ConfirmDeleteSingleChapterTitle: @Json.Serialize(SharedLocalizer["Chapter_ConfirmDeleteTitle"].Value),
            ConfirmDeleteSingleChapterMsg: @Json.Serialize(SharedLocalizer["Chapter_ConfirmDeleteMsg"].Value),
            ConfirmDeleteMultiChaptersTitle: @Json.Serialize(SharedLocalizer["Chapter_ConfirmDeleteMultiTitle"].Value),
            ConfirmDeleteMultiChaptersMsg: @Json.Serialize(SharedLocalizer["Chapter_ConfirmDeleteMultiMsg"].Value),
            BlockedDeleteChapter: @Json.Serialize(SharedLocalizer["Chapter_BlockedDelete"].Value),
            DeletedChaptersSuccess: @Json.Serialize(SharedLocalizer["Chapter_DeletedSuccess"].Value),
            SelectAtLeastOneChapter: @Json.Serialize(SharedLocalizer["Chapter_SelectAtLeastOne"].Value),
            ActionCannotUndo: @Json.Serialize(SharedLocalizer["Admin_ActionCannotUndo"].Value),
            Processing: @Json.Serialize(SharedLocalizer["Admin_Processing"].Value),
            SaveChanges: @Json.Serialize(SharedLocalizer["Admin_SaveChanges"].Value),
            BtnDeleteText: @Json.Serialize(SharedLocalizer["Admin_BtnDeleteText"].Value),
            ErrConnectDelete: @Json.Serialize(SharedLocalizer["Admin_ErrConnectDelete"].Value),
            ErrConnectServer: @Json.Serialize(SharedLocalizer["Admin_ErrConnectServer"].Value)
                });
    </script>

    <!-- JS Module đã tách -->
    <script src="~/js/admin/tblChapters/chapters-ui.js" asp-append-version="true"></script>
    <script src="~/js/admin/tblChapters/chapters-crud.js" asp-append-version="true"></script>
}