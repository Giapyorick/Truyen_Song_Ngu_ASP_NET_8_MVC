@using Microsoft.Extensions.Localization
@using WebTruyenTranh
@inject IStringLocalizer<SharedResource> SharedLocalizer

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- CSS Thư viện & Custom CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/admin/tblCategories/categories-management.css" asp-append-version="true" />

<main class="flex-1 flex flex-col overflow-y-auto">
    <div class="space-y-10 m-10">
        <div class="flex flex-col items-center gap-4">
            <h2 class="text-2xl font-bold text-cus tracking-tight">
                @SharedLocalizer["Admin_PageTitle"]
            </h2>
        </div>

        <div class="bg-white rounded-[2rem] shadow-xl shadow-gray-200/50 border border-gray-100 overflow-hidden">
            <!-- Thanh tìm kiếm, lọc vai trò, trạng thái và các nút thao tác -->
            <div class="p-6 border-b border-gray-50 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="relative w-40 sm:w-64">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                    <input type="text" id="filterSearch" placeholder="@SharedLocalizer["Admin_SearchPlaceholder"]" 
                           class="w-full pl-11 pr-4 py-2.5 bg-gray-200 border border-transparent focus:border-purple-300 focus:bg-white rounded-xl outline-none transition-all text-sm">
                </div>

                <!-- Lọc Role (Admin / Viewer) -->
                <div class="w-40">
                    <select id="filterRole" class="select2-custom w-full mt-1 p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none shadow-sm">
                        <option data-color="linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%)" value="all" selected>@SharedLocalizer["Admin_FilterAllRoles"]</option>
                        <option data-color="linear-gradient(135deg, #0250c5 0%, #d43f8d 100%)" value="Admin">@SharedLocalizer["AdminCommon_AdminRole"]</option>
                        <option data-color="linear-gradient(135deg, #FF8008, #FFC837)" value="Viewer" >@SharedLocalizer["AdminCommon_ViewerRole"]</option>
                    </select>
                </div>

                <!-- Lọc Trạng thái (Active / Inactive) -->
                <div class="w-40">
                    <select id="filterStatus" class="select2-custom w-full mt-1 p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none shadow-sm">
                        <option data-color="linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%)" value="all">@SharedLocalizer["Admin_FilterStatus"]</option>
                        <option data-color="linear-gradient(135deg, #93F9B9, #1D976C)" value="Active">@SharedLocalizer["Admin_StatusActive"]</option>
                        <option data-color="linear-gradient(135deg, #F45C43, #EB3349)" value="Inactive">@SharedLocalizer["Admin_StatusInactive"]</option>
                    </select>
                </div>

                <div class="flex items-center gap-4">
                    <button id="btnDeleteSelected" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300">
                        <i class="fas fa-trash-alt mr-2"></i>@SharedLocalizer["Admin_BtnDeleteText"]
                    </button>
                    <button onclick="openModal('add')" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300">
                        <i class="fas fa-plus-circle mr-2"></i>@SharedLocalizer["Admin_BtnAdd"]
                    </button>
                </div>
            </div>

            <!-- Bảng hiển thị danh sách Admins -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/50 text-gray-400 text-[11px] uppercase tracking-[0.15em] border-b border-gray-100">
                            <th class="px-6 py-4 w-10">
                                <div class="flex items-center justify-center">
                                    <input type="checkbox" id="selectAll" class="w-5 h-5 rounded-md border-gray-300 text-purple-600 focus:ring-purple-500 cursor-pointer transition-all">
                                </div>
                            </th>
                            <th class="px-4 py-4 text-gray font-bold">@SharedLocalizer["Admin_ColUserInfo"]</th>
                            <th class="px-6 py-4 text-gray font-bold text-center">@SharedLocalizer["Admin_ColRole"]</th>
                            <th class="px-6 py-4 text-gray font-bold text-center">@SharedLocalizer["Admin_ColStatus"]</th>
                            <th class="px-6 py-4 text-gray font-bold">@SharedLocalizer["Admin_ColLastLogin"]</th>
                            <th class="px-6 py-4 text-gray font-bold">@SharedLocalizer["Admin_ColCreatedAt"]</th>
                            <th class="px-8 py-4 text-gray font-bold text-right">@SharedLocalizer["Admin_ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody id="user-list-body" class="divide-y divide-gray-50"></tbody>
                </table>
            </div>

            <!-- Khung phân trang -->
            <div id="pagination-container" class="flex justify-center items-center gap-2 py-4"></div>
        </div>
    </div>
</main>

<!-- Nhúng Partial View chứa Modal Thêm / Sửa Admin -->
@await Html.PartialAsync("_AdminModalsPartial")

@section Scripts {
    <!-- Thư viện phụ trợ -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- Inject từ điển ngôn ngữ cho Admins JS Module an toàn bằng Json.Serialize -->
    <script>
        window.ADMIN_LANG = window.ADMIN_LANG || {};
        window.ADMIN_LANG.NotFoundAccounts = @Json.Serialize(SharedLocalizer["Admin_NotFoundAccounts"].Value);
        window.ADMIN_LANG.NoDisplayName = @Json.Serialize(SharedLocalizer["Admin_NoDisplayName"].Value);
        window.ADMIN_LANG.StatusActive = @Json.Serialize(SharedLocalizer["Admin_StatusActive"].Value);
        window.ADMIN_LANG.StatusInactive = @Json.Serialize(SharedLocalizer["Admin_StatusInactive"].Value);
        window.ADMIN_LANG.Never = @Json.Serialize(SharedLocalizer["Admin_Never"].Value);
        window.ADMIN_LANG.TitleEditAccount = @Json.Serialize(SharedLocalizer["Admin_TitleEditAccount"].Value);
        window.ADMIN_LANG.TitleDeleteAccount = @Json.Serialize(SharedLocalizer["Admin_TitleDeleteAccount"].Value);
        window.ADMIN_LANG.ErrLoadAccounts = @Json.Serialize(SharedLocalizer["Admin_ErrLoadAccounts"].Value);
        window.ADMIN_LANG.ErrConnectServerLoad = @Json.Serialize(SharedLocalizer["Admin_ErrConnectServerLoad"].Value);
        window.ADMIN_LANG.ViewerNoPermissionDelete = @Json.Serialize(SharedLocalizer["Admin_ViewerNoPermissionDelete"].Value);
        window.ADMIN_LANG.ViewerNoPermissionSave = @Json.Serialize(SharedLocalizer["Admin_ViewerNoPermissionSave"].Value);
        window.ADMIN_LANG.ViewerNoPermissionModal = @Json.Serialize(SharedLocalizer["Admin_ViewerNoPermissionModal"].Value);
        window.ADMIN_LANG.SelectAtLeastOne = @Json.Serialize(SharedLocalizer["Admin_SelectAtLeastOne"].Value);
        window.ADMIN_LANG.ErrConnectDelete = @Json.Serialize(SharedLocalizer["Admin_ErrConnectDelete"].Value);
        window.ADMIN_LANG.ErrConnectServer = @Json.Serialize(SharedLocalizer["Admin_ErrConnectServer"].Value);
        window.ADMIN_LANG.CannotFetchInfo = @Json.Serialize(SharedLocalizer["Admin_CannotFetchInfo"].Value);
        window.ADMIN_LANG.ConfirmDeleteSingleTitle = @Json.Serialize(SharedLocalizer["Admin_ConfirmDeleteSingleTitle"].Value);
        window.ADMIN_LANG.ConfirmDeleteSingleMsg = @Json.Serialize(SharedLocalizer["Admin_ConfirmDeleteSingleMsg"].Value);
        window.ADMIN_LANG.ConfirmDeleteMultiTitle = @Json.Serialize(SharedLocalizer["Admin_ConfirmDeleteMultiTitle"].Value);
        window.ADMIN_LANG.ConfirmDeleteMultiMsg = @Json.Serialize(SharedLocalizer["Admin_ConfirmDeleteMultiMsg"].Value);
        window.ADMIN_LANG.ActionCannotUndo = @Json.Serialize(SharedLocalizer["Admin_ActionCannotUndo"].Value);
        window.ADMIN_LANG.Processing = @Json.Serialize(SharedLocalizer["Admin_Processing"].Value);
        window.ADMIN_LANG.SaveChanges = @Json.Serialize(SharedLocalizer["Admin_SaveChanges"].Value);
        window.ADMIN_LANG.BtnDeleteText = @Json.Serialize(SharedLocalizer["Admin_BtnDeleteText"].Value);
        window.ADMIN_LANG.ModalTitleAdd = @Json.Serialize(SharedLocalizer["Admin_ModalTitleAdd"].Value);
        window.ADMIN_LANG.ModalTitleEdit = @Json.Serialize(SharedLocalizer["Admin_ModalTitleEdit"].Value);
        window.ADMIN_LANG.PwdNoticeAdd = @Json.Serialize(SharedLocalizer["Admin_PwdNoticeAdd"].Value);
        window.ADMIN_LANG.PwdNoticeEdit = @Json.Serialize(SharedLocalizer["Admin_PwdNoticeEdit"].Value);
    </script>

    <!-- JS Module đã tách -->
    <script src="~/js/admin/tblAdmins/admins-ui.js" asp-append-version="true"></script>
    <script src="~/js/admin/tblAdmins/admins-crud.js" asp-append-version="true"></script>
}