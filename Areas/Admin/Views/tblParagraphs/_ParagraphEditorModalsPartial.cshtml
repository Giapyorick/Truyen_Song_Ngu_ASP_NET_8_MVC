@* FULLSCREEN CHAPTER READER / EDITOR *@
<div id="chapterEditorModal" class="fixed inset-0 z-[9999] hidden bg-black/60 backdrop-blur-sm">
    <div class="chapter-editor-window">
        <header class="chapter-editor-header">
            <div class="chapter-editor-header-inner">
                <h1 id="editorStoryTitle" class="chapter-editor-story-title">@SharedLocalizer["AdminParagraphs_EditorLoadingStory"]</h1>
                <h2 id="editorChapterTitle" class="chapter-editor-chapter-title">@SharedLocalizer["AdminParagraphs_EditorLoadingChapter"]</h2>
                <div class="chapter-editor-meta">
                    <span><i class="fa-solid fa-file-lines"></i> <span id="chapterParagraphCount">@SharedLocalizer["AdminParagraphs_EditorParagraphCount"]</span></span>
                    <span><i class="fa-solid fa-location-dot"></i> <span id="chapterCurrentParagraph">#001</span></span>
                    <span id="chapterModifiedInfo" class="hidden"><i class="fa-solid fa-pen"></i> <span id="chapterModifiedCount">@SharedLocalizer["AdminParagraphs_EditorModifiedCount"]</span></span>
                </div>
            </div>
            <button type="button" onclick="closeChapterEditor()" class="chapter-editor-close" aria-label="@SharedLocalizer["AdminParagraphs_Close"]">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </header>

        <main class="chapter-editor-main">
            <section class="chapter-editor-reader-wrapper">
                <article id="chapterEditorParagraphList" class="chapter-editor-reader reading-content">
                    <div class="chapter-editor-loading">
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span>@SharedLocalizer["AdminParagraphs_LoadingChapterContent"]</span>
                    </div>
                </article>
            </section>

            <aside id="chapterEditorSidePanel" class="chapter-editor-side-panel hidden">
                <div class="chapter-editor-side-header">
                    <div class="chapter-editor-side-title">
                        <span class="text-2xl font-bold text-cus tracking-tight">@SharedLocalizer["AdminParagraphs_EditingParagraph"]</span>
                        <span id="sidePanelParagraphNumber" class="text-2xl font-bold text-cus tracking-tight">#001</span>
                    </div>
                    <button type="button" onclick="closeChapterSidePanel()" class="chapter-side-close" aria-label="@SharedLocalizer["AdminParagraphs_CloseEditor"]">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div id="chapterEditorSideContent" class="chapter-editor-side-content">
                    <div id="sideEditorFormWrapper" class="hidden space-y-4">
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase tracking-wider">@SharedLocalizer["AdminParagraphs_BlockType"]</label>
                            <select id="sidePanelBlockType" class="select2-custom w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-semibold focus:border-teal-500 outline-none transition">
                                <option data-color="linear-gradient(to right, #FF8008 0%, #FFC837 51%, #FF8008 100%)" value="0">@SharedLocalizer["AdminParagraphs_BlockChapterOpening"]</option>
                                <option data-color="linear-gradient(to right, #283048 0%, #859398 51%, #283048 100%)" value="1" selected>@SharedLocalizer["AdminParagraphs_BlockContinuousSentence"]</option>
                                <option data-color="linear-gradient(135deg, #4facfe, #00f2fe)" value="2">@SharedLocalizer["AdminParagraphs_BlockNewParagraph"]</option>
                                <option data-color="linear-gradient(to right, #DA22FF 0%, #9733EE 51%, #DA22FF 100%)" value="4">@SharedLocalizer["AdminParagraphs_BlockDialogue"]</option>
                            </select>
                        </div>

                        <div class="flex items-center justify-between pb-2 border-b border-gray-100">
                            <span class="text-xs text-gray-500">@SharedLocalizer["AdminParagraphs_Actions"]</span>
                            <div class="flex items-center flex-wrap gap-1.5">
                                <button type="button" onclick="handleMergeParagraph('prev')" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-indigo-50 text-indigo-700 hover:bg-indigo-600 hover:text-white border border-indigo-200 transition-all flex items-center gap-1" title="@SharedLocalizer["AdminParagraphs_MergePrevious"]">
                                    <i class="fa-solid fa-arrow-up-short-wide"></i> @SharedLocalizer["AdminParagraphs_MergePrevious"]
                                </button>
                                <button type="button" onclick="handleMergeParagraph('next')" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-indigo-50 text-indigo-700 hover:bg-indigo-600 hover:text-white border border-indigo-200 transition-all flex items-center gap-1" title="@SharedLocalizer["AdminParagraphs_MergeNext"]">
                                    <i class="fa-solid fa-arrow-down-wide-short"></i> @SharedLocalizer["AdminParagraphs_MergeNext"]
                                </button>
                                <button type="button" onclick="openAttachImageModal()" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-amber-50 text-amber-700 hover:bg-amber-600 hover:text-white border border-amber-200 transition-all flex items-center gap-1">
                                    <i class="fa-solid fa-image"></i> @SharedLocalizer["AdminParagraphs_Image"]
                                </button>
                                <button type="button" onclick="insertFromCurrentEditorIndex()" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-teal-50 text-teal-700 hover:bg-teal-600 hover:text-white border border-teal-200 transition-all flex items-center gap-1">
                                    <i class="fa-solid fa-plus"></i> @SharedLocalizer["AdminParagraphs_InsertAfter"]
                                </button>
                                <button type="button" onclick="deleteFromCurrentEditorIndex()" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-red-50 text-red-600 hover:bg-red-600 hover:text-white border border-red-200 transition-all flex items-center gap-1">
                                    <i class="fa-solid fa-trash-can"></i> @SharedLocalizer["AdminParagraphs_Delete"]
                                </button>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label class="text-[11px] font-bold text-cus uppercase tracking-wider">@SharedLocalizer["AdminParagraphs_EditorLanguage"]</label>
                            <div class="flex gap-1.5 border-b border-gray-200 pb-2 overflow-x-auto" id="sidePanelLangTabs"></div>
                        </div>

                        <div class="space-y-1">
                            <div class="flex justify-between items-center text-[10px] text-gray-400">
                                <span>@SharedLocalizer["AdminParagraphs_Editing"] <b id="sideCurrentLangLabel" class="text-cus uppercase">@SharedLocalizer["AdminParagraphs_English"]</b></span>
                                <span>@SharedLocalizer["AdminParagraphs_LiveReaderUpdate"]</span>
                            </div>
                            <div id="sideQuillEditorContainer" class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
                                <div id="sideQuillEditor" style="min-height: 140px; font-family: 'Lora', serif; font-size: 16px;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>
        </main>

        <footer class="chapter-editor-bottom-bar">
            <button type="button" onclick="previousChapterParagraph()" class="chapter-editor-nav-button">
                <i class="fa-solid fa-chevron-left"></i> <span>@SharedLocalizer["AdminParagraphs_Previous"]</span>
            </button>
            <div class="chapter-editor-counter"><span id="chapterParagraphCounter">0 / 0</span></div>
            <button type="button" onclick="nextChapterParagraph()" class="chapter-editor-nav-button">
                <span>@SharedLocalizer["AdminParagraphs_Next"]</span> <i class="fa-solid fa-chevron-right"></i>
            </button>
            <button type="button" id="chapterEditorSaveButton" class="btn-grad" disabled>
                <i class="fa-solid fa-save"></i> <span>@SharedLocalizer["AdminCommon_SaveChanges"]</span>
            </button>
        </footer>
    </div>
</div>

@* MODAL CHÈN ĐOẠN VĂN MỚI (INSERT AFTER) *@
<div id="insertParagraphModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-[10000] transition-all duration-300">
    <div id="insertModalContent" class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-300 flex flex-col max-h-[90vh]">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gradient-to-r from-teal-50/50 to-white">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-teal-500 text-white flex items-center justify-center font-bold">
                    <i class="fa-solid fa-plus text-xs"></i>
                </div>
                <div>
                    <h3 class="text-xl text-center font-bold text-cus">@SharedLocalizer["AdminParagraphs_InsertNewParagraph"]</h3>
                    <p class="text-base text-cus">
                        @SharedLocalizer["AdminParagraphs_InsertImmediatelyAfter"] <strong id="lblInsertTargetOrder" class="text-red-500 font-extrabold text-xs">#0</strong>
                    </p>
                </div>
            </div>
            <button type="button" onclick="closeInsertParagraphModal()" class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-red-50 hover:text-red-500 transition-all">&times;</button>
        </div>

        <div class="p-6 space-y-4 overflow-y-auto flex-1">
            <input type="hidden" id="insertChapterId" value="0" />
            <input type="hidden" id="insertTargetOrder" value="0" />

            <div class="space-y-1">
                <label class="text-[11px] font-bold text-cus uppercase">@SharedLocalizer["AdminParagraphs_BlockType"]</label>
                <select id="insertBlockType" class="select2-custom w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-semibold focus:border-teal-500 outline-none transition">
                    <option data-color="linear-gradient(to right, #FF8008 0%, #FFC837 51%, #FF8008 100%)" value="0">@SharedLocalizer["AdminParagraphs_BlockChapterOpening"]</option>
                    <option data-color="linear-gradient(to right, #283048 0%, #859398 51%, #283048 100%)" value="1" selected>@SharedLocalizer["AdminParagraphs_BlockContinuousSentence"]</option>
                    <option data-color="linear-gradient(135deg, #4facfe, #00f2fe)" value="2">@SharedLocalizer["AdminParagraphs_BlockNewParagraph"]</option>
                    <option data-color="linear-gradient(to right, #DA22FF 0%, #9733EE 51%, #DA22FF 100%)" value="4">@SharedLocalizer["AdminParagraphs_BlockDialogue"]</option>
                </select>
            </div>

            <div class="border-t border-gray-100 pt-3">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-bold text-cus uppercase">@SharedLocalizer["AdminParagraphs_AvailableLanguageContents"]</span>
                    <span class="text-[10px] text-red-500 font-bold">@SharedLocalizer["AdminCommon_RequiredFields"]</span>
                </div>
                <div id="insertDynamicLanguages" class="space-y-3">
                    <div class="text-center py-6 text-gray-400 text-xs">
                        <i class="fa-solid fa-spinner fa-spin mr-1"></i> @SharedLocalizer["AdminParagraphs_LoadingConfiguredLanguages"]
                    </div>
                </div>
            </div>
        </div>

        <div class="p-4 border-t border-gray-100 flex gap-3 bg-gray-50/50">
            <button type="button" onclick="closeInsertParagraphModal()" class="flex-1 py-2.5 btn-grad-cancel text-white text-xs font-bold rounded-xl active:scale-95 transition">@SharedLocalizer["AdminCommon_Cancel"]</button>
            <button type="button" id="btnConfirmInsertParagraph" onclick="submitInsertParagraph()" class="flex-1 py-2.5 btn-grad text-white text-xs font-bold rounded-xl active:scale-95 transition flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-floppy-disk"></i> @SharedLocalizer["AdminParagraphs_SaveReindex"]
            </button>
        </div>
    </div>
</div>

@* MODAL ATTACH IMAGE / STRIP GALLERY *@
<div id="attachImageModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center z-[10001] transition-all duration-300">
    <div id="attachImageModalContent" class="bg-white w-full max-w-lg rounded-3xl shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-300 flex flex-col">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gradient-to-r from-amber-50/60 to-white">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-xl bg-amber-500 text-white flex items-center justify-center font-bold">
                    <i class="fa-solid fa-camera text-xs"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-gray-800">@SharedLocalizer["AdminParagraphs_AttachIllustration"]</h3>
                    <p class="text-xs text-gray-500">@SharedLocalizer["AdminParagraphs_AssetsFolder"] <code class="text-amber-600 font-semibold">\assets\image\stories</code></p>
                </div>
            </div>
            <button type="button" onclick="closeAttachImageModal()" class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-red-50 hover:text-red-500 transition-all">&times;</button>
        </div>

        <div class="p-6 space-y-4">
            <!-- CHỌN CHẾ ĐỘ HIỂN THỊ (Layout Type) -->
            <div class="space-y-1">
                <label class="text-[11px] font-bold text-gray-700 uppercase">@SharedLocalizer["AdminParagraphs_DisplayLayout"]</label>
                <select id="imgDisplayMode" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-semibold outline-none focus:border-amber-500">
                    <option value="single">@SharedLocalizer["AdminParagraphs_SingleImage"]</option>
                    <option value="strip">@SharedLocalizer["AdminParagraphs_PanoramaStrip"]</option>
                    <option value="multi-strip">@SharedLocalizer["AdminParagraphs_ThreeSeparateImages"]</option>
                </select>
            </div>

            <!-- 1. VÙNG TẢI 1 ẢNH (Dùng cho Single & Panorama Strip) -->
            <div id="singleUploadArea">
                <div id="dropZoneWrapper" class="border-2 border-dashed border-gray-300 hover:border-amber-500 rounded-2xl p-5 text-center transition-all bg-gray-50/50 hover:bg-amber-50/20 relative">
                    <input type="file" id="fileStoryImageInput" accept="image/*" class="hidden" />
                    <label for="fileStoryImageInput" class="cursor-pointer flex flex-col items-center justify-center w-full h-full m-0">
                        <div id="uploadPlaceholder" class="flex flex-col items-center pointer-events-none">
                            <i class="fa-solid fa-cloud-arrow-up text-3xl text-gray-400 mb-2"></i>
                            <p class="text-xs font-semibold text-gray-700">@SharedLocalizer["AdminParagraphs_ChooseImageOrDrop"]</p>
                            <p class="text-[10px] text-gray-400 mt-1">@SharedLocalizer["AdminParagraphs_ImageRequirements"]</p>
                        </div>
                        <div id="imagePreviewBox" class="hidden w-full flex flex-col items-center">
                            <img id="imgPreviewTag" src="" alt="@SharedLocalizer["AdminParagraphs_ImagePreview"]" class="max-h-48 rounded-xl object-contain shadow-md border border-gray-200" />
                            <span class="text-[11px] text-amber-600 font-bold mt-2">@SharedLocalizer["AdminParagraphs_ReplaceImage"]</span>
                        </div>
                    </label>
                </div>

                <div class="space-y-1 mt-3" id="stripCountWrapper" style="display: none;">
                    <label class="text-[11px] font-bold text-gray-700 uppercase">@SharedLocalizer["AdminParagraphs_SliceCount"]</label>
                    <select id="imgStripCount" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-semibold outline-none focus:border-amber-500">
                        <option value="3" selected>@SharedLocalizer["AdminParagraphs_Panels3"]</option>
                        <option value="4">@SharedLocalizer["AdminParagraphs_Panels4"]</option>
                        <option value="5">@SharedLocalizer["AdminParagraphs_Panels5"]</option>
                    </select>
                </div>
            </div>

            <!-- 2. VÙNG TẢI 3 ẢNH KHÁC NHAU (Dành riêng cho Multi-strip) -->
            <div id="multiUploadArea" class="space-y-3" style="display: none;">
                <label class="text-[11px] font-bold text-gray-700 uppercase">@SharedLocalizer["AdminParagraphs_SelectThreePanelImages"]</label>
                <div class="grid grid-cols-3 gap-2">
                    <!-- Ảnh 1 -->
                    <div class="space-y-1 text-center">
                        <div class="h-28 border-2 border-dashed border-gray-300 rounded-xl flex items-center justify-center overflow-hidden bg-gray-50 relative group">
                            <img id="previewMulti_1" class="w-full h-full object-cover hidden" />
                            <i id="iconMulti_1" class="fa-solid fa-image text-gray-400 text-xl"></i>
                            <input type="file" id="fileMulti_1" accept="image/*" class="hidden" onchange="previewMultiItem(this, 1)" />
                        </div>
                        <button type="button" onclick="$('#fileMulti_1').click()" class="w-full py-1 text-[10px] font-bold bg-white border border-gray-200 rounded-lg hover:bg-gray-100">@SharedLocalizer["AdminParagraphs_Panel1"]</button>
                    </div>

                    <!-- Ảnh 2 -->
                    <div class="space-y-1 text-center">
                        <div class="h-28 border-2 border-dashed border-gray-300 rounded-xl flex items-center justify-center overflow-hidden bg-gray-50 relative group">
                            <img id="previewMulti_2" class="w-full h-full object-cover hidden" />
                            <i id="iconMulti_2" class="fa-solid fa-image text-gray-400 text-xl"></i>
                            <input type="file" id="fileMulti_2" accept="image/*" class="hidden" onchange="previewMultiItem(this, 2)" />
                        </div>
                        <button type="button" onclick="$('#fileMulti_2').click()" class="w-full py-1 text-[10px] font-bold bg-white border border-gray-200 rounded-lg hover:bg-gray-100">@SharedLocalizer["AdminParagraphs_Panel2"]</button>
                    </div>

                    <!-- Ảnh 3 -->
                    <div class="space-y-1 text-center">
                        <div class="h-28 border-2 border-dashed border-gray-300 rounded-xl flex items-center justify-center overflow-hidden bg-gray-50 relative group">
                            <img id="previewMulti_3" class="w-full h-full object-cover hidden" />
                            <i id="iconMulti_3" class="fa-solid fa-image text-gray-400 text-xl"></i>
                            <input type="file" id="fileMulti_3" accept="image/*" class="hidden" onchange="previewMultiItem(this, 3)" />
                        </div>
                        <button type="button" onclick="$('#fileMulti_3').click()" class="w-full py-1 text-[10px] font-bold bg-white border border-gray-200 rounded-lg hover:bg-gray-100">@SharedLocalizer["AdminParagraphs_Panel3"]</button>
                    </div>
                </div>
            </div>

            <!-- Chú thích ảnh (Caption) -->
            <div class="space-y-1">
                <label class="text-[11px] font-bold text-gray-700 uppercase">@SharedLocalizer["AdminParagraphs_CaptionOptional"]</label>
                <input type="text" id="imgCaptionInput" placeholder="@SharedLocalizer["AdminParagraphs_CaptionPlaceholder"]" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 focus:border-amber-500 rounded-xl text-xs outline-none transition" />
            </div>
        </div>

        <div class="p-4 border-t border-gray-100 flex gap-3 bg-gray-50/50">
            <button type="button" onclick="closeAttachImageModal()" class="flex-1 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs font-bold rounded-xl active:scale-95 transition">@SharedLocalizer["AdminCommon_Cancel"]</button>
            <button type="button" id="btnConfirmUploadImg" onclick="submitAttachImage()" class="flex-1 py-2.5 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white text-xs font-bold rounded-xl active:scale-95 transition flex items-center justify-center gap-1.5 shadow-md shadow-amber-200">
                <i class="fa-solid fa-upload"></i> @SharedLocalizer["AdminParagraphs_UploadAttach"]
            </button>
        </div>
    </div>
</div>