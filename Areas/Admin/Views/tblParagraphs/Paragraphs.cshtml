<script>
    // =========================================================
    // CHAPTER READER / EDITOR
    // PHASE 1
    // =========================================================

    let chapterEditorData = null;

    let chapterEditorObserver = null;

    let chapterEditorParagraphs = [];

    let currentEditorParagraphIndex = 0;

    let currentEditorLanguage = 'english';


    // =========================================================
    // OPEN
    // =========================================================

    function openChapterEditor(id) {

        $('#chapterEditorModal').removeClass('hidden');

        $('#chapterEditorParagraphList').html(`
            <div class="text-center text-gray-400 py-20">
                <i class="fa-solid fa-spinner fa-spin text-2xl mb-3"></i>

                <div>
                    Đang tải chapter...
                </div>
            </div>
        `);

        closeChapterSidePanel();

        $.ajax({

            url: '/Admin/tblParagraphs/GetChapterForEditor/' + id,

            type: 'GET',

            success: function(data) {

                console.log('Chapter Editor API:', data);

                chapterEditorData = data;

                chapterEditorParagraphs =
                    data.paragraphs || [];

                currentEditorParagraphIndex = 0;


                // HEADER

                $('#editorStoryTitle')
                    .text(data.storyTitle || 'Unknown Story');

                $('#editorChapterTitle')
                    .text(data.chapterTitle || 'Unknown Chapter');


                $('#chapterParagraphCount')
                    .text(
                        `${chapterEditorParagraphs.length} paragraphs`
                    );


                // LANGUAGE

                buildChapterEditorLanguageTabs();


                // READER

                renderChapterEditor();


                // COUNTER

                updateChapterEditorCounter();

            },

            error: function(xhr) {

                console.error(
                    'GetChapterForEditor failed:',
                    xhr.status,
                    xhr.responseText
                );

                $('#chapterEditorParagraphList').html(`

                    <div class="text-center text-red-500 py-20">

                        <i class="fa-solid fa-circle-exclamation text-2xl mb-3"></i>

                        <div>
                            Không thể tải nội dung chapter.
                        </div>

                    </div>

                `);

            }

        });
    }
        function closeChapterEditor() {

            if (chapterEditorObserver) {
                chapterEditorObserver.disconnect();
                chapterEditorObserver = null;
            }
            closeChapterSidePanel();


            $('#chapterEditorModal')
                .addClass('hidden');

            chapterEditorData = null;
            chapterEditorParagraphs = [];
            currentEditorParagraphIndex = 0;
        }
    function hasLanguageContent(language) {
        return chapterEditorParagraphs.some(function(p) {
            const value = p[language];
            return value !== null &&
                value !== undefined &&
                value.trim() !== '';

        });
    }
    function buildChapterEditorLanguageTabs() {

        const languages = [
            {
                key: 'english',
                label: '🇺🇸 English'
            },
            {
                key: 'vietnamese',
                label: '🇻🇳 Vietnamese'
            },
            {
                key: 'chinese',
                label: '🇨🇳 Chinese'
            },
            {
                key: 'japanese',
                label: '🇯🇵 Japanese'
            },
            {
                key: 'french',
                label: '🇫🇷 French'
            }
        ];

        const $container =
            $('#chapterEditorLanguageTabs');

        $container.empty();

        let firstLanguage = null;

        languages.forEach(function(lang) {
            if (!hasLanguageContent(lang.key)) {
                return;
            }
            if (!firstLanguage) {
                firstLanguage = lang.key;
            }
            $container.append(`

                <button
                    type="button"

                    class="chapter-editor-language-tab"

                    data-language="${lang.key}"

                    onclick="changeChapterEditorLanguage('${lang.key}')">

                    ${lang.label}

                </button>

            `);

        });

        if (firstLanguage) {
            currentEditorLanguage =
                firstLanguage;
            updateActiveEditorLanguageTab();
        }
    }
    function changeChapterEditorLanguage(language) {

        if (!hasLanguageContent(language)) {

            return;

        }

        currentEditorLanguage =
            language;


        updateActiveEditorLanguageTab();


        renderChapterEditor();


        closeChapterSidePanel();
    }
    function updateActiveEditorLanguageTab() {

        $('.chapter-editor-language-tab')
            .removeClass('active');


        $(
            `.chapter-editor-language-tab[data-language="${currentEditorLanguage}"]`
        )
            .addClass('active');
    }
    function getEditorParagraphText(paragraph, language) {

        const value = paragraph[language];

        if (value === null ||
            value === undefined ||
            value.trim() === '') {

            return null;
        }

        return value;
    }
    function renderChapterEditor() {

        const $container =
            $('#chapterEditorParagraphList');


        if (!chapterEditorParagraphs ||
            chapterEditorParagraphs.length === 0) {

            $container.html(`

                <div class="text-center text-gray-400 py-20">

                    Chapter này chưa có paragraph.

                </div>

            `);

            $('#chapterParagraphCounter')
                .text('0 / 0');

            return;
        }


        let html = '';


        chapterEditorParagraphs.forEach(function(paragraph, index) {

            const content =
                getEditorParagraphText(
                    paragraph,
                    currentEditorLanguage
                );


            const order =
                paragraph.paragraphOrder;


            html += `

                <div

                    class="editor-reader-paragraph"

                    data-paragraph-id="${paragraph.paragraphId}"

                    data-paragraph-index="${index}"

                    data-paragraph-order="${order}">


                    <div class="editor-paragraph-number">

                        #${String(order).padStart(3, '0')}

                    </div>


                    <div class="editor-paragraph-content">

            `;


            if (content === null) {

                html += `

                    <div class="editor-paragraph-unavailable">

                        <i class="fa-solid fa-circle-exclamation"></i>

                        Nội dung
                        ${getEditorLanguageName(currentEditorLanguage)}
                        chưa có.

                    </div>

                `;

            }
            else {

                /*
                    * Quan trọng:
                    * API đang trả HTML từ Quill.
                    *
                    * Không escape HTML ở đây.
                    *
                    * Vì reader hiện tại của bạn cũng đang
                    * xử lý nội dung rich text.
                    */

                html += content;

            }


            html += `

                    </div>

                </div>

            `;

        });


        $container.html(html);


        updateChapterEditorCounter();


        initChapterEditorScrollObserver();
    }
    function getEditorParagraphText(paragraph, language) {

        const value =
            paragraph[language];


        if (
            value === null ||
            value === undefined ||
            value.trim() === ''
        ) {

            return null;

        }


        return value;
    }
    function getEditorLanguageName(language) {

        switch (language) {

            case 'english':
                return 'English';

            case 'vietnamese':
                return 'Vietnamese';

            case 'chinese':
                return 'Chinese';

            case 'japanese':
                return 'Japanese';

            case 'french':
                return 'French';

            default:
                return language;
        }
    }
        function updateChapterEditorCounter() {

            const total =
                chapterEditorParagraphs.length;


            if (total === 0) {

                $('#chapterParagraphCounter')
                    .text('0 / 0');

                return;

            }


            const current =
                currentEditorParagraphIndex + 1;


            $('#chapterParagraphCounter')
                .text(`${current} / ${total}`);


            const paragraph =
                chapterEditorParagraphs[
                currentEditorParagraphIndex
                ];


            if (paragraph) {

                $('#chapterCurrentParagraph')
                    .text(
                        `#${String(
                            paragraph.paragraphOrder
                        ).padStart(3, '0')}`
                    );

            }
        }
    $(document)
        .off('click.chapterEditor', '.editor-reader-paragraph')
        .on(
            'click.chapterEditor',
            '.editor-reader-paragraph',
            function() {

                const index =
                    parseInt(
                        $(this).attr('data-paragraph-index')
                    );


                currentEditorParagraphIndex =
                    index;


                $('.editor-reader-paragraph')
                    .removeClass('active');


                $(this)
                    .addClass('active');


                updateChapterEditorCounter();


                openChapterSidePanel(index);

            }
        );
    function previousChapterParagraph() {

        if (currentEditorParagraphIndex <= 0) {
            return;
        }

        currentEditorParagraphIndex--;

        scrollToEditorParagraph(
            currentEditorParagraphIndex
        );
    }
    function nextChapterParagraph() {

        if (
            currentEditorParagraphIndex >=
            chapterEditorParagraphs.length - 1
        ) {
            return;
        }

        currentEditorParagraphIndex++;

        scrollToEditorParagraph(
            currentEditorParagraphIndex
        );
    }
    function scrollToEditorParagraph(index) {

        const $reader =
            $('#chapterEditorParagraphList');

        const $paragraph =
            $reader.find(
                `.editor-reader-paragraph[data-paragraph-index="${index}"]`
            );

        if ($paragraph.length === 0) {
            return;
        }

        const readerTop =
            $reader.offset().top;

        const paragraphTop =
            $paragraph.offset().top;

        const scrollTop =
            $reader.scrollTop();

        const target =
            scrollTop +
            paragraphTop -
            readerTop -
            30;

        $reader.animate(
            {
                scrollTop: target
            },
            300
        );

        updateChapterEditorCounter();
    }
    function normalizeQuillHtml(html) {
        if (!html) return null;

        html = html.trim();

        // Nội dung rỗng của Quill
        if (
            html === '' ||
            html === '<p><br></p>' ||
            html === '<p></p>'
        ) {
            return null;
        }

        // Nếu toàn bộ nội dung chỉ có đúng 1 <p>...</p>
        const match = html.match(/^<p>([\s\S]*)<\/p>$/);

        if (match) {
            return match[1].trim();
        }

        return html;
    }
    function initChapterEditorScrollObserver() {

        const reader =
            document.getElementById(
                'chapterEditorParagraphList'
            );


        if (!reader) {

            return;

        }


        if (chapterEditorObserver) {

            chapterEditorObserver.disconnect();

        }


        chapterEditorObserver =
            new IntersectionObserver(

                function(entries) {

                    entries.forEach(function(entry) {

                        if (!entry.isIntersecting) {

                            return;

                        }


                        const index =
                            parseInt(
                                entry.target.dataset
                                    .paragraphIndex
                            );


                        currentEditorParagraphIndex =
                            index;


                        updateChapterEditorCounter();

                    });

                },

                {
                    root: reader,

                    threshold: 0.5

                }

            );


        reader
            .querySelectorAll(
                '.editor-reader-paragraph'
            )
            .forEach(function(paragraph) {

                chapterEditorObserver
                    .observe(paragraph);

            });
    }
    function openChapterSidePanel(index) {

        const paragraph =
            chapterEditorParagraphs[index];


        if (!paragraph) {

            return;

        }


        const order =
            paragraph.paragraphOrder;


        $('#sidePanelParagraphNumber')
            .text(
                `#${String(order).padStart(3, '0')}`
            );


        const languages = [

            {
                key: 'english',
                label: '🇺🇸 English'
            },

            {
                key: 'vietnamese',
                label: '🇻🇳 Vietnamese'
            },

            {
                key: 'chinese',
                label: '🇨🇳 Chinese'
            },

            {
                key: 'japanese',
                label: '🇯🇵 Japanese'
            },

            {
                key: 'french',
                label: '🇫🇷 French'
            }

        ];


        let html = '';


        languages.forEach(function(lang) {

            const value =
                paragraph[lang.key];


            /*
                * NULL thật sự => không render editor.
                */

            if (
                value === null ||
                value === undefined ||
                value.trim() === ''
            ) {

                return;

            }


            html += `

                <div class="chapter-language-editor">

                    <div class="chapter-language-editor-label">

                        <span>
                            ${lang.label}
                        </span>

                    </div>


                    <div class="chapter-language-editor-content">

                        ${value}

                    </div>

                </div>

            `;

        });


        if (!html) {

            html = `

                <div class="text-center text-gray-400 py-10">

                    Paragraph này chưa có nội dung.

                </div>

            `;

        }


        $('#chapterEditorSideContent')
            .html(html);


        $('#chapterEditorSidePanel')
            .addClass('open');

    }
    function closeChapterSidePanel() {

        $('#chapterEditorSidePanel')
            .removeClass('open');


        $('.editor-reader-paragraph')
            .removeClass('active');
    }

</script>
}

