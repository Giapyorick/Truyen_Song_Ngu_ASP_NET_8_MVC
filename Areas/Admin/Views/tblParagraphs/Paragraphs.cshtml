<script>
$(document).ready(function () {

    // ===== LOAD STORIES KHI MỞ MODAL =====
    window.openParagraphModal = function () {
        const modal = $('#importParagraphModal');

        modal.removeClass('hidden').addClass('flex');

        setTimeout(() => {
            $('#importContent').addClass('scale-100 opacity-100');
        }, 10);

        loadStories();
    };

    // ===== ĐÓNG MODAL =====
    window.closeParagraphModal = function () {
        $('#importContent').removeClass('scale-100 opacity-100');

        setTimeout(() => {
            $('#importParagraphModal').removeClass('flex').addClass('hidden');
            resetImportForm();
        }, 300);
    };

    // ===== LOAD STORY =====
    function loadStories() {
        $('#storySelect')
            .html('<option value="">-- Chọn truyện --</option>');

        $('#chapterSelect')
            .html('<option value="">-- Chọn chương --</option>');

        $.get('/Admin/tblParagraphs/GetStoriesForSelect', function (data) {
            data.forEach(x => {
                $('#storySelect').append(
                    `<option value="${x.id}">${x.name}</option>`
                );
            });
        });
    }

    // ===== KHI CHỌN STORY → LOAD CHAPTER =====
    $('#storySelect').on('change', function () {
        let storyId = $(this).val();

        $('#chapterSelect')
            .html('<option value="">-- Chọn chương --</option>');

        if (!storyId) return;

        $.get('/Admin/tblParagraphs/GetChaptersForSelect',
            { id: storyId },
            function (data) {
                data.forEach(x => {
                    $('#chapterSelect').append(
                        `<option value="${x.id}">${x.name}</option>`
                    );
                });
            }
        );
    });
	$('#fileEnglish').on('change', function(e) {
		const file = e.target.files[0];
		if (file) {
			$('#fileStatusEN').html(`<span class="text-indigo-600 font-bold italic">${file.name}</span>`);
			$('#dropZone').addClass('border-indigo-500 bg-indigo-100/50');
		}
	});
	$('#fileVietnamese').on('change', function(e) {
		const file = e.target.files[0];
		if (file) {
			$('#fileStatusVN').html(`<span class="text-indigo-600 font-bold italic">${file.name}</span>`);
			$('#dropZone').addClass('border-indigo-500 bg-indigo-100/50');
		}
	});

    // ===== IMPORT PARAGRAPHS (5 LANGUAGES) =====
    $('#btnImport').on('click', function() {
        let chapId = $('#chapterSelect').val();

        if (!chapId) {
            showToast('Vui lòng chọn Chapter!', 'error');
            return;
        }

        // Lấy file từ các ô input
        let fileVN = $('#fileVietnamese')[0].files[0];
        let fileEN = $('#fileEnglish')[0].files[0];
        let fileZH = $('#fileChinese')[0].files[0];
        let fileJA = $('#fileJapanese')[0].files[0];
        let fileFR = $('#fileFrench')[0].files[0];

        // Kiểm tra xem người dùng đã chọn ít nhất 1 file chưa
        if (!fileVN && !fileEN && !fileZH && !fileJA && !fileFR) {
            showToast('Vui lòng chọn ít nhất 1 file ngôn ngữ để import!', 'error');
            return;
        }

        let formData = new FormData();
        formData.append('chapId', chapId);

        // Chỉ append những file người dùng thực sự chọn
        if (fileVN) formData.append('fileVietnamese', fileVN);
        if (fileEN) formData.append('fileEnglish', fileEN);
        if (fileZH) formData.append('fileChinese', fileZH);
        if (fileJA) formData.append('fileJapanese', fileJA);
        if (fileFR) formData.append('fileFrench', fileFR);

        // Disable nút trong lúc chờ xử lý
        let $btn = $(this);
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i> Importing...');

        $.ajax({
            url: '/Admin/tblParagraphs/ImportExcel',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(res) {
                if (res.success) {
                    showToast(res.message || 'Import thành công!', 'success'); // Đã sửa chính tả 'succes' thành 'success'
                    closeParagraphModal();
                    // Load lại danh sách đoạn văn nếu có hàm reload
                    if (typeof loadParagraphs === 'function') {
                        loadParagraphs(chapId);
                    }
                } else {
                    showToast(res.message, 'error');
                }
            },
            error: function (xhr, status, error) {
                // 1. Lấy thông điệp lỗi dạng JSON từ server trả về (nếu có)
                let errorMessage = xhr.responseJSON && xhr.responseJSON.message 
                    ? xhr.responseJSON.message 
                    : (xhr.responseText || error || 'Có lỗi xảy ra khi import!');

                // 2. Hiển thị Toast
                showToast(`Lỗi [${xhr.status}]: ${errorMessage}`, 'error');

                // 3. In ra console để developer tiện debug
                console.error('AJAX Import Error Details:', {
                    status: xhr.status,
                    statusText: xhr.statusText,
                    responseText: xhr.responseText,
                    error: error
                });
            },
            complete: function() {
                $btn.prop('disabled', false).html('Confirm Import');
            }
        });
    });

    // ===== XỬ LÝ HIỂN THỊ TÊN FILE KHI NGƯỜI DÙNG CHỌN FILE =====
    const languageInputs = [
        { inputId: '#fileVietnamese', statusId: '#fileStatusVN', defaultText: 'Chọn hoặc thả file VN...' },
        { inputId: '#fileEnglish', statusId: '#fileStatusEN', defaultText: 'Chọn hoặc thả file EN...' },
        { inputId: '#fileChinese', statusId: '#fileStatusZH', defaultText: 'Chọn hoặc thả file ZH...' },
        { inputId: '#fileJapanese', statusId: '#fileStatusJA', defaultText: 'Chọn hoặc thả file JA...' },
        { inputId: '#fileFrench', statusId: '#fileStatusFR', defaultText: 'Chọn hoặc thả file FR...' }
    ];

    languageInputs.forEach(item => {
        $(document).on('change', item.inputId, function() {
            let fileName = this.files[0] ? this.files[0].name : item.defaultText;
            $(item.statusId).text(fileName);
        });
    });
    // Cập nhật tên file cho các input khác khi chọn file thủ công
    const otherInputs = [
        { inputId: '#fileVietnamese', statusId: '#fileStatusVN', defaultText: 'Chọn hoặc thả file VN...' },
        { inputId: '#fileChinese', statusId: '#fileStatusZH', defaultText: 'Chọn hoặc thả file ZH...' },
        { inputId: '#fileJapanese', statusId: '#fileStatusJA', defaultText: 'Chọn hoặc thả file JA...' },
        { inputId: '#fileFrench', statusId: '#fileStatusFR', defaultText: 'Chọn hoặc thả file FR...' }
    ];

    otherInputs.forEach(item => {
        $(document).on('change', item.inputId, function() {
            let fileName = this.files[0] ? this.files[0].name : item.defaultText;
            $(item.statusId).text(fileName);
        });
    });
    $(document).on('change', '#fileEnglish', function() {
        let file = this.files[0];
        if (file) {
            $('#fileStatusEN').text(file.name);
            // Mở khóa tất cả các nút AI
            $('.ai-btn').prop('disabled', false).removeClass('opacity-40 cursor-not-allowed');
            showToast('Đã nhận file Tiếng Anh! Bạn có thể bấm các nút AI bên dưới để dịch.', 'info');
        } else {
            $('#fileStatusEN').text('Tải file Tiếng Anh lên...');
            $('.ai-btn').prop('disabled', true).addClass('opacity-40 cursor-not-allowed');
        }
    });
    // ===== RESET FORM =====
    function resetImportForm() {
        $('#storySelect').val('');
        $('#chapterSelect').val('');

        $('#fileEnglish').val('');
        $('#fileVietnamese').val('');
        $('#fileChinese').val('');
        $('#fileJapanese').val('');
        $('#fileFrench').val('');

        $('#fileStatusEN').text('Tải file Tiếng Anh lên...');
        $('#fileStatusVN').text('Chọn hoặc thả file VN...');
        $('#fileStatusZH').text('Chọn hoặc thả file ZH...');
        $('#fileStatusJA').text('Chọn hoặc thả file JA...');
        $('#fileStatusFR').text('Chọn hoặc thả file FR...');

        $('.ai-btn')
            .prop('disabled', true)
            .addClass('opacity-40 cursor-not-allowed');
    }

});
</script>

