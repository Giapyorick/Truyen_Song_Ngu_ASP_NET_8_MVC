            type: 'GET',

            success: function(data) {

                console.log('Chapter Editor API:', data);

                chapterEditorData = data;

                chapterEditorParagraphs =
                    data.paragraphs || [];

                currentEditorParagraphIndex = 0;


                // HEADER

                $('#editorStoryTitle')
                    .text(data.storyTitle || 'Unknown Story');

                $('#editorChapterTitle')
                    .text(data.chapterTitle || 'Unknown Chapter');


                $('#chapterParagraphCount')
                    .text(
                        `${chapterEditorParagraphs.length} paragraphs`
                    );


                // LANGUAGE

                buildChapterEditorLanguageTabs();


                // READER

                renderChapterEditor();


                // COUNTER

                updateChapterEditorCounter();

            },

            error: function(xhr) {

                console.error(
                    'GetChapterForEditor failed:',
                    xhr.status,
                    xhr.responseText
                );

                $('#chapterEditorParagraphList').html(`

                    <div class="text-center text-red-500 py-20">

                        <i class="fa-solid fa-circle-exclamation text-2xl mb-3"></i>

                        <div>
                            Không thể tải nội dung chapter.
                        </div>

                    </div>

                `);

            }

        });
    }
        function closeChapterEditor() {

            if (chapterEditorObserver) {
                chapterEditorObserver.disconnect();
                chapterEditorObserver = null;
            }
            closeChapterSidePanel();


            $('#chapterEditorModal')
                .addClass('hidden');

            chapterEditorData = null;
            chapterEditorParagraphs = [];
            currentEditorParagraphIndex = 0;
        }
    function hasLanguageContent(language) {
        return chapterEditorParagraphs.some(function(p) {
            const value = p[language];
            return value !== null &&
                value !== undefined &&
                value.trim() !== '';

        });
    }
        function buildChapterEditorLanguageTabs() {
            const languages = [
                { key: 'english', label: '🇺🇸 EN', fullName: 'English' },
                { key: 'vietnamese', label: '🇻🇳 VN', fullName: 'Vietnamese' },
                { key: 'chinese', label: '🇨🇳 ZH', fullName: 'Chinese' },
                { key: 'japanese', label: '🇯🇵 JP', fullName: 'Japanese' },
                { key: 'french', label: '🇫🇷 FR', fullName: 'French' }
            ];

            const $mainContainer = $('#chapterEditorLanguageTabs');
            const $sideContainer = $('#sidePanelLangTabs');

            if ($mainContainer.length) $mainContainer.empty();
            if ($sideContainer.length) $sideContainer.empty();

            let firstLanguage = null;

            languages.forEach(function(lang) {
                // Tận dụng hàm hasLanguageContent có sẵn để kiểm tra
                if (!hasLanguageContent(lang.key)) {
                    return;
                }

                if (!firstLanguage) {
                    firstLanguage = lang.key;
                }

                // 1. Render tab ở Header chính (nếu có)
                if ($mainContainer.length) {
                    $mainContainer.append(`
                        <button type="button"
                                class="chapter-editor-language-tab"
                                data-language="${lang.key}"
                                onclick="changeChapterEditorLanguage('${lang.key}')">
                            ${lang.label}
                        </button>
                    `);
                }

                // 2. Render tab ở Editor Side Panel
                if ($sideContainer.length) {
                    $sideContainer.append(`
                        <button type="button"
                                id="sideTab_${lang.key}"
                                class="side-panel-lang-tab px-3 py-1.5 text-xs rounded-xl transition font-medium text-gray-500 hover:bg-gray-100"
                                data-language="${lang.key}"
                                onclick="changeChapterEditorLanguage('${lang.key}')">
                            ${lang.label}
                        </button>
                    `);
                }
            });

            if (!currentEditorLanguage && firstLanguage) {
                currentEditorLanguage = firstLanguage;
            }

            updateActiveEditorLanguageTab();
        }
        function changeChapterEditorLanguage(language) {
            if (!hasLanguageContent(language)) {
                return;
            }

            currentEditorLanguage = language;
            currentSideTabLang = language;

            updateActiveEditorLanguageTab();

            renderChapterEditor();

            if (currentEditingIndex !== -1 && sideQuill) {
                const paragraph = chapterEditorParagraphs[currentEditingIndex];
                if (paragraph) {
                    const textValue = paragraph[currentEditorLanguage] || '';
                    sideQuill.root.innerHTML = textValue;
                }

                $('#sideCurrentLangLabel').text(currentEditorLanguage.toUpperCase());

                $(`.editor-reader-paragraph[data-paragraph-index="${currentEditingIndex}"]`).addClass('active editing-live');
            }
        }
        function updateActiveEditorLanguageTab() {
            // Header chính
            $('.chapter-editor-language-tab').removeClass('active');
            $(`.chapter-editor-language-tab[data-language="${currentEditorLanguage}"]`).addClass('active');

            // Side Panel
            $('.side-panel-lang-tab')
                .removeClass('bg-teal-50 text-teal-700 font-bold border border-teal-200 shadow-sm')
                .addClass('text-gray-500 font-medium');

            $(`#sideTab_${currentEditorLanguage}`)
                .addClass('bg-teal-50 text-teal-700 font-bold border border-teal-200 shadow-sm')
                .removeClass('text-gray-500 font-medium');

            $('#sideCurrentLangLabel').text(currentEditorLanguage.toUpperCase());
        }
    function getEditorParagraphText(paragraph, language) {

        const value = paragraph[language];

        if (value === null ||
            value === undefined ||
            value.trim() === '') {

            return null;
        }

        return value;
    }
        function renderChapterEditor() {
            const $container = $('#chapterEditorParagraphList');

            if (!chapterEditorParagraphs || chapterEditorParagraphs.length === 0) {
                $container.html('<div class="text-center text-gray-400 py-20">Chapter này chưa có paragraph.</div>');
                $('#chapterParagraphCounter').text('0 / 0');
                return;
            }

            let html = '<div class="chapter-editor-reader-inner">';
            let isBlockOpen = false;
            let previousWasDialogue = false;

            // Helper bóc tách URL và Caption từ chuỗi [img:URL|Caption] hoặc [img:URL]
            function extractImgInfo(text) {
                if (!text) return null;
                // Bóc tách cả trường hợp có ký tự hoặc thẻ HTML dính xung quanh
                const match = text.match(/\[img\s*:\s*([^\]|]+)(?:\|([^\]]*))?\]/i);
                if (!match) return null;

                return {
                    fullTag: match[0],
                    url: match[1].trim(),
                    caption: match[2] ? match[2].trim() : ''
                };
            }

            chapterEditorParagraphs.forEach(function (p, index) {
                let rawContent = getEditorParagraphText(p, currentEditorLanguage) || '';

                // Đọc an toàn blockType
                let blockType = 1;
                if (p.blockType !== undefined && p.blockType !== null) {
                    blockType = parseInt(p.blockType);
                } else if (p.BlockType !== undefined && p.BlockType !== null) {
                    blockType = parseInt(p.BlockType);
                } else if (index === 0) {
                    blockType = 0;
                }

                const order = p.paragraphOrder;

                // 1. Quét ảnh trong ngôn ngữ hiện tại
                let currentImgInfo = extractImgInfo(rawContent);
                let finalUrl = '';
                let finalCaption = '';
                let fullTagToRemove = '';

                if (currentImgInfo) {
                    finalUrl = currentImgInfo.url;
                    finalCaption = currentImgInfo.caption;
                    fullTagToRemove = currentImgInfo.fullTag;
                } else {
                    // 2. Dự phòng: Quét qua các ngôn ngữ khác để lấy URL nếu ngôn ngữ hiện tại chưa gắn
                    const fallbackOrder = [p.english, p.vietnamese, p.chinese, p.japanese, p.french];
                    for (let item of fallbackOrder) {
                        const info = extractImgInfo(item);
                        if (info) {
                            finalUrl = info.url;
                            finalCaption = info.caption; // Lấy tạm caption dự phòng
                            break;
                        }
                    }
                }

                // 3. Nếu tìm được URL nhưng chưa có caption, quét thêm Tiếng Việt / Tiếng Anh để tìm caption
                if (finalUrl && !finalCaption) {
                    const vnInfo = extractImgInfo(p.vietnamese);
                    const enInfo = extractImgInfo(p.english);
                    if (vnInfo && vnInfo.caption) finalCaption = vnInfo.caption;
                    else if (enInfo && enInfo.caption) finalCaption = enInfo.caption;
                }

                let imgAfterHtml = '';

                if (finalUrl) {
                    const captionHtml = finalCaption
                        ? `<div class="story-illustration-caption"><i class="fa-solid fa-camera"></i> ${finalCaption}</div>`
                        : '';

                    // Luôn luôn gán vào imgAfterHtml (hiển thị sau câu chữ)
                    imgAfterHtml = `
                                <div class="story-illustration-block">
                                    <img src="${finalUrl}" alt="${finalCaption || 'Illustration #' + order}" onerror="this.src='/assets/image/placeholder.png';">
                                    ${captionHtml}
                                </div>
                            `;

                    // Xóa triệt để thẻ [img:...] khỏi nội dung câu chữ dù nó nằm ở vị trí nào
                    if (fullTagToRemove) {
                        rawContent = rawContent.replace(fullTagToRemove, '').trim();
                    }
                }

                // Xóa phòng hờ tất cả các tag [img...] còn sót trong chuỗi chữ
                rawContent = rawContent.replace(/\[img[\s\S]*?\]/gi, '').trim();

                const content = stripBlockTags(rawContent);

                // --- LOGIC MỞ KHỐI CHỮ (0, 2, 4) ---
                const shouldStartNewBlock = (index === 0) ||
                    (blockType === 0 || blockType === 2 || blockType === 4) ||
                    previousWasDialogue;

                if (shouldStartNewBlock) {
                    if (isBlockOpen) {
                        html += '</div>';
                    }

                    let blockClass = 'para-block-start';
                    if (blockType === 2) blockClass = 'para-block-indent';
                    else if (blockType === 4) blockClass = 'para-block-dialogue';
                    else if (blockType === 1 && previousWasDialogue) blockClass = 'para-block-indent';

                    html += `<div class="${blockClass}">`;
                    isBlockOpen = true;
                }

                // Đánh dấu highlight nếu đang được chọn sửa trên Side Panel
                const isEditingThis = (typeof currentEditingIndex !== 'undefined' && currentEditingIndex === index);
                const editingClasses = isEditingThis ? ' active editing-live' : '';

                // --- RENDER NỘI DUNG CHỮ ---
                html += `<span class="editor-reader-paragraph${editingClasses}"
                                      data-paragraph-id="${p.paragraphId}"
                                      data-paragraph-index="${index}"
                                      data-paragraph-order="${order}"
                                      title="#${String(order).padStart(3, '0')} (Kiểu: ${blockType})">`;

                if (content === null || content === '') {
                    // Nếu câu chỉ có ảnh và không có chữ thì không in chữ báo thiếu
                    if (!finalUrl) {
                        html += `<span class="italic text-gray-400">[Chưa có nội dung ${getEditorLanguageName(currentEditorLanguage)}]</span>`;
                    }
                } else {
                    html += content;
                }

                html += `</span> `;

                previousWasDialogue = (blockType === 4);

                // --- LUÔN LUÔN XỬ LÝ ẢNH SAU CÂU ---
                if (imgAfterHtml) {
                    // Đóng khối text hiện tại trước khi in ảnh để ảnh không bị dính thụt lề 1cm của khối chữ
                    if (isBlockOpen) {
                        html += '</div>';
                        isBlockOpen = false;
                    }
                    html += imgAfterHtml;
                    previousWasDialogue = false; // Reset cờ sau ảnh để câu kế tiếp không bị hiểu nhầm là nối sau lời thoại
                }
            });

            if (isBlockOpen) {
                html += '</div>';
            }

            html += '</div>';

            $container.html(html);
            updateChapterEditorCounter();
            initChapterEditorScrollObserver();
        }
    function stripBlockTags(str) {
        if (!str) return null;
        return str.replace(/<\/?p[^>]*>/gi, '').replace(/<br\s*\/?>/gi, ' ').trim();
    }
    function getEditorParagraphText(paragraph, language) {

        const value =
            paragraph[language];


        if (
            value === null ||
            value === undefined ||
            value.trim() === ''
        ) {

            return null;

        }


        return value;
    }
    function getEditorLanguageName(language) {

        switch (language) {

            case 'english':
                return 'English';

            case 'vietnamese':
                return 'Vietnamese';

            case 'chinese':
                return 'Chinese';

            case 'japanese':
                return 'Japanese';

            case 'french':
                return 'French';

            default:
                return language;
        }
    }
        function updateChapterEditorCounter() {

            const total =
                chapterEditorParagraphs.length;


            if (total === 0) {

                $('#chapterParagraphCounter')
                    .text('0 / 0');

                return;

            }


            const current =
                currentEditorParagraphIndex + 1;


            $('#chapterParagraphCounter')
                .text(`${current} / ${total}`);


            const paragraph =
                chapterEditorParagraphs[
                currentEditorParagraphIndex
                ];


            if (paragraph) {

                $('#chapterCurrentParagraph')
                    .text(
                        `#${String(
                            paragraph.paragraphOrder
                        ).padStart(3, '0')}`
                    );

            }
        }
    $(document)
        .off('click.chapterEditor', '.editor-reader-paragraph')
        .on(
            'click.chapterEditor',
            '.editor-reader-paragraph',
            function() {

                const index =
                    parseInt(
                        $(this).attr('data-paragraph-index')
                    );


                currentEditorParagraphIndex =
                    index;


                $('.editor-reader-paragraph')
                    .removeClass('active');


                $(this)
                    .addClass('active');


                updateChapterEditorCounter();


                openChapterSidePanel(index);

            }
        );
    function previousChapterParagraph() {

        if (currentEditorParagraphIndex <= 0) {
            return;
        }

        currentEditorParagraphIndex--;

        scrollToEditorParagraph(
            currentEditorParagraphIndex
        );
    }
    function nextChapterParagraph() {

        if (
            currentEditorParagraphIndex >=
            chapterEditorParagraphs.length - 1
        ) {
            return;
        }

        currentEditorParagraphIndex++;

        scrollToEditorParagraph(
            currentEditorParagraphIndex
        );
    }
    function scrollToEditorParagraph(index) {

        const $reader =
            $('#chapterEditorParagraphList');

        const $paragraph =
            $reader.find(
                `.editor-reader-paragraph[data-paragraph-index="${index}"]`
            );

        if ($paragraph.length === 0) {
            return;
        }

        const readerTop =
            $reader.offset().top;

        const paragraphTop =
            $paragraph.offset().top;

        const scrollTop =
            $reader.scrollTop();

        const target =
            scrollTop +
            paragraphTop -
            readerTop -
            30;

        $reader.animate(
            {
                scrollTop: target
            },
            300
        );

        updateChapterEditorCounter();
    }
    function normalizeQuillHtml(html) {
        if (!html) return null;
        let clean = html.trim();

        if (clean === '' || clean === '<p><br></p>' || clean === '<p></p>') {
            return null;
        }

        // Bóc sạch thẻ <p> ngoài cùng do Quill tự bọc
        if (clean.startsWith('<p>') && clean.endsWith('</p>')) {
            clean = clean.slice(3, -4);
        }

        // Phòng ngừa trường hợp người dùng copy-paste nội dung có thẻ <br> hoặc <p> từ web khác vào
        clean = clean.replace(/<\/?p[^>]*>/gi, '').replace(/<br\s*\/?>/gi, ' ').trim();

        return clean;
    }
    function initChapterEditorScrollObserver() {

        const reader =
            document.getElementById(
                'chapterEditorParagraphList'
            );


        if (!reader) {

            return;

        }


        if (chapterEditorObserver) {

            chapterEditorObserver.disconnect();

        }


        chapterEditorObserver =
            new IntersectionObserver(

                function(entries) {

                    entries.forEach(function(entry) {

                        if (!entry.isIntersecting) {

                            return;

                        }


                        const index =
                            parseInt(
                                entry.target.dataset
                                    .paragraphIndex
                            );


                        currentEditorParagraphIndex =
                            index;


                        updateChapterEditorCounter();

                    });

                },

                {
                    root: reader,

                    threshold: 0.5

                }

            );


        reader
            .querySelectorAll(
                '.editor-reader-paragraph'
            )
            .forEach(function(paragraph) {

                chapterEditorObserver
                    .observe(paragraph);

            });
    }

</script>
}

