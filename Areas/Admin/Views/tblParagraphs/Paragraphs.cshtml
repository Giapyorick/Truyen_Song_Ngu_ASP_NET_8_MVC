    setTimeout(() => $('#modalContent').addClass('translate-y-0 opacity-100'), 10);
}

///////////////////////////////////////
	// close modall
    function closeModal() {
        const content = $('#modalContent');
        content.removeClass('translate-y-0 opacity-100 scale-100')
               .addClass('translate-y-10 opacity-0 scale-95');
        
        setTimeout(() => {
            $('#modalOverlay').removeClass('flex').addClass('hidden');
        }, 300);
    }
//////////////////////////////////////////
	// action delete
    async function deleteParagraph(id) {
			const confirmed = await customConfirm(
				`Are you sure to remove this paragraph ?<br><small class="text-red-400">This action cannot be undone.</small>`,
				"Delete Paragraph"
			);
			if (confirmed) {
			
			const $row = $(`button[onclick="deleteParagraph(${id})"]`).closest('tr');
			
			$row.addClass('opacity-50 pointer-events-none');

			$.ajax({
				url: '/Admin/tblParagraphs/Delete',
				type: 'POST',
				data: { id: id },
				success: function(response) {
					if (response.success) {
						$row.fadeOut(400, function() {
							$(this).remove();
							showToast(response.message, 'succes');
						});
					} else {
						showToast("Lỗi: " + response.message, 'error');
						$row.removeClass('opacity-50 pointer-events-none');
					}
				},
				error: function() {
					showToast("Cannot connect to the server to delete.", 'error');
					$row.removeClass('opacity-50 pointer-events-none');
				}
			});
		}
	}
