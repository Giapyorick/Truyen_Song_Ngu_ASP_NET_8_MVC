@using Microsoft.Extensions.Localization
@using WebTruyenTranh
@inject IStringLocalizer<SharedResource> SharedLocalizer

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<!-- Vendor Styles & Custom Stylesheet -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet">
<link rel="stylesheet" href="~/css/admin/tblParagraphs/paragraphs-management.css" asp-append-version="true" />

<main class="flex-1 flex flex-col overflow-y-auto">
    <div class="space-y-10 m-10">
        <div class="flex flex-col items-center gap-4">
            <h2 class="text-2xl font-bold text-cus tracking-tight">
                @SharedLocalizer["Para_PageTitle"]
            </h2>
        </div>

        <div class="bg-white rounded-[2rem] shadow-xl shadow-gray-200/50 border border-gray-100 overflow-hidden">
            <!-- Filter Bar -->
            <div class="p-6 border-b border-gray-50 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="relative w-40 sm:w-64">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                    <input type="text" id="filterSearch" placeholder="@SharedLocalizer["Para_SearchPlaceholder"]" 
                           class="w-full pl-11 pr-4 py-2.5 bg-gray-200 border border-transparent focus:border-purple-300 focus:bg-white rounded-xl outline-none transition-all text-sm">
                </div>

                <div class="w-60">
                    <select id="filterStory" class="select2-custom w-full mt-1 p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none shadow-sm">
                        <option data-color="linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%)" value="all">@SharedLocalizer["Para_FilterAllStories"]</option>
                    </select>
                </div>

                <div class="w-60">
                    <select id="filterChapter" class="select2-custom w-full mt-1 p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none shadow-sm">
                        <option data-color="linear-gradient(to bottom, rgba(255,255,255,0.15) 0%, rgba(0,0,0,0.15) 100%), radial-gradient(at top center, rgba(255,255,255,0.40) 0%, rgba(0,0,0,0.40) 120%) #989898;" value="all">@SharedLocalizer["Para_FilterAllChapters"]</option>
                    </select>
                </div>

                <div class="flex items-center gap-4">
                    <button onclick="exportExcel()" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300">
                        <i class="fas fa-file-export mr-2"></i>@SharedLocalizer["Btn_Export"]
                    </button>
                    <button onclick="openParagraphModal()" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300">
                        <i class="fas fa-file-import mr-2"></i>@SharedLocalizer["Btn_Import"]
                    </button>
                    <button id="btnDeleteSelected" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300" disabled>
                        <i class="fas fa-trash-alt mr-2"></i>@SharedLocalizer["Admin_BtnDeleteText"]
                    </button>
                </div>
            </div>

            <!-- Table -->
            <div class="overflow-x-auto">
                <table class="min-w-max text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/50 text-gray-400 text-[11px] uppercase tracking-[0.15em] border-b border-gray-100">
                            <th class="px-6 py-4 w-10">
                                <div class="flex items-center justify-center">
                                    <input type="checkbox" id="selectAll" class="w-5 h-5 rounded-md border-gray-300 text-purple-600 focus:ring-purple-500 cursor-pointer transition-all">
                                </div>
                            </th>
                            <th class="px-4 py-4 text-gray font-bold text-left">@SharedLocalizer["Para_ColInfo"]</th>
                            <th class="px-6 py-4 text-gray font-bold text-center">@SharedLocalizer["Para_ColOrder"]</th>
                            <th class="px-6 py-4 text-gray font-bold text-left">@SharedLocalizer["Para_ColEnglish"]</th>
                            <th class="px-6 py-4 text-gray font-bold text-left">@SharedLocalizer["Para_ColVietnamese"]</th>
                            <th class="px-6 py-4 text-gray font-bold text-left">@SharedLocalizer["Para_ColChinese"]</th>
                            <th class="px-6 py-4 text-gray font-bold text-left">@SharedLocalizer["Para_ColJapanese"]</th>
                            <th class="px-6 py-4 text-gray font-bold text-left">@SharedLocalizer["Para_ColFrench"]</th>
                            <th class="px-6 py-4 text-gray font-bold text-left">@SharedLocalizer["Para_ColBlockType"]</th>
                            <th class="px-8 py-4 text-gray font-bold text-right">@SharedLocalizer["Admin_ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody id="user-list-body" class="divide-y divide-gray-50"></tbody>
                </table>
            </div>

            <!-- Pagination Container -->
            <div id="pagination-container" class="flex justify-center items-center gap-2 py-4"></div>
        </div>
    </div>
</main>

<!-- Nhúng 3 Partial View Modal riêng biệt -->
@await Html.PartialAsync("_ParagraphCrudModalsPartial")
@await Html.PartialAsync("_ParagraphImportAiModalsPartial")
@await Html.PartialAsync("_ParagraphEditorModalsPartial")

@section Scripts {
    <!-- Vendor Libraries -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>

    <!-- Modular Script Files -->
    <script src="~/js/admin/tblParagraphs/paragraphs-crud.js" asp-append-version="true"></script>
    <script src="~/js/admin/tblParagraphs/paragraphs-import-ai.js" asp-append-version="true"></script>
    <script src="~/js/admin/tblParagraphs/paragraphs-editor.js" asp-append-version="true"></script>
}