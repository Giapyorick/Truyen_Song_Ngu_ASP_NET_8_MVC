<script>
        // Danh sách ngôn ngữ được chọn để AI dịch ngầm
        // =========================================================
        let selectedAiLanguages = new Set(['Vietnamese']); // Mặc định luôn có Tiếng Việt

        function toggleAutoAiTranslate(targetLang, btn) {
            const $btn =$(btn);
            const isActive = $btn.data('active') === true;

            if (isActive) {
                selectedAiLanguages.delete(targetLang);
                $btn.data('active', false)
                    .removeClass('ring-2 ring-purple-500 from-purple-600 to-indigo-600 shadow-md')
                    .addClass('from-[#50C9C3] to-[#96DEDA]');
                $btn.find('.ai-label').text('AI Dịch từ file Tiếng Anh');
                showToast(`Đã bỏ chọn AI dịch cho ${targetLang}`, 'info');
            } else {
                selectedAiLanguages.add(targetLang);
                $btn.data('active', true)
                    .removeClass('from-[#50C9C3] to-[#96DEDA]')
                    .addClass('ring-2 ring-purple-500 from-purple-600 to-indigo-600 shadow-md');
                $btn.find('.ai-label').html('✨ Sẽ được AI dịch khi Import');
                showToast(`Đã chọn AI dịch cho ${targetLang}`, 'success');
            }
            console.log("Danh sách ngôn ngữ hiện tại:", Array.from(selectedAiLanguages));
        }

        // Khi chọn file Tiếng Anh: Tự động kích hoạt toàn bộ các nút dịch nếu muốn
        $(document).on('change', '#fileEnglish', function () {
            const file = this.files && this.files.length > 0 ? this.files[0] : null;
            if (file) {
                $('#fileStatusEN').text(file.name);
                $('.ai-btn').prop('disabled', false).removeClass('opacity-40 cursor-not-allowed');

                // Tự động bật Tiếng Việt nếu chưa bật
                const $vnBtn =$('#importParagraphModal button[onclick*="\'Vietnamese\'"]');
                if ($vnBtn.length &&$vnBtn.data('active') !== true) {
                    toggleAutoAiTranslate('Vietnamese', $vnBtn[0]);         }     } else {$('#fileStatusEN').text('Tải file Tiếng Anh lên...');
                $('.ai-btn').prop('disabled', true).addClass('opacity-40 cursor-not-allowed');
                selectedAiLanguages.clear();
                selectedAiLanguages.add('Vietnamese');
            }
        });

        // Xử lý nút Confirm Import
        $('#btnImport').off('click').on('click', function () {
            const storyId = $('#storySelect').val();
            const chapId = $('#chapterSelect').val();
            const inputEN = document.getElementById('fileEnglish');
            const fileEN = inputEN && inputEN.files ? inputEN.files[0] : null;

            if (!storyId || !chapId) {
                showToast('Vui lòng chọn cả Truyện và Chapter!', 'error');
                return;
            }

            if (!fileEN) {
                showToast('Vui lòng chọn file Tiếng Anh làm ngôn ngữ nguồn!', 'error');
                return;
            }

            const formData = new FormData();
            formData.append('chapterId', chapId);
            formData.append('fileEnglish', fileEN);

            // Thu thập tất cả các ngôn ngữ đã bật
            const langsArray = Array.from(selectedAiLanguages);
            const targetLangs = langsArray.length > 0 ? langsArray.join(',') : 'Vietnamese';
            formData.append('targetLanguages', targetLangs);

            console.log("-> Đang gửi yêu cầu dịch sang:", targetLangs);

            function appendFileSafe(elemId, formKey) {
                const elem = document.getElementById(elemId);
                if (elem && elem.files && elem.files.length > 0) {
                    formData.append(formKey, elem.files[0]);
                }
            }

            appendFileSafe('fileVietnamese', 'fileVietnamese');
            appendFileSafe('fileChinese', 'fileChinese');
            appendFileSafe('fileJapanese', 'fileJapanese');
            appendFileSafe('fileFrench', 'fileFrench');

            const $btn = $(this);$btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-2"></i> Đang gửi...');

            $.ajax({
                url: '/Admin/tblParagraphs/EnqueueImportAi',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        showToast(res.message || 'Đã xếp hàng xử lý ngầm!', 'info');
                        if (typeof closeParagraphModal === 'function') closeParagraphModal();

                        if (res.jobId) {
                            pollHangfireJob(res.jobId, storyId, chapId);
                        } else {
                            setTimeout(() => { loadParagraphList(1); }, 3000);
                        }
                    } else {
                        showToast(res.message || 'Lỗi khi gửi dữ liệu!', 'error');
                    }
                },
                error: function (xhr) {
                    console.error("Lỗi Import:", xhr.responseText);
                    const msg = xhr.responseJSON ? xhr.responseJSON.message : 'Có lỗi khi kết nối tới Server!';
                    showToast(msg, 'error');
                },
                complete: function () {
                    $btn.prop('disabled', false).html('Confirm Import');
                }
            });
        });

        // 2. Cập nhật hàm pollHangfireJob: Hiển thị thanh tiến trình cố định và khóa cảnh báo F5
        function pollHangfireJob(jobId, storyId, chapId) {
            const $overlay =$('#aiProcessingOverlay');
            const $msg =$('#aiProcessingMessage');

            // 1. Hiện popup thông báo tiến trình ngầm
            $overlay.removeClass('hidden');
            setTimeout(() => {
                $overlay.removeClass('translate-y-10 opacity-0').addClass('translate-y-0 opacity-100');
            }, 50);

            // 2. Kích hoạt cảnh báo trình duyệt nếu người dùng cố ý F5 hoặc tắt tab
            const preventUnload = function (e) {
                e.preventDefault();
                e.returnValue = 'Hệ thống đang xử lý dịch ngầm, bạn có chắc muốn rời đi?';
                return e.returnValue;
            };
            window.addEventListener('beforeunload', preventUnload);

            // Helper đóng popup khi xong
            function hideProcessingOverlay() {
                window.removeEventListener('beforeunload', preventUnload); // Gỡ chặn F5
                $overlay.removeClass('translate-y-0 opacity-100').addClass('translate-y-10 opacity-0');
                setTimeout(() => {
                    $overlay.addClass('hidden');
                }, 300);
            }

            const intervalId = setInterval(function () {
                $.get('/Admin/tblParagraphs/CheckJobStatus', { jobId: jobId }, function (statusRes) {
                    if (statusRes.completed) {
                        clearInterval(intervalId);
                        hideProcessingOverlay();

                        if (statusRes.state === 'Failed') {
                            showToast('Xử lý thất bại! Vui lòng kiểm tra log Hangfire.', 'error');
                        } else {
                            showToast('Đã phân tích và dịch thành công toàn bộ chương!', 'success');

                            // Đồng bộ dropdown Truyện bên ngoài
                            $('#filterStory').val(storyId).trigger('change.select2');

                            // Tải danh sách Chapter của Truyện và chọn đúng Chapter vừa import
                            $.get('/Admin/tblParagraphs/GetChaptersForSelect', { id: storyId }, function (data) {
                                const $chapter =$('#filterChapter');
                                $chapter.html('<option value="all">Chapter</option>');

                                data.forEach(c => {
                                    $chapter.append(`<option value="${c.id}">${c.name}</option>`);
                                });

                                $chapter.val(chapId).trigger('change.select2');

                                // Nạp ngay danh sách các câu đã import
                                currentPage = 1;
                                loadParagraphList(1);
                            });
                        }
                    } else {
                        // Cập nhật trạng thái nhẹ nhàng nếu đang chạy
                        if (statusRes.state === 'Processing') {
                            $msg.text('AI đang dịch từng đợt câu... Dữ liệu đang được đồng bộ.');
                        }
                    }
                }).fail(function () {
                    clearInterval(intervalId);
                    hideProcessingOverlay();
                    showToast('Mất kết nối kiểm tra tiến trình!', 'error');
                });
            }, 2500);
        }

        function resetImportForm() {
            $('#storySelect').val('');
            $('#chapterSelect').val('');

            $('#fileEnglish').val('');
            $('#fileVietnamese').val('');
            $('#fileChinese').val('');
            $('#fileJapanese').val('');
            $('#fileFrench').val('');

            $('#fileStatusEN').text('Tải file Tiếng Anh lên...');
            $('#fileStatusVN').text('Chọn hoặc thả file VN...');
            $('#fileStatusZH').text('Chọn hoặc thả file ZH...');
            $('#fileStatusJA').text('Chọn hoặc thả file JA...');
            $('#fileStatusFR').text('Chọn hoặc thả file FR...');

            $('.ai-btn')
                .prop('disabled', true)
                .addClass('opacity-40 cursor-not-allowed')
                .removeClass('ring-2 ring-purple-500 from-purple-600 to-indigo-600')
                .addClass('from-[#50C9C3] to-[#96DEDA]')
                .data('active', false)
                .find('.ai-label').text('AI Dịch từ file Tiếng Anh');

            selectedAiLanguages.clear();
            selectedAiLanguages.add('Vietnamese');
        }
</script>

