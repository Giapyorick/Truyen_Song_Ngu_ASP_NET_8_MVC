            async function safeConfirm(message, title = "Xác nhận") {
            if (typeof customConfirm === 'function') {
                try {
                    return await customConfirm(message, title);
                } catch (e) {
                    console.warn("customConfirm bị lỗi, chuyển sang confirm mặc định:", e);
                }
            }
            // Lọc sạch thẻ HTML nếu dùng confirm mặc định của trình duyệt
            const textOnly = message.replace(/<[^>]*>?/gm, '');
            return window.confirm(textOnly);
        }
