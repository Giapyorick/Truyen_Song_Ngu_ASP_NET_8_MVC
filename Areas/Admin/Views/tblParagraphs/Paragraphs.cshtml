<script>
function generateAI(targetLang) {
    let fileInput = $('#fileEnglish')[0];

    if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
        showToast('Vui lòng chọn file Tiếng Anh trước!', 'error');
        return;
    }

    let fileEN = fileInput.files[0];

    // Xác định nút bấm AI vừa click để hiện hiệu ứng xoay (loading)
    let $btn = $(event.currentTarget);
    let originalText = $btn.html();
    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang dịch...');

    let formData = new FormData();
    formData.append('fileEnglish', fileEN);
    formData.append('targetLanguage', targetLang);

    showToast(`Đang gửi file sang Gemini AI để dịch sang ${targetLang}...`, 'info');

    $.ajax({
        url: '/Admin/tblParagraphs/TranslateEnglishFileWithAI',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function(res) {
            console.log("Kết quả từ Server:", res); // In ra console F12 để kiểm tra

            if (res.success && res.translatedData) {
                // Tạo file .txt ảo chứa nội dung AI đã dịch
                let contentText = res.translatedData.join('\n');
                let blob = new Blob([contentText], { type: 'text/plain;charset=utf-8' });
                let generatedFile = new File([blob], `AI_${targetLang}.txt`, { type: 'text/plain' });

                // Map file vừa tạo vào Input của ngôn ngữ đó
                let inputMap = {
                    'Vietnamese': { input: '#fileVietnamese', status: '#fileStatusVN' },
                    'Chinese': { input: '#fileChinese', status: '#fileStatusZH' },
                    'Japanese': { input: '#fileJapanese', status: '#fileStatusJA' },
                    'French': { input: '#fileFrench', status: '#fileStatusFR' }
                };

                let targetUI = inputMap[targetLang];
                if (targetUI) {
                    let container = new DataTransfer();
                    container.items.add(generatedFile);
                    $(targetUI.input)[0].files = container.files;

                    // Hiển thị tên file AI vừa sinh lên giao diện
                    $(targetUI.status).html(`<span class="text-purple-600 font-bold">✨ AI_${targetLang}.txt</span>`);
                }

                showToast(res.message || `Đã dịch xong sang ${targetLang}!`, 'success');
            } else {
                showToast(res.message || 'AI không thể dịch file này!', 'error');
            }
        },
        error: function(xhr, status, error) {
            console.error("Lỗi AJAX AI:", xhr.responseText);
            let msg = xhr.responseJSON ? xhr.responseJSON.message : 'Có lỗi khi kết nối tới Server AI!';
            showToast(msg, 'error');
        },
        complete: function() {
            // Khôi phục trạng thái nút bấm
            $btn.prop('disabled', false).html(originalText);
        }
    });
}
</script>

