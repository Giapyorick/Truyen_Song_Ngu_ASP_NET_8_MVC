@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
<script>
        // =========================================================
        // XỬ LÝ CHÈN ĐOẠN VĂN MỚI (INSERT AFTER)
        // =========================================================

        // 1. Mở modal và nạp danh sách ngôn ngữ khả dụng của truyện
        async function openInsertParagraphModal(chapterId, targetOrder) {
            if (!chapterId || chapterId <= 0) {
                showToast('Chưa chọn Chapter hợp lệ!', 'error');
                return;
            }

            $('#insertChapterId').val(chapterId);
            $('#insertTargetOrder').val(targetOrder);
            $('#lblInsertTargetOrder').text(`#${targetOrder}`);
            $('#insertBlockType').val('1');

            const $modal =$('#insertParagraphModal');
            const $content =$('#insertModalContent');
            const $container =$('#insertDynamicLanguages');

            $container.html(`
                <div class="text-center py-6 text-gray-400 text-xs">
                    <i class="fa-solid fa-spinner fa-spin mr-1"></i> Đang tải cấu hình ngôn ngữ khả dụng...
                </div>
            `);

            $modal.removeClass('hidden').addClass('flex');
            setTimeout(() => {
                $content.removeClass('scale-95 opacity-0').addClass('scale-100 opacity-100');
            }, 10);

            try {
                const res = await fetch(`/Admin/tblParagraphs/GetAvailableLanguages?chapterId=${chapterId}`);
                const data = await res.json();

                if (data.success && data.languages && data.languages.length > 0) {
                    let html = '';
                    data.languages.forEach(lang => {
                        // Chuẩn hóa mã định danh về 2 ký tự: en, vi, zh, ja, fr
                        let raw = (lang.rawCode || lang.code || '').toLowerCase();
                        let key = 'en';
                        if (raw.includes('vi')) key = 'vi';
                        else if (raw.includes('zh') || raw.includes('cn')) key = 'zh';
                        else if (raw.includes('ja') || raw.includes('jp')) key = 'ja';
                        else if (raw.includes('fr')) key = 'fr';

                        html += `
                            <div class="p-3 bg-teal-50/20 border border-teal-100 rounded-2xl space-y-1.5">
                                <div class="flex justify-between items-center">
                                    <label class="text-xs font-bold text-gray-700 flex items-center gap-1.5">
                                        <span class="px-2 py-0.5 rounded bg-teal-600 text-white text-[10px] font-extrabold uppercase">
                                            ${key}
                                        </span>
                                        ${lang.name}
                                    </label>
                                    <span class="text-[10px] text-red-500 font-bold">* Bắt buộc</span>
                                </div>
                                <textarea id="insert_input_${key}"
                                          class="w-full px-3 py-2 bg-white border border-gray-200 focus:border-teal-500 rounded-xl text-xs outline-none transition resize-none"
                                          rows="2"
                                          placeholder="Nhập nội dung cho ${lang.name}..."></textarea>
                            </div>
                        `;
                    });
                    $container.html(html);
                } else {
                    $container.html(`
                        <div class="text-center py-4 text-amber-600 text-xs font-semibold">
                            Không tìm thấy cấu hình ngôn ngữ khả dụng cho truyện này.
                        </div>
                    `);
                }
            } catch (e) {
                $container.html(`
                    <div class="text-center py-4 text-red-500 text-xs">
                        Không thể tải danh sách ngôn ngữ: ${e.message}
                    </div>
                `);
            }
        }

        // 2. Đóng modal chèn đoạn
        function closeInsertParagraphModal() {
            const $modal =$('#insertParagraphModal');
            const $content =$('#insertModalContent');

            $content.removeClass('scale-100 opacity-100').addClass('scale-95 opacity-0');
            setTimeout(() => {
                $modal.removeClass('flex').addClass('hidden');
            }, 250);
        }

        // 3. Kích hoạt chèn ngay khi đang ở Side Panel của Editor
        function insertFromCurrentEditorIndex() {
            if (currentEditingIndex === -1 || !chapterEditorParagraphs[currentEditingIndex]) {
                showToast('Vui lòng chọn một câu để chèn phía sau!', 'error');
                return;
            }
            const targetPara = chapterEditorParagraphs[currentEditingIndex];
            openInsertParagraphModal(chapterEditorData.chapterId, targetPara.paragraphOrder);
        }

        // 4. Gửi dữ liệu chèn lên Server
        async function submitInsertParagraph() {
            const chapterId = parseInt($('#insertChapterId').val());
            const targetOrder = parseInt($('#insertTargetOrder').val());
            const blockType = parseInt($('#insertBlockType').val() || 1);

            // Đọc trực tiếp từ ID của từng ô
            const enText = ($('#insert_input_en').val() || '').trim();
            const vnText = ($('#insert_input_vi').val() || '').trim();
            const zhText = ($('#insert_input_zh').val() || '').trim();
            const jaText = ($('#insert_input_ja').val() || '').trim();
            const frText = ($('#insert_input_fr').val() || '').trim();

            const payload = {
                ChapterId: chapterId,
                TargetOrder: targetOrder,
                BlockType: blockType,
                English: enText,
                Vietnamese: vnText,
                Chinese: zhText,
                Japanese: jaText,
                French: frText
            };

            console.log("Dữ liệu gửi lên Server:", payload);

            // Kiểm tra 2 trường bắt buộc
            if (!payload.English || !payload.Vietnamese) {
                showToast("Tiếng Anh và Tiếng Việt không được để trống!", "error");
                return;
            }

            const $btn = $('#btnConfirmInsertParagraph');
            $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Đang lưu...');

            try {
                const res = await fetch('/Admin/tblParagraphs/InsertAfter', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    closeInsertParagraphModal();

                    if (typeof loadParagraphList === 'function') {
                        loadParagraphList(currentPage);
                    }
                    if (!$('#chapterEditorModal').hasClass('hidden') && chapterEditorData) {
                        openChapterEditor(chapterEditorData.chapterId);
                    }
                } else {
                    showToast(data.message || 'Lỗi khi lưu dữ liệu!', 'error');
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ: ' + err.message, 'error');
            } finally {
                $btn.prop('disabled', false).html('<i class="fa-solid fa-floppy-disk"></i> Lưu và Dồn STT');
            }
        }
</script>
<script>
        let quillEnglish;
        let quillVietnamese;
        let quillChinese;
        let quillJapanese;
        let quillFrench;

        const quillToolbar = [
            ['bold', 'italic', 'underline', 'strike'],        // Bôi đen, in nghiêng, gạch chân, gạch ngang
            [{ 'color': [] }, { 'background': [] }],          // Tô màu chữ, màu nền
            ['clean']                                         // Xóa định dạng về mặc định
        ];

        function initQuillEditors() {
            const commonModules = {
                toolbar: quillToolbar,
                keyboard: {
                    bindings: {
                        // Cấm phím Enter thông thường
                        enter: {
                            key: 'Enter',
                            handler: function() {
                                return false;
                            }
                        },
                        // Cấm tổ hợp Shift + Enter
                        shiftEnter: {
                            key: 'Enter',
                            shiftKey: true,
                            handler: function() {
                                return false;
                            }
                        }
                    }
                }
            };

            quillEnglish = new Quill('#paragraphEnglish', { theme: 'snow', modules: commonModules });
            quillVietnamese = new Quill('#paragraphVietnamese', { theme: 'snow', modules: commonModules });
            quillChinese = new Quill('#paragraphChinese', { theme: 'snow', modules: commonModules });
            quillJapanese = new Quill('#paragraphJapanese', { theme: 'snow', modules: commonModules });
            quillFrench = new Quill('#paragraphFrench', { theme: 'snow', modules: commonModules });
        }
</script>
<script>
        let sideQuill = null;
        let currentEditingIndex = -1;
        let currentSideTabLang = 'english';
        let modifiedParagraphsMap = new Map(); // Lưu trữ các câu đã bị sửa đổi

        // 1. Khởi tạo Quill riêng cho Side Panel (Cấm tuyệt đối Enter)
        function initSideQuillEditor() {
            if (sideQuill) return;

            sideQuill = new Quill('#sideQuillEditor', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'color': [] }, { 'background': [] }],
                        ['clean']
                    ],
                    keyboard: {
                        bindings: {
                            handleEnter: {
                                key: 'Enter',
                                shiftKey: null,
                                handler: function() { return false; }
                            }
                        }
                    }
                }
            });

            // Chặn Enter tầng DOM cứng
            if (sideQuill.root) {
                sideQuill.root.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.keyCode === 13) {
                        e.preventDefault();
                        return false;
                    }
                }, true);
            }

            // LẮNG NGHE SỰ KIỆN GÕ CHỮ ĐỂ UPDATE REAL-TIME
            sideQuill.on('text-change', function(delta, oldDelta, source) {
                if (source !== 'user' || currentEditingIndex === -1) return;

                const currentPara = chapterEditorParagraphs[currentEditingIndex];
                if (!currentPara) return;

                // Bóc tách làm sạch thẻ <p>
                let cleanHtml = normalizeQuillHtml(sideQuill.root.innerHTML) || '';

                // Cập nhật bộ nhớ tạm
                currentPara[currentSideTabLang] = cleanHtml;
                markParagraphAsModified(currentPara);

                // NẾU NGÔN NGỮ ĐANG SỬA TRÙNG VỚI NGÔN NGỮ ĐANG ĐỌC -> UPDATE NGAY DOM LẬP TỨC
                if (currentSideTabLang.toLowerCase() === currentEditorLanguage.toLowerCase()) {
                    renderChapterEditor(); // Render lại reader tức thì
                    // Giữ outline cho câu đang sửa
                    $(`.editor-reader-paragraph[data-paragraph-index="${currentEditingIndex}"]`).addClass('editing-live');
                }
            });
        }

        // 2. Mở Side Panel khi click chọn câu ở Reader
        function openChapterSidePanel(index) {
            currentEditingIndex = index;
            const paragraph = chapterEditorParagraphs[index];
            if (!paragraph) return;

            initSideQuillEditor();

            $('#sideEditorEmptyState').addClass('hidden');
            $('#sideEditorFormWrapper').removeClass('hidden');
            $('#chapterEditorSidePanel').removeClass('hidden').addClass('open');

            // Gán số thứ tự câu
            $('#sidePanelParagraphNumber').text(`#${String(paragraph.paragraphOrder).padStart(3, '0')}`);

            // Gán BlockType
            const bType = paragraph.blockType !== undefined && paragraph.blockType !== null 
                          ? String(paragraph.blockType) 
                          : "1";

            $('#sidePanelBlockType').val(bType).trigger('change');

            // Đồng bộ tab đang active theo ngôn ngữ đang đọc
            updateActiveEditorLanguageTab();

            // Nạp nội dung của câu theo ĐÚNG ngôn ngữ đang đọc vào Quill
            if (sideQuill) {
                const textValue = paragraph[currentEditorLanguage] || '';
                sideQuill.root.innerHTML = textValue;
            }

            // Highlight câu được chọn ở khung đọc
            $('.editor-reader-paragraph').removeClass('editing-live active');
            $(`.editor-reader-paragraph[data-paragraph-index="${index}"]`).addClass('active editing-live');
        }

        // 3. Chuyển đổi ngôn ngữ soạn thảo trong Side Panel
        function switchSidePanelTab(lang) {
            currentSideTabLang = lang;

            // Active UI tabs
            $('#sidePanelLangTabs button').removeClass('bg-teal-50 text-teal-700 font-bold').addClass('text-gray-400 font-semibold');
            $(`#sideTab_${lang}`).addClass('bg-teal-50 text-teal-700 font-bold').removeClass('text-gray-400 font-semibold');
            $('#sideCurrentLangLabel').text(lang);

            // Nạp dữ liệu vào Quill mà không kích hoạt sự kiện 'user'
            const paragraph = chapterEditorParagraphs[currentEditingIndex];
            if (paragraph && sideQuill) {
                const textValue = paragraph[lang] || '';
                sideQuill.root.innerHTML = textValue;
            }
        }

        // 4. Khi thay đổi BlockType -> Cập nhật hiển thị Reader ngay lập tức
        function onSidePanelBlockTypeChange(newVal) {
            if (currentEditingIndex === -1) return;
            const paragraph = chapterEditorParagraphs[currentEditingIndex];
            if (!paragraph) return;

            paragraph.blockType = parseInt(newVal);
            markParagraphAsModified(paragraph);

            // Render lại reader để ngắt đoạn/thụt dòng tức thời
            renderChapterEditor();
            $(`.editor-reader-paragraph[data-paragraph-index="${currentEditingIndex}"]`).addClass('editing-live active');
        }

        // 5. Quản lý trạng thái sửa đổi & Nút Save Changes
        function markParagraphAsModified(paragraph) {
            modifiedParagraphsMap.set(paragraph.paragraphId, paragraph);

            // Bật nút Save ở Footer & hiển thị số lượng câu đã sửa
            const count = modifiedParagraphsMap.size;
            $('#chapterEditorSaveButton').prop('disabled', false);
            $('#chapterModifiedInfo').removeClass('hidden');
            $('#chapterModifiedCount').text(`${count} modified`);
        }

        function closeChapterSidePanel() {
            // Đóng side panel
            $('#chapterEditorSidePanel').removeClass('open').addClass('hidden');
            $('#sideEditorFormWrapper').addClass('hidden');
            $('#sideEditorEmptyState').removeClass('hidden');

            $('.editor-reader-paragraph').removeClass('editing-live active');
            currentEditingIndex = -1;
        }

        // 6. Gán sự kiện cho nút Save Changes ở Footer
        $(document).on('click', '#chapterEditorSaveButton', function() {
            if (modifiedParagraphsMap.size === 0) return;

            const modifiedList = Array.from(modifiedParagraphsMap.values()).map(p => ({
                ParagraphId: p.paragraphId,
                ParagraphOrder: p.paragraphOrder,
                ChapterId: chapterEditorData.chapterId,
                English: p.english,
                Vietnamese: p.vietnamese,
                Chinese: p.chinese,
                Japanese: p.japanese,
                French: p.french,
                BlockType: p.blockType
            }));

            const $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i> Saving...');

            // Gửi mảng danh sách cập nhật về Server
            $.ajax({
                url: '/Admin/tblParagraphs/UpdateMultipleFromEditor',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(modifiedList),
                success: function(res) {
                    if (res.success) {
                        showToast('Đã lưu thành công các thay đổi!', 'success');
                        modifiedParagraphsMap.clear();
                        $('#chapterModifiedInfo').addClass('hidden');
                        $btn.prop('disabled', true).html('<i class="fa-solid fa-save"></i> <span>Save Changes</span>');
                        // Tải lại bảng danh sách ngoài nếu có
                        if (typeof loadParagraphList === 'function') loadParagraphList(currentPage);
                    } else {
                        showToast(res.message || 'Lỗi khi lưu dữ liệu!', 'error');
                        $btn.prop('disabled', false).html('<i class="fa-solid fa-save"></i> <span>Save Changes</span>');
                    }
                },
                error: function() {
                    showToast('Không thể kết nối đến máy chủ!', 'error');
                    $btn.prop('disabled', false).html('<i class="fa-solid fa-save"></i> <span>Save Changes</span>');
                }
            });
        });
</script>
