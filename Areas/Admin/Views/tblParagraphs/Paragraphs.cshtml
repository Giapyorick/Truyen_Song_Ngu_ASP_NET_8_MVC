    $(document).on('click', '#btnDeleteSelected', async function () {
        const ids = $('.user-checkbox:checked')
            .map(function () {
                return parseInt(this.value);
            })
            .get();

        if (ids.length === 0) {
            showToast('Please select at least one chapter!', 'error');
            return;
        }

        const confirmed = await customConfirm(
		`Are you sure you want to delete <strong>${ids.length}</strong> paragraphs ?<br>` +
		`<small class="text-red-400">This action cannot be undone.</small>`,
		"Delete Multiple"
		);

		if (!confirmed) return;

        $.ajax({
            url: '/Admin/tblParagraphs/DeleteMultiple',
            type: 'POST',
            traditional: true,
            data: { ids: ids },
            success: function (res) {
				if (res.blocked && res.blocked.length > 0) {
					showToast(
						`Cannot delete this ID: ${res.blocked.join(', ')}\n` +
						`Because it was used to link foreign keys.`, 
						'error'
					);
				}
				if (res.deleted && res.deleted.length > 0) {
					showToast(`Deleted ${res.deleted.length} paragraph.`, 'error');
				}
				const savedPage = localStorage.getItem('storyPage');
				currentPage = savedPage ? parseInt(savedPage) : 1;
				loadParagraphList(); 
				$('#selectAll').prop('checked', false);
			}

