@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" >
<link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.snow.css" rel="stylesheet">

<main class="flex-1 flex flex-col overflow-y-auto">
	<div class="space-y-10 m-10">
		<div class="flex flex-col items-center gap-4">
		<h2 class="text-2xl font-bold text-cus tracking-tight">
			Paragraphs Management
		</h2>
	</div>
    <div class="bg-white rounded-[2rem] shadow-xl shadow-gray-200/50 border border-gray-100 overflow-hidden">
        
        <div class="p-6 border-b border-gray-50 flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="relative w-40 sm:w-64">
                <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" id="filterSearch" placeholder="Search by vietnamese..." class="w-full pl-11 pr-4 py-2.5 bg-gray-200 border border-transparent focus:border-purple-300 focus:bg-white rounded-xl outline-none transition-all text-sm">
            </div>
			<div class="w-60">
				<select id="filterStory" class="select2-custom w-full mt-1 p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none shadow-sm">

					<option data-color="linear-gradient(to right, #50C9C3 0%, #96DEDA  51%, #50C9C3  100%)" value="all">Stories</option>
				</select>
			</div>
			<div class="w-60">
				<select id="filterChapter" class="select2-custom w-full mt-1 p-2.5 bg-gray-50 border border-gray-200 rounded-xl outline-none shadow-sm">

					<option data-color="linear-gradient(to bottom, rgba(255,255,255,0.15) 0%, rgba(0,0,0,0.15) 100%), radial-gradient(at top center, rgba(255,255,255,0.40) 0%, rgba(0,0,0,0.40) 120%) #989898;" value="all">Chapter</option>
				</select>
			</div>
            <div class="flex items-center gap-4">
				
                <button onclick="exportExcel()" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300"><i class="fas fa-file-export mr-2"></i>Export</button>
				<button onclick="openParagraphModal()" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300"><i class="fas fa-file-import mr-2"></i>Import</button>
				<button id="btnDeleteSelected" class="flex text-xs items-center justify-center px-6 py-3 btn-grad text-white rounded-2xl shadow-lg shadow-indigo-100 hover:shadow-indigo-300 hover:-translate-y-1 transition-all duration-300"><i class="fas fa-trash-alt mr-2"></i>Delete</button>
            </div>
        </div>

       <div class="overflow-x-auto">
            <table class="min-w-max text-left border-collapse">
				<thead>
					<tr class="bg-gray-50/50 text-gray-400 text-[11px] uppercase tracking-[0.15em] border-b border-gray-100">
						<th class="px-6 py-4 w-10">
							<div class="flex items-center justify-center">
								<input type="checkbox" id="selectAll" class="w-5 h-5 rounded-md border-gray-300 text-purple-600 focus:ring-purple-500 cursor-pointer transition-all">
							</div>
						</th>
						<th class="px-4 py-4 text-gray font-bold text-left">Information</th>
                        <th class="px-6 py-4 text-gray font-bold text-left">Order</th>
						<th class="px-6 py-4 text-gray font-bold text-left">English</th>
						<th class="px-6 py-4 text-gray font-bold text-left">Vietnamese</th>
                        <th class="px-6 py-4 text-gray font-bold text-left">Chinese</th>
                        <th class="px-6 py-4 text-gray font-bold text-left">Japanese</th>
                        <th class="px-6 py-4 text-gray font-bold text-left">French</th>
						<th class="px-8 py-4 text-gray font-bold text-right">Actions</th>
					</tr>
				</thead>
				<tbody id="user-list-body" class="divide-y divide-gray-50">

    			</tbody>
			</table>
			
        </div>
		<div id="pagination-container" class="flex justify-center items-center gap-2 py-4"></div>
    </div>
</div>
</main>

@* MODAL CRUD PARAGRAPH *@
<div id="modalOverlay"
     class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[99] transition-all duration-500">

    <div id="modalContent"
         class="bg-white w-full max-w-5xl rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-20 opacity-0 transition-all duration-500 ease-out">

        @* HEADER *@
        <div class="p-8 border-b border-gray-50 relative mx-5 mt-0 mb-0 bg-gradient-to-r from-gray-50 to-white">

            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center">
                <h3 id="modalTitle"
                    class="text-xl font-extrabold text-cus">
                    Edit Paragraph
                </h3>

                <p class="text-xs text-gray-400 mt-1">
                    Please fill in all information
                </p>
            </div>

            <button type="button"
                    onclick="closeModal()"
                    class="absolute right-6 top-6 w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-red-50 hover:text-red-500 transition-all text-2xl">
                &times;
            </button>
        </div>


        @* FORM *@
        <form id="paragraphForm"
              class="p-8 space-y-6 max-h-[70vh] overflow-y-auto">

            @* Hidden *@
            <input type="hidden"
                   name="ParagraphId"
                   id="paragraphId"
                   value="0">

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                @* =========================
                   LEFT / MAIN CONTENT
                   ========================= *@
                <div class="md:col-span-2 space-y-6">

                    @* Chapter *@
                    <div class="space-y-1">

                        <label class="text-[11px] font-bold text-cus uppercase ml-1">
                            Chapter
                        </label>

                        <select name="ChapterId"
                                id="paragraphChapterId"
                                class="select2-custom w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all"
                                required>
                        </select>

                    </div>


                    @* Paragraph Order *@
                    <div class="space-y-1">

                        <label class="text-[11px] font-bold text-cus uppercase ml-1">
                            Paragraph Order
                        </label>

                        <input type="number"
                               name="ParagraphOrder"
                               id="paragraphOrder"
                               min="1"
                               class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all"
                               required>

                    </div>


                    @* =========================
                       LANGUAGE TABS
                       ========================= *@

                    <div class="space-y-4">

                        <div class="flex gap-2 border-b border-gray-200">

                            <button type="button"
                                    id="tabEnglish"
                                    onclick="switchParagraphLanguage('English')"
                                    class="paragraph-language-tab px-4 py-2 text-sm font-bold border-b-2 border-purple-500 text-purple-600">
                                🇺🇸 English
                            </button>

                            <button type="button"
                                    id="tabVietnamese"
                                    onclick="switchParagraphLanguage('Vietnamese')"
                                    class="paragraph-language-tab px-4 py-2 text-sm font-bold text-gray-400">
                                🇻🇳 Vietnamese
                            </button>

                            <button type="button"
                                    id="tabChinese"
                                    onclick="switchParagraphLanguage('Chinese')"
                                    class="paragraph-language-tab px-4 py-2 text-sm font-bold text-gray-400">
                                🇨🇳 Chinese
                            </button>

                            <button type="button"
                                    id="tabJapanese"
                                    onclick="switchParagraphLanguage('Japanese')"
                                    class="paragraph-language-tab px-4 py-2 text-sm font-bold text-gray-400">
                                🇯🇵 Japanese
                            </button>

                            <button type="button"
                                    id="tabFrench"
                                    onclick="switchParagraphLanguage('French')"
                                    class="paragraph-language-tab px-4 py-2 text-sm font-bold text-gray-400">
                                🇫🇷 French
                            </button>

                        </div>


                        @* English *@
                        <div id="paragraphLanguageEnglish"
                             class="paragraph-language-content">

                            <label class="text-[11px] font-bold text-cus uppercase ml-1">
                                English
                            </label>
                            <div id="paragraphEnglish" class="paragraph-editor"></div>
                            <input type="hidden" name="English" id="paragraphEnglishValue">
                        </div>


                        @* Vietnamese *@
                        <div id="paragraphLanguageVietnamese"
                             class="paragraph-language-content hidden">

                            <label class="text-[11px] font-bold text-cus uppercase ml-1">
                                Vietnamese
                            </label>
                            <div id="paragraphVietnamese" class="paragraph-editor"></div>
                            <input type="hidden" name="Vietnamese" id="paragraphVietnameseValue">
                        </div>


                        @* Chinese *@
                        <div id="paragraphLanguageChinese"
                             class="paragraph-language-content hidden">

                            <label class="text-[11px] font-bold text-cus uppercase ml-1">
                                Chinese
                            </label>
                            <div id="paragraphChinese" class="paragraph-editor"></div>
                            <input type="hidden" name="Chinese" id="paragraphChineseValue">
                        </div>


                        @* Japanese *@
                        <div id="paragraphLanguageJapanese"
                             class="paragraph-language-content hidden">

                            <label class="text-[11px] font-bold text-cus uppercase ml-1">
                                Japanese
                            </label>
                            <div id="paragraphJapanese" class="paragraph-editor"></div>
                            <input type="hidden" name="Japanese" id="paragraphJapaneseValue">
                        </div>


                        @* French *@
                        <div id="paragraphLanguageFrench"
                             class="paragraph-language-content hidden">

                            <label class="text-[11px] font-bold text-cus uppercase ml-1">
                                French
                            </label>
                            <div id="paragraphFrench" class="paragraph-editor"></div>
                            <input type="hidden" name="French" id="paragraphFrenchValue">
                        </div>

                    </div>

                </div>


                @* =========================
                   RIGHT SIDE
                   ========================= *@
                <div class="space-y-4">

                    <div class="p-5 bg-gray-50 rounded-2xl border border-gray-100">

                        <div class="text-xs font-bold text-cus uppercase mb-3">
                            Paragraph Information
                        </div>

                        <div class="space-y-3 text-sm text-gray-500">

                            <div>
                                <span class="font-semibold">
                                    Paragraph ID:
                                </span>

                                <span id="displayParagraphId">
                                    New
                                </span>
                            </div>

                            <div>
                                <span class="font-semibold">
                                    Chapter:
                                </span>

                                <span id="displayChapterName">
                                    -
                                </span>
                            </div>

                            <div>
                                <span class="font-semibold">
                                    Order:
                                </span>

                                <span id="displayParagraphOrder">
                                    -
                                </span>
                            </div>

                        </div>

                    </div>


                    <div class="p-5 bg-purple-50 rounded-2xl border border-purple-100">

                        <div class="text-xs font-bold text-purple-600 uppercase mb-2">
                            Note
                        </div>

                        <p class="text-xs text-gray-500 leading-relaxed">
                            You can enter the paragraph content in multiple
                            languages. Rich text formatting will be added
                            in the next step.
                        </p>

                    </div>

                </div>

            </div>


            @* BUTTONS *@
            <div class="pt-6 flex gap-4">

                <button type="button"
                        onclick="closeModal()"
                        class="flex-[2] py-3 btn-grad-cancel text-white rounded-xl font-bold shadow-lg hover:shadow-indigo-200/50 active:scale-95 transition-all duration-300">
                    Cancel
                </button>

                <button type="submit"
                        id="btnSave"
                        class="flex-[2] py-3 btn-grad text-white rounded-xl font-bold shadow-lg hover:shadow-indigo-200/50 active:scale-95 transition-all duration-300">
                    Save Changes
                </button>

            </div>

        </form>

    </div>
</div>


@*MODAL IMPORT PARAGRAPHS WITH AI GENERATE*@
<div id="importParagraphModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm transition-all duration-300">
    <div id="importContent" class="bg-white w-full max-w-4xl rounded-3xl shadow-2xl flex flex-col max-h-[90vh] transform scale-95 opacity-0 transition-all duration-300">

        <!-- Header -->
        <div class="px-8 py-5 border-b border-teal-100/60 flex justify-between items-center">
            <div>
                <h3 class="text-2xl font-bold text-cus">Import Paragraphs</h3>
                <p class="text-xs text-gray-500 mt-0.5">Tải file Tiếng Anh lên để kích hoạt AI dịch sang các ngôn ngữ khác</p>
            </div>
            <button onclick="closeParagraphModal()" class="text-gray-400 hover:text-teal-600 transition-colors p-2 rounded-full hover:bg-teal-50">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <!-- Body -->
        <div class="p-8 space-y-6 overflow-y-auto flex-1">
            <!-- Select Stories & Chapters -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-teal-50/30 p-4 rounded-2xl border border-teal-100">
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">Stories</label>
                    <select id="storySelect" class="w-full px-4 py-2.5 bg-white border border-teal-200 focus:border-[#50C9C3] focus:ring-1 focus:ring-[#50C9C3] rounded-xl outline-none transition-all text-sm font-medium">
                    </select>
                </div>
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">Chapters</label>
                    <select id="chapterSelect" class="w-full px-4 py-2.5 bg-white border border-teal-200 focus:border-[#50C9C3] focus:ring-1 focus:ring-[#50C9C3] rounded-xl outline-none transition-all text-sm font-medium">
                    </select>
                </div>
            </div>

            <!-- Danh sách Ngôn Ngữ -->
            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold text-cus uppercase tracking-wider">File ngôn ngữ nguồn & Bản dịch</span>
                    <span class="text-xs text-gray-400">Định dạng hỗ trợ: .xlsx, .xls, .txt (Max 5MB)</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                    <!-- 1. TIẾNG ANH (NGÔN NGỮ NGUỒN CHÍNH) -->
                    <div class="p-4 border-2 border-[#50C9C3] bg-teal-50/20 rounded-2xl space-y-3 relative">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-bold text-cus flex items-center gap-2">
                                🇺🇸 Tiếng Anh <span class="text-[10px] bg-gradient-to-r from-[#50C9C3] to-[#96DEDA] px-2.5 py-0.5 rounded-full font-semibold shadow-sm">File gốc</span>
                            </span>
                            <a href="/assets/template/Story_English_Template.xlsx" class="text-[11px] text-teal-600 hover:underline font-medium"><i class="fas fa-file-excel"></i> Template</a>
                        </div>

                        <div id="dropZoneEN" class="relative border-2 border-dashed border-teal-300 rounded-xl p-3 flex items-center justify-between bg-white hover:border-[#50C9C3] transition-all cursor-pointer group shadow-sm">
                            <input type="file" id="fileEnglish" name="fileEnglish" accept=".xlsx, .xls, .txt" class="absolute inset-0 opacity-0 cursor-pointer z-10">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-cloud-upload-alt text-[#50C9C3] text-lg group-hover:scale-110 transition-transform"></i>
                                <span id="fileStatusEN" class="text-xs font-semibold text-gray-600 truncate max-w-[150px]">Tải file Tiếng Anh lên...</span>
                            </div>
                            <span class="text-[10px] bg-gradient-to-r from-[#50C9C3] to-[#96DEDA] text-white px-3 py-1 rounded-md font-semibold shadow-sm">Browse</span>
                        </div>
                    </div>

                    <!-- 2. TIẾNG VIỆT -->
                    <div class="p-4 border border-teal-100 bg-teal-50/10 rounded-2xl space-y-3 hover:border-teal-200 transition-colors">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-bold text-cus flex items-center gap-2">🇻🇳 Tiếng Việt</span>
                            <a href="/assets/template/Story_Vietnamese_Template.xlsx" class="text-[11px] text-teal-600 hover:underline font-medium"><i class="fas fa-file-excel"></i> Template</a>
                        </div>
                        <div id="dropZoneVN" class="relative border-2 border-dashed border-teal-200 rounded-xl p-3 flex items-center justify-between bg-white hover:border-[#50C9C3] transition-all cursor-pointer group">
                            <input type="file" id="fileVietnamese" name="fileVietnamese" accept=".xlsx, .xls, .txt" class="absolute inset-0 opacity-0 cursor-pointer z-10">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-cloud-upload-alt text-teal-400 text-lg group-hover:scale-110 transition-transform"></i>
                                <span id="fileStatusVN" class="text-xs font-medium text-gray-600 truncate max-w-[150px]">Chọn hoặc thả file VN...</span>
                            </div>
                            <span class="text-[10px] bg-teal-50 text-teal-700 px-2.5 py-1 rounded-md font-semibold border border-teal-100">Browse</span>
                        </div>
                        <button type="button" onclick="generateAI('Vietnamese')" disabled class="ai-btn w-full py-2 px-3 bg-gradient-to-r from-[#50C9C3] to-[#96DEDA] hover:opacity-95 text-white rounded-xl text-xs font-semibold shadow-sm transition-all flex items-center justify-center gap-1.5 disabled:opacity-40 disabled:cursor-not-allowed hover:enabled:shadow-md active:scale-[0.99]">
                            <i class="fas fa-wand-magic-sparkles text-amber-300"></i> AI Dịch từ file Tiếng Anh
                        </button>
                    </div>

                    <!-- 3. TIẾNG TRUNG -->
                    <div class="p-4 border border-teal-100 bg-teal-50/10 rounded-2xl space-y-3 hover:border-teal-200 transition-colors">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-bold text-cus flex items-center gap-2">🇨🇳 Tiếng Trung</span>
                            <a href="/assets/template/Story_Chinese_Template.xlsx" class="text-[11px] text-teal-600 hover:underline font-medium"><i class="fas fa-file-excel"></i> Template</a>
                        </div>
                        <div id="dropZoneZH" class="relative border-2 border-dashed border-teal-200 rounded-xl p-3 flex items-center justify-between bg-white hover:border-[#50C9C3] transition-all cursor-pointer group">
                            <input type="file" id="fileChinese" name="fileChinese" accept=".xlsx, .xls, .txt" class="absolute inset-0 opacity-0 cursor-pointer z-10">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-cloud-upload-alt text-teal-400 text-lg group-hover:scale-110 transition-transform"></i>
                                <span id="fileStatusZH" class="text-xs font-medium text-gray-600 truncate max-w-[150px]">Chọn hoặc thả file CN...</span>
                            </div>
                            <span class="text-[10px] bg-teal-50 text-teal-700 px-2.5 py-1 rounded-md font-semibold border border-teal-100">Browse</span>
                        </div>
                        <button type="button" onclick="generateAI('Chinese')" disabled class="ai-btn w-full py-2 px-3 bg-gradient-to-r from-[#50C9C3] to-[#96DEDA] hover:opacity-95 text-white rounded-xl text-xs font-semibold shadow-sm transition-all flex items-center justify-center gap-1.5 disabled:opacity-40 disabled:cursor-not-allowed hover:enabled:shadow-md active:scale-[0.99]">
                            <i class="fas fa-wand-magic-sparkles text-amber-300"></i> AI Dịch từ file Tiếng Anh
                        </button>
                    </div>

                    <!-- 4. TIẾNG NHẬT -->
                    <div class="p-4 border border-teal-100 bg-teal-50/10 rounded-2xl space-y-3 hover:border-teal-200 transition-colors">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-bold text-cus flex items-center gap-2">🇯🇵 Tiếng Nhật</span>
                            <a href="/assets/template/Story_Japanese_Template.xlsx" class="text-[11px] text-teal-600 hover:underline font-medium"><i class="fas fa-file-excel"></i> Template</a>
                        </div>
                        <div id="dropZoneJA" class="relative border-2 border-dashed border-teal-200 rounded-xl p-3 flex items-center justify-between bg-white hover:border-[#50C9C3] transition-all cursor-pointer group">
                            <input type="file" id="fileJapanese" name="fileJapanese" accept=".xlsx, .xls, .txt" class="absolute inset-0 opacity-0 cursor-pointer z-10">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-cloud-upload-alt text-teal-400 text-lg group-hover:scale-110 transition-transform"></i>
                                <span id="fileStatusJA" class="text-xs font-medium text-gray-600 truncate max-w-[150px]">Chọn hoặc thả file JP...</span>
                            </div>
                            <span class="text-[10px] bg-teal-50 text-teal-700 px-2.5 py-1 rounded-md font-semibold border border-teal-100">Browse</span>
                        </div>
                        <button type="button" onclick="generateAI('Japanese')" disabled class="ai-btn w-full py-2 px-3 bg-gradient-to-r from-[#50C9C3] to-[#96DEDA] hover:opacity-95 text-white rounded-xl text-xs font-semibold shadow-sm transition-all flex items-center justify-center gap-1.5 disabled:opacity-40 disabled:cursor-not-allowed hover:enabled:shadow-md active:scale-[0.99]">
                            <i class="fas fa-wand-magic-sparkles text-amber-300"></i> AI Dịch từ file Tiếng Anh
                        </button>
                    </div>

                    <!-- 5. TIẾNG PHÁP -->
                    <div class="p-4 border border-cus bg-teal-50/10 rounded-2xl space-y-3 md:col-span-2 hover:border-teal-200 transition-colors">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-bold text-teal-900 flex items-center gap-2">🇫🇷 Tiếng Pháp</span>
                            <a href="/assets/template/Story_French_Template.xlsx" class="text-[11px] text-teal-600 hover:underline font-medium"><i class="fas fa-file-excel"></i> Template</a>
                        </div>
                        <div id="dropZoneFR" class="relative border-2 border-dashed border-teal-200 rounded-xl p-3 flex items-center justify-between bg-white hover:border-[#50C9C3] transition-all cursor-pointer group">
                            <input type="file" id="fileFrench" name="fileFrench" accept=".xlsx, .xls, .txt" class="absolute inset-0 opacity-0 cursor-pointer z-10">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-cloud-upload-alt text-teal-400 text-lg group-hover:scale-110 transition-transform"></i>
                                <span id="fileStatusFR" class="text-xs font-medium text-gray-600 truncate">Chọn hoặc thả file FR...</span>
                            </div>
                            <span class="text-[10px] bg-teal-50 text-teal-700 px-2.5 py-1 rounded-md font-semibold border border-teal-100">Browse</span>
                        </div>
                        <button type="button" onclick="generateAI('French')" disabled class="ai-btn w-full py-2 px-3 bg-gradient-to-r from-[#50C9C3] to-[#96DEDA] hover:opacity-95 text-white rounded-xl text-xs font-semibold shadow-sm transition-all flex items-center justify-center gap-1.5 disabled:opacity-40 disabled:cursor-not-allowed hover:enabled:shadow-md active:scale-[0.99]">
                            <i class="fas fa-wand-magic-sparkles text-amber-300"></i> AI Dịch từ file Tiếng Anh
                        </button>
                    </div>

                </div>
