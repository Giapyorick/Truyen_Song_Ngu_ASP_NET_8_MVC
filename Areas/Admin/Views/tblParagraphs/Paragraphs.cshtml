            const form = $('#paragraphForm')[0];

            if (form) {
                form.reset();
            }
            // Reset language visibility
            [
                'English',
                'Vietnamese',
                'Chinese',
                'Japanese',
                'French'
            ].forEach(function(language) {

                setLanguageVisibility(language, false);

            });
            // Reset Quill editors
            if (quillEnglish) {
                quillEnglish.setText('');
            }

            if (quillVietnamese) {
                quillVietnamese.setText('');
            }

            if (quillChinese) {
                quillChinese.setText('');
            }

            if (quillJapanese) {
                quillJapanese.setText('');
            }

            if (quillFrench) {
                quillFrench.setText('');
            }

            // Reset hidden values
            $('#paragraphEnglishValue').val('');
            $('#paragraphVietnameseValue').val('');
            $('#paragraphChineseValue').val('');
            $('#paragraphJapaneseValue').val('');
            $('#paragraphFrenchValue').val('');

            // Hiện modal
            modal
                .removeClass('hidden')
                .addClass('flex');

            // Select2
            $('.select2-custom').each(function() {

                if (!$(this).hasClass('select2-hidden-accessible')) {

                    $(this).select2({
                        dropdownParent: modal
                    });

                }

            });

            // Animation
            setTimeout(function() {

                $('#modalContent')
                    .removeClass('translate-y-20 opacity-0')
                    .addClass('translate-y-0 opacity-100');

            }, 10);

            // Load paragraph
            $.get('/Admin/tblParagraphs/GetById/' + id)
                .done(function(data) {

                    console.log('Paragraph data:', data);

                    // =========================
                    // Basic information
                    // =========================
                    $('#paragraphId').val(data.paragraphId);
                    $('#paragraphOrder').val(data.paragraphOrder);

                    $('#displayParagraphId').text(data.paragraphId);
                    $('#displayChapterName').text(data.chapter.chapterTitle || '-');
                    $('#displayParagraphOrder').text(data.paragraphOrder);

                    // =========================
                    // Load chapters
                    // =========================
                    $.get(
                        '/Admin/tblParagraphs/GetChaptersForSelect',
                        { id: data.chapter.storyId }
                    )
                        .done(function(chapters) {

                            const select = $('#paragraphChapterId');

                            select.empty();

                            chapters.forEach(function(x) {
                                select.append(
                                    `<option value="${x.id}">${x.name}</option>`
                                );
                            });

                            select
                                .val(data.chapter.chapterId)
                                .trigger('change');
                        });

                    // =========================
                    // Load languages
                    // =========================
                    const languages = [
                        { name: 'English', value: data.english, quill: quillEnglish },
                        { name: 'Vietnamese', value: data.vietnamese, quill: quillVietnamese },
                        { name: 'Chinese', value: data.chinese, quill: quillChinese },
                        { name: 'Japanese', value: data.japanese, quill: quillJapanese },
                        { name: 'French', value: data.french, quill: quillFrench }
                    ];

                    languages.forEach(function (lang) {
                        const exists = lang.value !== null;

                        setLanguageVisibility(lang.name, exists);
                        setLanguageInputState(lang.name, exists);

                        if (exists && lang.quill) {
                            lang.quill.root.innerHTML = lang.value;
                            $('#paragraph' + lang.name + 'Value').val(lang.value);
                        } else {
                            $('#paragraph' + lang.name + 'Value').val('');
                        }
                    });

                    // =========================
                    // Activate first available language
                    // =========================
                    const firstLanguage = languages.find(function(lang) {
                        return lang.value !== null;
                    });

                    if (firstLanguage) {
                        switchParagraphLanguage(firstLanguage.name);
                    }

                })
                .fail(function(xhr) {

                    console.error('GetById failed');
                    console.error('Status:', xhr.status);
                    console.error('Response:', xhr.responseText);

                    showToast(
                        'Cannot load paragraph information',
                        'error'
                    );
                });
        }
