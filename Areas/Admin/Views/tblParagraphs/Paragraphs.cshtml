    $(document).on('change', '.user-checkbox', function () {
        const total = $('.user-checkbox').length;
        const checked = $('.user-checkbox:checked').length;

        $(this)
            .closest('tr')
            .toggleClass('bg-indigo-50/50', this.checked);

        $('#selectAll').prop('checked', total > 0 && total === checked);
