@* MODAL IMPORT PARAGRAPH WITH AI *@
<div id="importParagraphModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm transition-all duration-300">
    <div id="importContent" class="bg-white w-full max-w-4xl rounded-3xl shadow-2xl flex flex-col max-h-[90vh] transform scale-95 opacity-0 transition-all duration-300">
        <div class="px-8 py-5 border-b border-teal-100/60 flex justify-between items-center">
            <div>
                <h3 class="text-2xl font-bold text-cus">Import Paragraphs with AI</h3>
                <p class="text-xs text-gray-500 mt-0.5">Upload English source file to translate into supported languages automatically</p>
            </div>
            <button onclick="closeParagraphModal()" class="text-gray-400 hover:text-teal-600 transition-colors p-2 rounded-full hover:bg-teal-50">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <div class="p-8 space-y-6 overflow-y-auto flex-1">
            <!-- Chọn Truyện & Chương -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-teal-50/30 p-4 rounded-2xl border border-teal-100">
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">Stories</label>
                    <select id="storySelect" class="w-full px-4 py-2.5 bg-white border border-teal-200 rounded-xl outline-none text-sm font-medium"></select>
                </div>
                <div class="space-y-1">
                    <label class="text-[11px] font-bold text-cus uppercase ml-1">Chapters</label>
                    <select id="chapterSelect" class="w-full px-4 py-2.5 bg-white border border-teal-200 rounded-xl outline-none text-sm font-medium"></select>
                </div>
            </div>

            <div>
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold text-cus uppercase tracking-wider">Source file & translation options</span>
                    <span class="text-xs text-gray-400">Supported: .xlsx, .xls, .txt (Max 5MB)</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- 1. CỐ ĐỊNH: NGUỒN TIẾNG ANH (BẮT BUỘC) -->
                    <div class="p-4 border-2 border-[#50C9C3] bg-teal-50/20 rounded-2xl space-y-3 relative flex flex-col justify-between">
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-bold text-cus flex items-center gap-2">
                                    🇺🇸 English <span class="text-[10px] bg-gradient-to-r from-[#50C9C3] to-[#96DEDA] px-2.5 py-0.5 text-white rounded-full font-semibold shadow-sm">Source</span>
                                </span>
                                <a href="/assets/template/Story_English_Template.xlsx" class="text-[11px] text-teal-600 hover:underline font-medium"><i class="fas fa-file-excel"></i> Template</a>
                            </div>

                            <div id="dropZoneEN" class="relative border-2 border-dashed border-teal-300 rounded-xl p-3 flex items-center justify-between bg-white hover:border-[#50C9C3] transition-all cursor-pointer group shadow-sm">
                                <input type="file" id="fileEnglish" name="fileEnglish" accept=".xlsx, .xls, .txt" class="absolute inset-0 opacity-0 cursor-pointer z-10">
                                <div class="flex items-center gap-3">
                                    <i class="fas fa-cloud-upload-alt text-[#50C9C3] text-lg group-hover:scale-110 transition-transform"></i>
                                    <span id="fileStatusEN" class="text-xs font-semibold text-gray-600 truncate max-w-[150px]">Upload English source file...</span>
                                </div>
                                <span class="text-[10px] bg-gradient-to-r from-[#50C9C3] to-[#96DEDA] text-white px-3 py-1 rounded-md font-semibold shadow-sm">Browse</span>
                            </div>
                        </div>
                        <div class="text-[11px] text-teal-700 bg-teal-100/50 px-3 py-2 rounded-xl flex items-center gap-1.5 font-medium">
                            <i class="fas fa-info-circle text-[#50C9C3]"></i> AI uses this file as the primary source to parse dialogues and classify BlockTypes
                        </div>
                    </div>

                    <!-- 2. CỐ ĐỊNH: ĐÍCH TIẾNG VIỆT (BẮT BUỘC) -->
                    <div id="card_lang_vietnamese" class="p-4 border border-teal-100 bg-teal-50/10 rounded-2xl space-y-3 hover:border-teal-200 transition-all flex flex-col justify-between">
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-bold text-cus flex items-center gap-2">
                                    🇻🇳 Vietnamese <span class="text-[10px] text-red-500 font-extrabold">* Required</span>
                                </span>
                                <a href="/assets/template/Story_Vietnamese_Template.xlsx" class="text-[11px] text-teal-600 hover:underline font-medium"><i class="fas fa-file-excel"></i> Template</a>
                            </div>
                            <div class="relative border-2 border-dashed border-teal-200 rounded-xl p-3 flex items-center justify-between bg-white hover:border-[#50C9C3] transition-all cursor-pointer group">
                                <input type="file" id="file_vietnamese" data-lang-key="vietnamese" accept=".xlsx, .xls, .txt" class="target-lang-file absolute inset-0 opacity-0 cursor-pointer z-10">
                                <div class="flex items-center gap-3">
                                    <i class="fas fa-cloud-upload-alt text-teal-400 text-lg group-hover:scale-110 transition-transform"></i>
                                    <span id="fileStatus_vietnamese" class="text-xs font-medium text-gray-600 truncate max-w-[150px]">Choose or drop file...</span>
                                </div>
                                <span class="text-[10px] bg-teal-50 text-teal-700 px-2.5 py-1 rounded-md font-semibold border border-teal-100">Browse</span>
                            </div>
                        </div>
                        <!-- Mặc định: data-active="false", chưa tick chọn AI -->
                        <button type="button" id="btnAi_vietnamese" onclick="toggleAutoAiTranslate('vietnamese', this)" disabled
                                class="ai-btn w-full py-2 px-3 rounded-xl text-xs font-semibold shadow-sm transition-all flex items-center justify-center gap-1.5 from-[#50C9C3] to-[#96DEDA] text-white bg-gradient-to-r opacity-40 cursor-not-allowed"
                                data-active="false">
                            <i class="fas fa-wand-magic-sparkles text-amber-300"></i> <span class="ai-label">AI Translate from English</span>
                        </button>
                    </div>

                    <!-- 3. KHUNG DÀNH CHO CÁC NGÔN NGỮ BỔ SUNG (TRUNG -> NHẬT -> PHÁP) -->
                    <div id="dynamicExtraLanguagesContainer" class="col-span-1 md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-4"></div>
                </div>
            </div>
        </div>

        <div class="p-6 border-t border-teal-100/60 flex gap-4 bg-teal-50/20 rounded-b-3xl">
            <button onclick="closeParagraphModal()" class="flex-1 py-3 btn-grad-cancel font-bold rounded-xl active:scale-95 transition-all text-sm">Cancel</button>
            <button id="btnImport" class="flex-1 py-3 btn-grad rounded-xl font-bold text-sm">Confirm Import</button>
        </div>
    </div>
</div>

@* FLOATING PROGRESS BAR CỦA HANGFIRE JOB *@
<div id="aiProcessingOverlay" class="fixed bottom-6 right-6 z-[10001] hidden transform transition-all duration-300 translate-y-10 opacity-0">
    <div class="bg-white/95 backdrop-blur-md border border-teal-200 shadow-2xl rounded-2xl p-5 max-w-sm flex items-start gap-4 ring-1 ring-black/5">
        <div class="relative flex-shrink-0">
            <div class="w-10 h-10 border-4 border-teal-100 border-t-teal-500 rounded-full animate-spin"></div>
            <div class="absolute inset-0 flex items-center justify-center">
                <i class="fas fa-robot text-teal-600 text-xs animate-pulse"></i>
            </div>
        </div>
        <div class="flex-1 space-y-1">
            <h4 class="text-sm font-bold text-gray-800 flex items-center gap-1.5">
                <span>AI Background Job</span>
                <span class="flex h-2 w-2 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-teal-500"></span>
                </span>
            </h4>
            <p id="aiProcessingMessage" class="text-xs text-gray-500 leading-relaxed">
                The system is analyzing dialogues and translating paragraphs. Please do not reload (F5) the page...
            </p>
            <div class="pt-1.5 flex items-center gap-2">
                <span class="text-[10px] bg-teal-50 text-teal-700 font-semibold px-2 py-0.5 rounded-md border border-teal-200">
                    Hangfire Processing
                </span>
            </div>
        </div>
    </div>
</div>