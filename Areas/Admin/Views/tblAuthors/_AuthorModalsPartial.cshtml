<!-- MODAL CRUD AUTHOR -->
<div id="modalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[99] transition-all duration-500">
    <div id="modalContent" class="bg-white w-full max-w-5xl rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-20 opacity-0 transition-all duration-500 ease-out">
        <div class="p-8 border-b border-gray-50 relative mx-5 bg-gradient-to-r from-gray-50 to-white">
            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center">
                <h3 id="modalTitle" class="text-xl font-extrabold text-cus">@SharedLocalizer["AdminCommon_TitlePlaceholder"]</h3>
                <p class="text-xs text-gray-400 mt-1">@SharedLocalizer["AdminCommon_FillAllInfo"]</p>
            </div>
            <button onclick="closeModal()" class="absolute right-6 top-6 w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-red-50 hover:text-red-500 transition-all text-2xl">&times;</button>
        </div>

        <form id="authorForm" enctype="multipart/form-data" class="p-8 space-y-6 max-h-[70vh] overflow-y-auto">
            <input type="hidden" name="AuthorId" id="authorId">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <div class="flex flex-col items-center gap-4 mt-2">
                        <div class="w-40 h-40 rounded-3xl border-2 border-dashed border-gray-200 flex items-center justify-center overflow-hidden bg-gray-50">
                            <img onclick="openImagePreview(this.src)" id="imgPreview" src="" class="w-full h-full object-cover hidden cursor-pointer" />
                            <i id="uploadIcon" class="fas fa-camera text-gray-300 text-2xl"></i>
                        </div>
                        <div class="w-full text-center">
                            <input type="file" name="formFile" id="imageInput" accept="image/*" class="hidden" onchange="previewImage(this)">
                            <button type="button" onclick="$('#imageInput').click()" class="px-4 py-2 bg-white border border-gray-200 rounded-xl text-sm text-cus font-semibold hover:bg-gray-50 transition">@SharedLocalizer["AdminCommon_ChooseImage"]</button>
                            <p class="text-[10px] text-gray-400 mt-1">@SharedLocalizer["AdminCommon_ImageRequirements"]</p>
                        </div>
                    </div>
                </div>

                <div class="md:col-span-2">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminAuthors_AuthorName"]</label>
                            <input type="text" name="AuthorName" id="authorName" class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all" placeholder="@SharedLocalizer["AdminAuthors_NamePlaceholder"]" required>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminCommon_DateOfBirth"]</label>
                            <input type="date" name="DoB" id="authorDoB" class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all datepicker" placeholder="yyyy-mm-dd">
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminCommon_Country"]</label>
                            <select name="Country" id="authorCountry" class="select2-custom w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all"></select>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminCommon_Email"]</label>
                            <input type="email" name="Email" id="authorEmail" class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all" placeholder="abc@gmail.com" required>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminCommon_Gender"]</label>
                            <select name="Gender" id="authorGender" class="select2-custom w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all">
                                <option data-color="linear-gradient(135deg, #4facfe, #00f2fe)" value="Male">@SharedLocalizer["AdminCommon_Male"]</option>
                                <option data-color="linear-gradient(135deg, #ff758c, #ff7eb3)" value="Female">@SharedLocalizer["AdminCommon_Female"]</option>
                            </select>
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminCommon_Status"]</label>
                            <select name="Status" id="authorStatus" class="select2-custom w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all">
                                <option data-color="linear-gradient(135deg, #93F9B9, #1D976C)" value="Active">@SharedLocalizer["AdminCommon_Active"]</option>
                                <option data-color="linear-gradient(135deg, #F45C43, #EB3349)" value="Inactive">@SharedLocalizer["AdminCommon_Inactive"]</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-6 flex gap-4">
                <button type="button" onclick="closeModal()" class="flex-[2] py-3 btn-grad-cancel text-white rounded-xl font-bold shadow-lg active:scale-95 transition-all">@SharedLocalizer["AdminCommon_Cancel"]</button>
                <button type="submit" id="btnSave" class="flex-[2] py-3 btn-grad text-white rounded-xl font-bold shadow-lg active:scale-95 transition-all">@SharedLocalizer["AdminCommon_SaveChanges"]</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL IMPORT EXCEL -->
<div id="importModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm transition-all duration-300">
    <div id="importContent" class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl transform scale-95 opacity-0 transition-all duration-300">
        <div class="p-8">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-bold text-cus">@SharedLocalizer["AdminAuthors_ImportHeading"]</h3>
                <button onclick="closeImportModal()" class="text-gray-400 hover:text-gray-600 transition-colors"><i class="fas fa-times text-xl"></i></button>
            </div>
            <div id="dropZone" class="relative border-2 border-dashed border-indigo-200 rounded-2xl p-10 flex flex-col items-center justify-center bg-indigo-50/30 hover:bg-indigo-50 hover:border-indigo-400 transition-all cursor-pointer group">
                <input type="file" id="excelFile" accept=".xlsx, .xls" class="absolute inset-0 opacity-0 cursor-pointer">
                <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i class="fas fa-file-excel text-green-500 text-3xl"></i>
                </div>
                <p class="text-gray-600 font-semibold" id="fileStatus">@SharedLocalizer["AdminCommon_DropOrClickImport"]</p>
                <p class="text-xs text-gray-400 mt-2">@SharedLocalizer["AdminCommon_SupportedFormats"]</p>
            </div>
            <div class="mt-4 flex items-center justify-between px-2">
                <a href="/assets/template/Author_Template.xlsx" class="text-sm text-cus text-indigo-600 font-medium hover:underline flex items-center gap-2">
                    <i class="fas fa-download text-xs"></i> @SharedLocalizer["AdminCommon_DownloadTemplate"]
                </a>
            </div>
            <div class="flex gap-4 mt-8">
                <button onclick="closeImportModal()" class="flex-1 py-3 btn-grad-cancel font-bold hover:bg-gray-50 rounded-xl transition-all">@SharedLocalizer["AdminCommon_Cancel"]</button>
                <button id="btnDoImport" onclick="executeImport()" class="flex-1 py-3 btn-grad rounded-xl font-bold shadow-lg active:scale-95 transition-all">@SharedLocalizer["AdminCommon_ConfirmImport"]</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ZOOM IMAGE -->
<div id="imageModal" class="fixed inset-0 bg-black/70 hidden items-center justify-center z-[999]">
    <img id="imageModalContent" class="max-w-[90%] max-h-[90%] rounded-2xl shadow-2xl" />
    <button onclick="closeImagePreview()" class="absolute top-5 right-5 text-white text-3xl hover:text-red-400">&times;</button>
</div>