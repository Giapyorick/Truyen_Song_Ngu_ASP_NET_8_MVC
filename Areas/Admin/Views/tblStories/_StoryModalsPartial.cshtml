@* MODAL CRUD STORY *@
<div id="modalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[99] transition-all duration-500">
    <div id="modalContent" class="bg-white w-full max-w-5xl rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-20 opacity-0 transition-all duration-500 ease-out">
        <div class="p-8 border-b border-gray-50 relative mx-5 mt-0 mb-0 bg-gradient-to-r from-gray-50 to-white">
            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center">
                <h3 id="modalTitle" class="text-xl font-extrabold text-cus">@SharedLocalizer["AdminCommon_TitlePlaceholder"]</h3>
                <p class="text-xs text-gray-400 mt-1">@SharedLocalizer["AdminCommon_FillAllInfo"]</p>
            </div>

            <button onclick="closeModal()"
                    class="absolute right-6 top-6 w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-red-50 hover:text-red-500 transition-all text-2xl">
                &times;
            </button>
        </div>

        <form id="storyForm" enctype="multipart/form-data" class="p-8 space-y-6 max-h-[70vh] overflow-y-auto">
            <input type="hidden" name="StoryId" id="storyId">

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="space-y-6">
                    <div>
                        <div class="flex flex-col items-center gap-4 mt-2">
                            <div class="w-40 h-40 rounded-3xl border-2 border-dashed border-gray-200 flex items-center justify-center overflow-hidden bg-gray-50">
                                <img onclick="openImagePreview(this.src)" id="imgPreview" src="" class="w-full h-full object-cover hidden cursor-pointer" />
                                <i id="uploadIcon" class="fas fa-camera text-gray-300 text-2xl"></i>
                            </div>
                            <div class="w-full text-center">
                                <input type="file" name="formFile" id="imageInput" accept="image/*" class="hidden" onchange="previewImage(this)">
                                <button type="button" onclick="$('#imageInput').click()"
                                        class="px-4 py-2 bg-white border border-gray-200 rounded-xl text-sm text-cus font-semibold hover:bg-gray-50 transition">
                                    @SharedLocalizer["AdminCommon_ChooseImage"]
                                </button>
                                <p class="text-[10px] text-gray-400 mt-1">@SharedLocalizer["AdminCommon_ImageRequirements"]</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="md:col-span-2 space-y-4">
                    <!-- Thanh trạng thái & nút chuyển chế độ dịch -->
                    <div class="flex items-center justify-between p-3.5 bg-indigo-50/70 border border-indigo-200 rounded-2xl shadow-sm">
                        <div class="text-xs font-bold text-indigo-900 flex items-center gap-2" id="currentLangModeText">
                            <span id="currentLangFlag">🇺🇸</span>
                            <span id="currentLangTitleDesc">Bản nhập mặc định: <strong>Tiếng Anh (English - Primary)</strong></span>
                        </div>
                        <button type="button" id="btnToggleTranslatePanel" onclick="toggleTranslationPanel()"
                                class="px-4 py-2 bg-gradient-to-r from-teal-500 to-cyan-500 text-white rounded-xl text-xs font-bold shadow-md hover:shadow-teal-200/50 hover:opacity-95 active:scale-95 transition-all flex items-center gap-2">
                            <i class="fas fa-language text-sm"></i> <span id="btnToggleTranslateLabel">Thêm / Chỉnh sửa Tiếng Việt 🇻🇳</span>
                        </button>
                    </div>

                    <!-- KHỐI 1: Ô NHẬP LIỆU CHÍNH (TIẾNG ANH MẶC ĐỊNH) -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1" id="lblTitlePrimary">Story Title (English) <span class="text-red-500">*</span></label>
                            <input type="text" id="primaryTitle"
                                   class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all text-sm font-medium"
                                   placeholder="Enter story title in English..." required>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminStories_PublicationDate"]</label>
                            <!-- Đổi type="date" thành type="text" -->
                            <input type="text" name="PublicationDate" id="storyPublicationDate"
                                   class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all datepicker text-sm"
                                   placeholder="yyyy-MM-dd" autocomplete="off">
                        </div>

                        <!-- Ô MÔ TẢ ĐÃ ĐƯỢC TĂNG RỘNG VÀ DÀI -->
                        <div class="space-y-1 md:col-span-2">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1" id="lblDescPrimary">Story Description (English)</label>
                            <textarea id="primaryDesc" rows="4"
                                      class="w-full px-4 py-3 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all text-sm min-h-[110px]"
                                      placeholder="Enter synopsis/description in English..."></textarea>
                        </div>
                    </div>

                    <!-- KHỐI 2: KHUNG ĐỐI CHIẾU THAM KHẢO & BẢN DỊCH TIẾNG VIỆT -->
                    <div id="secondaryLangPanel" class="hidden p-5 bg-teal-50/40 border border-teal-200 rounded-2xl space-y-4 transition-all duration-300">
                        <div class="flex items-center justify-between pb-2 border-b border-teal-100">
                            <div class="space-y-0.5">
                                <span class="text-xs font-bold text-teal-900 flex items-center gap-1.5" id="secondaryPanelHeader">
                                    <i class="fas fa-layer-group text-teal-600"></i> Bản dịch song song
                                </span>
                                <p class="text-[11px] text-teal-700" id="secondaryPanelNotice">
                                    * Dịch sang ngôn ngữ phụ để hỗ trợ độc giả song ngữ.
                                </p>
                            </div>

                            <button type="button" id="btnAiTranslate" onclick="translateCurrentViaAi()"
                                    class="px-3.5 py-2 bg-gradient-to-r from-amber-500 to-amber-600 text-white text-xs font-bold rounded-xl shadow-md hover:from-amber-600 hover:to-amber-700 active:scale-95 transition-all flex items-center gap-1.5">
                                <i class="fas fa-wand-magic-sparkles text-amber-200"></i> <span id="btnAiTranslateLabel">Dịch tự động bằng AI</span>
                            </button>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Ô tham khảo đối chiếu (Read-only) -->
                            <div class="space-y-3 bg-gray-100/80 p-3.5 rounded-xl border border-gray-200">
                                <div class="text-[10px] font-extrabold text-gray-500 uppercase tracking-wider flex items-center gap-1" id="lblRefBoxTitle">
                                    <i class="fas fa-eye text-gray-400"></i> Bản gốc đối chiếu (Tham khảo)
                                </div>
                                <div>
                                    <label class="text-[10px] text-gray-500 font-semibold" id="lblRefTitle">Tiêu đề gốc</label>
                                    <input type="text" id="refTitle" readonly
                                           class="w-full px-3 py-2 bg-gray-200/90 text-gray-700 font-semibold rounded-lg text-xs outline-none cursor-not-allowed">
                                </div>
                                <div>
                                    <label class="text-[10px] text-gray-500 font-semibold" id="lblRefDesc">Mô tả gốc</label>
                                    <textarea id="refDesc" rows="4" readonly
                                              class="w-full px-3 py-2 bg-gray-200/90 text-gray-600 text-xs rounded-lg outline-none cursor-not-allowed min-h-[110px]"></textarea>
                                </div>
                            </div>

                            <!-- Ô nhập liệu bản dịch -->
                            <div class="space-y-3 bg-white p-3.5 rounded-xl border border-teal-300 shadow-sm">
                                <div class="text-[10px] font-extrabold text-teal-700 uppercase tracking-wider flex items-center gap-1" id="lblTargetHeader">
                                    <i class="fas fa-pen text-teal-500"></i> Nhập bản dịch
                                </div>
                                <div>
                                    <label class="text-[10px] text-gray-600 font-semibold" id="lblTargetTitle">Tiêu đề dịch</label>
                                    <input type="text" id="targetTitle"
                                           class="w-full px-3 py-2 bg-gray-50 border border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-200 rounded-lg text-xs outline-none transition-all font-medium">
                                </div>
                                <div>
                                    <label class="text-[10px] text-gray-600 font-semibold" id="lblTargetDesc">Mô tả dịch</label>
                                    <textarea id="targetDesc" rows="4"
                                              class="w-full px-3 py-2 bg-gray-50 border border-teal-300 focus:bg-white focus:ring-2 focus:ring-teal-200 rounded-lg text-xs outline-none transition-all min-h-[110px]"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Giữ nguyên Tác giả, Thể loại, Trạng thái, Chip ngôn ngữ bên dưới -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminStories_Author"]</label>
                            <select name="AuthorId" id="storyAuthorName"
                                    class="select2-custom w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all">
                            </select>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminCommon_Status"]</label>
                            <select name="Status" id="storyStatus"
                                    class="select2-custom w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all">
                                <option data-color="linear-gradient(135deg, #93F9B9, #1D976C)" value="Completed">@SharedLocalizer["AdminStories_Completed"]</option>
                                <option data-color="linear-gradient(135deg, #00c6fb, #005bea)" value="Posting">@SharedLocalizer["AdminStories_Posting"]</option>
                                <option data-color="linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%)" value="Coming soon">@SharedLocalizer["AdminStories_ComingSoon"]</option>
                            </select>
                        </div>

                        <div class="space-y-1 md:col-span-2">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">@SharedLocalizer["AdminStories_Categories"]</label>
                            <div id="selectedCategories"
                                 onclick="openCategoryModal()"
                                 class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all cursor-pointer">
                                <span class="comingsoon">@SharedLocalizer["AdminStories_NoCategorySelected"]</span>
                            </div>
                        </div>

                        <div class="space-y-2 md:col-span-2">
                            <div class="p-3 bg-gray-50/80 border border-gray-100 rounded-2xl flex flex-wrap gap-2 items-center">
                                <label class="lang-chip lang-selected cursor-not-allowed select-none">
                                    <input type="checkbox" name="StoryLanguages" value="Tiếng Anh" checked disabled class="hidden">
                                    <span class="flag">🇺🇸</span>
                                    <span class="label">@SharedLocalizer["AdminStories_English"]</span>
                                    <span class="code">EN</span>
                                    <i class="fa-solid fa-lock text-[9px] opacity-75 ml-0.5"></i>
                                </label>
                                <label class="lang-chip lang-selected cursor-not-allowed select-none">
                                    <input type="checkbox" name="StoryLanguages" value="Tiếng Việt" checked disabled class="hidden">
                                    <span class="flag">🇻🇳</span>
                                    <span class="label">@SharedLocalizer["AdminStories_Vietnamese"]</span>
                                    <span class="code">VN</span>
                                    <i class="fa-solid fa-lock text-[9px] opacity-75 ml-0.5"></i>
                                </label>
                                <label class="lang-chip cursor-pointer select-none">
                                    <input type="checkbox" name="StoryLanguages" value="Tiếng Trung" class="hidden lang-checkbox">
                                    <span class="flag">🇨🇳</span>
                                    <span class="label">@SharedLocalizer["AdminStories_Chinese"]</span>
                                    <span class="code">ZH</span>
                                </label>
                                <label class="lang-chip cursor-pointer select-none">
                                    <input type="checkbox" name="StoryLanguages" value="Tiếng Nhật" class="hidden lang-checkbox">
                                    <span class="flag">🇯🇵</span>
                                    <span class="label">@SharedLocalizer["AdminStories_Japanese"]</span>
                                    <span class="code">JA</span>
                                </label>
                                <label class="lang-chip cursor-pointer select-none">
                                    <input type="checkbox" name="StoryLanguages" value="Tiếng Pháp" class="hidden lang-checkbox">
                                    <span class="flag">🇫🇷</span>
                                    <span class="label">@SharedLocalizer["AdminStories_French"]</span>
                                    <span class="code">FR</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-6 flex gap-4">
                <button type="button" onclick="closeModal()"
                        class="flex-[2] py-3 btn-grad-cancel text-white rounded-xl font-bold shadow-lg hover:shadow-indigo-200/50 active:scale-95 transition-all duration-300">
                    @SharedLocalizer["AdminCommon_Cancel"]
                </button>

                <button type="submit" id="btnSave"
                        class="flex-[2] py-3 btn-grad text-white rounded-xl font-bold shadow-lg hover:shadow-indigo-200/50 active:scale-95 transition-all duration-300">
                    @SharedLocalizer["AdminCommon_SaveChanges"]
                </button>
            </div>
        </form>
    </div>
</div>

@* MODAL IMPORT EXCEL *@
<div id="importModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm transition-all duration-300">
    <div id="importContent" class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl transform scale-95 opacity-0 transition-all duration-300">
        <div class="p-8">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-bold text-cus">@SharedLocalizer["AdminCommon_ImportFromExcel"]</h3>
                <button onclick="closeImportModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <div id="dropZone" class="relative border-2 border-dashed border-indigo-200 rounded-2xl p-10 flex flex-col items-center justify-center bg-indigo-50/30 hover:bg-indigo-50 hover:border-indigo-400 transition-all cursor-pointer group">
                <input type="file" id="excelFile" accept=".xlsx, .xls" class="absolute inset-0 opacity-0 cursor-pointer">

                <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i class="fas fa-file-excel text-green-500 text-3xl"></i>
                </div>

                <p class="text-gray-600 font-semibold" id="fileStatus">@SharedLocalizer["AdminCommon_DropOrClickSelect"]</p>
                <p class="text-xs text-gray-400 mt-2">@SharedLocalizer["AdminCommon_SupportedFormats"]</p>
            </div>

            <div class="mt-4 flex items-center justify-between px-2">
                <a href="/assets/template/Story_Template.xlsx" class="text-sm text-cus text-indigo-600 font-medium hover:underline flex items-center gap-2">
                    <i class="fas fa-download text-xs"></i> @SharedLocalizer["AdminCommon_DownloadTemplateHere"]
                </a>
            </div>

            <div class="flex gap-4 mt-8">
                <button onclick="closeImportModal()" class="flex-1 py-3 btn-grad-cancel font-bold hover:bg-gray-50 rounded-xl transition-all">
                    @SharedLocalizer["AdminCommon_Cancel"]
                </button>
                <button id="btnDoImport" onclick="executeImport()" class="flex-1 py-3 bg-indigo-600 btn-grad rounded-xl font-bold shadow-lg hover:bg-indigo-700 active:scale-95 transition-all disabled:opacity-50 disabled:pointer-events-none">
                    @SharedLocalizer["AdminCommon_ConfirmImport"]
                </button>
            </div>
        </div>
    </div>
</div>

@* MODAL SHOW IMAGE *@
<div id="imageModal" class="fixed inset-0 bg-black/70 hidden items-center justify-center z-[999]">
    <img id="imageModalContent" class="max-w-[90%] max-h-[90%] rounded-2xl shadow-2xl" />
    <button onclick="closeImagePreview()" class="absolute top-5 right-5 text-white text-3xl hover:text-red-400">
        &times;
    </button>
</div>

@* MODAL CHỌN CATEGORY *@
<div id="categoryModal" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[999] transition-all">
    <div id="categoryModalContent" class="bg-white w-full max-w-3xl rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] transform translate-y-20 opacity-0 transition-all duration-500 ease-out">
        <div class="p-6 border-b bg-gray-50 rounded-t-[2rem] text-center">
            <h3 class="text-xl font-extrabold text-cus">@SharedLocalizer["AdminStories_SelectCategories"]</h3>
            <p class="text-xs text-gray-400 mt-1">@SharedLocalizer["AdminStories_ChooseOneOrMoreCategories"]</p>
        </div>

        <div class="p-6 max-h-[55vh] overflow-y-auto">
            <div id="categoryCheckboxList" class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <!-- JS render -->
            </div>
        </div>

        <div class="p-6 flex justify-end gap-3 border-t bg-gray-50 rounded-b-[2rem]">
            <button onclick="closeCategoryModal()" class="px-4 py-2 rounded-xl bg-gray-200 hover:bg-gray-300 text-sm font-semibold">
                @SharedLocalizer["AdminCommon_Cancel"]
            </button>
            <button onclick="applyCategories()" class="px-5 py-2 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 text-sm font-semibold">
                @SharedLocalizer["AdminCommon_Apply"]
            </button>
        </div>
    </div>
</div>