@* MODAL CRUD STORY *@
<div id="modalOverlay" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[99] transition-all duration-500">
    <div id="modalContent" class="bg-white w-full max-w-5xl rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden transform translate-y-20 opacity-0 transition-all duration-500 ease-out">
        <div class="p-8 border-b border-gray-50 relative mx-5 mt-0 mb-0 bg-gradient-to-r from-gray-50 to-white">
            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center">
                <h3 id="modalTitle" class="text-xl font-extrabold text-cus">Title</h3>
                <p class="text-xs text-gray-400 mt-1">Please fill in all information</p>
            </div>

            <button onclick="closeModal()"
                    class="absolute right-6 top-6 w-10 h-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-red-50 hover:text-red-500 transition-all text-2xl">
                &times;
            </button>
        </div>

        <form id="storyForm" enctype="multipart/form-data" class="p-8 space-y-6 max-h-[70vh] overflow-y-auto">
            <input type="hidden" name="StoryId" id="storyId">

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="space-y-6">
                    <div>
                        <div class="flex flex-col items-center gap-4 mt-2">
                            <div class="w-40 h-40 rounded-3xl border-2 border-dashed border-gray-200 flex items-center justify-center overflow-hidden bg-gray-50">
                                <img onclick="openImagePreview(this.src)" id="imgPreview" src="" class="w-full h-full object-cover hidden cursor-pointer" />
                                <i id="uploadIcon" class="fas fa-camera text-gray-300 text-2xl"></i>
                            </div>
                            <div class="w-full text-center">
                                <input type="file" name="formFile" id="imageInput" accept="image/*" class="hidden" onchange="previewImage(this)">
                                <button type="button" onclick="$('#imageInput').click()"
                                        class="px-4 py-2 bg-white border border-gray-200 rounded-xl text-sm text-cus font-semibold hover:bg-gray-50 transition">
                                    Choose Image
                                </button>
                                <p class="text-[10px] text-gray-400 mt-1">PNG, JPG up to 2MB</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="md:col-span-2">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">Title</label>
                            <input type="text" name="Title" id="storyTitle"
                                   class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all"
                                   placeholder="Doraemon" required>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">PublicationDate</label>
                            <input type="date" name="PublicationDate" id="storyPublicationDate"
                                   class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all datepicker"
                                   placeholder="yyyy-mm-dd">
                        </div>
                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">Author</label>
                            <select name="AuthorId" id="storyAuthorName"
                                    class="select2-custom w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all">
                            </select>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">Description</label>
                            <textarea name="Description" id="storyDescription" rows="3"
                                      class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all"
                                      placeholder="Write something ..."></textarea>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">Categories</label>
                            <div id="selectedCategories"
                                 onclick="openCategoryModal()"
                                 class="w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all cursor-pointer">
                                <span class="comingsoon">No category selected</span>
                            </div>
                        </div>

                        <div class="space-y-1">
                            <label class="text-[11px] font-bold text-cus uppercase ml-1">Status</label>
                            <select name="Status" id="storyStatus"
                                    class="select2-custom w-full px-4 py-2.5 bg-gray-100 border-2 border-transparent focus:border-purple-200 rounded-xl outline-none transition-all">
                                <option data-color="linear-gradient(135deg, #93F9B9, #1D976C)" value="Completed">Completed</option>
                                <option data-color="linear-gradient(135deg, #00c6fb, #005bea)" value="Posting">Posting</option>
                                <option data-color="linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%)" value="Coming soon">Coming soon</option>
                            </select>
                        </div>

                        <!-- Container bọc thẻ ngôn ngữ -->
                        <div class="space-y-2 md:col-span-2">
                        <div class="p-3 bg-gray-50/80 border border-gray-100 rounded-2xl flex flex-wrap gap-2 items-center">
                            <!-- English (Cố định, luôn chọn) -->
                            <label class="lang-chip lang-selected cursor-not-allowed select-none">
                                <input type="checkbox" name="StoryLanguages" value="Tiếng Anh" checked disabled class="hidden">
                                <span class="flag">🇺🇸</span>
                                <span class="label">English</span>
                                <span class="code">EN</span>
                                <i class="fa-solid fa-lock text-[9px] opacity-75 ml-0.5"></i>
                            </label>

                            <!-- Vietnamese (Cố định, luôn chọn) -->
                            <label class="lang-chip lang-selected cursor-not-allowed select-none">
                                <input type="checkbox" name="StoryLanguages" value="Tiếng Việt" checked disabled class="hidden">
                                <span class="flag">🇻🇳</span>
                                <span class="label">Vietnamese</span>
                                <span class="code">VN</span>
                                <i class="fa-solid fa-lock text-[9px] opacity-75 ml-0.5"></i>
                            </label>

                            <!-- Chinese -->
                            <label class="lang-chip cursor-pointer select-none">
                                <input type="checkbox" name="StoryLanguages" value="Tiếng Trung" class="hidden lang-checkbox">
                                <span class="flag">🇨🇳</span>
                                <span class="label">Chinese</span>
                                <span class="code">ZH</span>
                            </label>

                            <!-- Japanese -->
                            <label class="lang-chip cursor-pointer select-none">
                                <input type="checkbox" name="StoryLanguages" value="Tiếng Nhật" class="hidden lang-checkbox">
                                <span class="flag">🇯🇵</span>
                                <span class="label">Japanese</span>
                                <span class="code">JA</span>
                            </label>

                            <!-- French -->
                            <label class="lang-chip cursor-pointer select-none">
                                <input type="checkbox" name="StoryLanguages" value="Tiếng Pháp" class="hidden lang-checkbox">
                                <span class="flag">🇫🇷</span>
                                <span class="label">French</span>
                                <span class="code">FR</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            </div>

            <div class="pt-6 flex gap-4">
                <button type="button" onclick="closeModal()"
                        class="flex-[2] py-3 btn-grad-cancel text-white rounded-xl font-bold shadow-lg hover:shadow-indigo-200/50 active:scale-95 transition-all duration-300">
                    Cancel
                </button>

                <button type="submit" id="btnSave"
                        class="flex-[2] py-3 btn-grad text-white rounded-xl font-bold shadow-lg hover:shadow-indigo-200/50 active:scale-95 transition-all duration-300">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@* MODAL IMPORT EXCEL *@
<div id="importModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm transition-all duration-300">
    <div id="importContent" class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl transform scale-95 opacity-0 transition-all duration-300">
        <div class="p-8">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-bold text-cus">Import from Excel</h3>
                <button onclick="closeImportModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <div id="dropZone" class="relative border-2 border-dashed border-indigo-200 rounded-2xl p-10 flex flex-col items-center justify-center bg-indigo-50/30 hover:bg-indigo-50 hover:border-indigo-400 transition-all cursor-pointer group">
                <input type="file" id="excelFile" accept=".xlsx, .xls" class="absolute inset-0 opacity-0 cursor-pointer">

                <div class="w-16 h-16 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                    <i class="fas fa-file-excel text-green-500 text-3xl"></i>
                </div>

                <p class="text-gray-600 font-semibold" id="fileStatus">Drag and drop the file here or click to select it.</p>
                <p class="text-xs text-gray-400 mt-2">Format support .xlsx, .xls (Max 5MB)</p>
            </div>

            <div class="mt-4 flex items-center justify-between px-2">
                <a href="/assets/template/Story_Template.xlsx" class="text-sm text-cus text-indigo-600 font-medium hover:underline flex items-center gap-2">
                    <i class="fas fa-download text-xs"></i> Download template here
                </a>
            </div>

            <div class="flex gap-4 mt-8">
                <button onclick="closeImportModal()" class="flex-1 py-3 btn-grad-cancel font-bold hover:bg-gray-50 rounded-xl transition-all">
                    Cancel
                </button>
                <button id="btnDoImport" onclick="executeImport()" class="flex-1 py-3 bg-indigo-600 btn-grad rounded-xl font-bold shadow-lg hover:bg-indigo-700 active:scale-95 transition-all disabled:opacity-50 disabled:pointer-events-none">
                    Confirm Import
                </button>
            </div>
        </div>
    </div>
</div>

@* MODAL SHOW IMAGE *@
<div id="imageModal" class="fixed inset-0 bg-black/70 hidden items-center justify-center z-[999]">
    <img id="imageModalContent" class="max-w-[90%] max-h-[90%] rounded-2xl shadow-2xl" />
    <button onclick="closeImagePreview()" class="absolute top-5 right-5 text-white text-3xl hover:text-red-400">
        &times;
    </button>
</div>

@* MODAL CHỌN CATEGORY *@
<div id="categoryModal" class="fixed inset-0 bg-black/50 backdrop-blur-md hidden items-center justify-center z-[999] transition-all">
    <div id="categoryModalContent" class="bg-white w-full max-w-3xl rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.3)] transform translate-y-20 opacity-0 transition-all duration-500 ease-out">
        <div class="p-6 border-b bg-gray-50 rounded-t-[2rem] text-center">
            <h3 class="text-xl font-extrabold text-cus">Select Categories</h3>
            <p class="text-xs text-gray-400 mt-1">Choose one or more categories</p>
        </div>

        <div class="p-6 max-h-[55vh] overflow-y-auto">
            <div id="categoryCheckboxList" class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <!-- JS render -->
            </div>
        </div>

        <div class="p-6 flex justify-end gap-3 border-t bg-gray-50 rounded-b-[2rem]">
            <button onclick="closeCategoryModal()" class="px-4 py-2 rounded-xl bg-gray-200 hover:bg-gray-300 text-sm font-semibold">
                Cancel
            </button>
            <button onclick="applyCategories()" class="px-5 py-2 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 text-sm font-semibold">
                Apply
            </button>
        </div>
    </div>
</div>