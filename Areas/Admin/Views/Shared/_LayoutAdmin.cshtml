<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f8fafc; font-family: 'Inter', sans-serif; }
        #toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 999999;
            display: flex;
            flex-direction: col;
            gap: 10px;
        }

        .toast-notification {
            min-width: 300px;
            max-width: 400px;
            padding: 16px 24px;
            border-radius: 12px;
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-weight: 600;
            font-size: 14px;
            box-shadow: 0 10px 25px rgba(80, 201, 195, 0.3);
            background-image: linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%);
            background-size: 200% auto;
            transition: all 0.5s ease;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            transform: translateX(120%);
            opacity: 0;
        }

        .toast-notification.show {
            transform: translateX(0);
            opacity: 1;
        }

        .toast-notification:hover {
            background-position: right center;
            box-shadow: 0 12px 30px rgba(80, 201, 195, 0.5);
            transform: translateY(-2px);
            cursor: pointer;
        }

        .toast-close {
            background: none;
            border: none;
            color: white;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            opacity: 0.7;
            transition: opacity 0.2s;
            padding: 0 0 0 10px;
        }

        .toast-close:hover {
            opacity: 1;
        }  
        .toast-notification.toast-error {
            background-image: linear-gradient(to right, #ED4264 0%, #f05b5bb7 51%, #ED4264 100%);
            box-shadow: 0 10px 25px rgba(237, 66, 100, 0.3);
        }

        .toast-notification.toast-error:hover {
            box-shadow: 0 12px 30px rgba(237, 66, 100, 0.5);
        }
@* /*       TOAST NOTIFICATION */
CONFIRM UI *@
        /* Khung nền mờ phủ toàn màn hình */
        #confirm-overlay {
            position: fixed;
            inset: 0;
            background-color: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(4px);
            z-index: 9999999;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        #confirm-overlay.open {
            opacity: 1;
            pointer-events: auto;
        }

        /* Hộp thoại xác nhận chính */
        .confirm-box {
            background: white;
            width: 100%;
            max-width: 400px;
            padding: 30px;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            text-align: center;
            transform: scale(0.9);
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        #confirm-overlay.open .confirm-box {
            transform: scale(1);
        }

        /* Tiêu đề & Nội dung câu hỏi */
        .confirm-title {
            font-size: 18px;
            font-weight: 800;
            color: #1a202c;
            margin-bottom: 10px;
        }

        .confirm-message {
            font-size: 14px;
            color: #718096;
            line-height: 1.5;
            margin-bottom: 24px;
        }

        /* Khu vực nút bấm */
        .confirm-buttons {
            display: flex;
            gap: 12px;
        }

        .confirm-btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 700;
            color: white;
            cursor: pointer;
            transition: all 0.3s ease;
            background-size: 200% auto;
        }

        /* Áp dụng màu Gradient nút bấm từ CSS của bạn */
        .confirm-btn-cancel {
            background-image: linear-gradient(to right, #ED4264 0%, #f05b5bb7 51%, #ED4264 100%);
            box-shadow: 0 4px 15px rgba(237, 66, 100, 0.2);
        }

        .confirm-btn-cancel:hover {
            background-position: right center;
            box-shadow: 0 6px 20px rgba(237, 66, 100, 0.4);
            transform: translateY(-1px);
        }

        .confirm-btn-success {
            background-image: linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%);
            box-shadow: 0 4px 15px rgba(80, 201, 195, 0.2);
        }

        .confirm-btn-success:hover {
            background-position: right center;
            box-shadow: 0 6px 20px rgba(80, 201, 195, 0.4);
            transform: translateY(-1px);
        }
        @* CONFIRM UI *@

        .text-cus {
            background: linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            text-shadow: 0 2px 6px rgba(15, 3, 28, 0.1);
        }
        .text-field {
            background: linear-gradient(135deg, #0250c5 0%, #d43f8d 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .text-wait {
            background: linear-gradient(135deg, #FF8008, #FFC837);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .text-accepted {
            background: linear-gradient(135deg, #93F9B9, #1D976C);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .text-deny {
            background: linear-gradient(135deg, #F45C43, #EB3349);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
		.stat-card {
			transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
			border: 1px solid rgba(226, 232, 240, 0.8);
			cursor: pointer;
		}

		.stat-card:hover {
			transform: translateY(-8px);
			background: #ffffff;
		}

		.shadow-accepted:hover {
			box-shadow: 0 20px 25px -5px rgba(29, 151, 108, 0.15), 0 10px 10px -5px rgba(29, 151, 108, 0.1);
			border-color: #93F9B9;
		}

		.shadow-wait:hover {
			box-shadow: 0 20px 25px -5px rgba(255, 128, 8, 0.15), 0 10px 10px -5px rgba(255, 128, 8, 0.1);
			border-color: #FFC837;
		}

		.shadow-deny:hover {
			box-shadow: 0 20px 25px -5px rgba(235, 51, 73, 0.15), 0 10px 10px -5px rgba(235, 51, 73, 0.1);
			border-color: #F45C43;
		}

        .sidebar { 
			transition: all 0.3s ease; 
			width: 260px; 
			background: #ffffff; 
			border-right: 1px solid #e2e8f0; 
		}

		.nav-link {
			transition: 0.5s;
			background-size: 200% auto;
			color: #50C9C3; 
			border: 1px solid transparent;
		}

		.nav-link:hover, .active-nav {
			background-image: linear-gradient(to right, #50C9C3 0%, #96DEDA 51%, #50C9C3 100%);
			background-position: right center; 
			color: white !important;
			box-shadow: 0 10px 20px rgba(80, 201, 195, 0.2);
			text-decoration: none;
		}

		.nav-link:hover i, .active-nav i {
			color: white;
		}
		.btn-grad {background-image: linear-gradient(to right, #50C9C3 0%, #96DEDA  51%, #50C9C3  100%)}
		.btn-grad {
			margin: 10px;
			padding: 15px 45px;
			text-align: center;
			transition: 0.5s;
			background-size: 200% auto;
			color: white;            
			box-shadow: 0 0 20px #eee;
			border-radius: 10px;
			display: block;
		}
		.btn-grad:hover {
            background-position: right center; 
            color: #fff;
            text-decoration: none;
        }
        
        .btn-grad-cancel {background-image: linear-gradient(to right, #ED4264 0%, #f05b5bb7  51%, #ED4264  100%)}
        .btn-grad-cancel {
            margin: 10px;
            padding: 15px 45px;
            text-align: center;
            text-transform: uppercase;
            transition: 0.5s;
            background-size: 200% auto;
            color: white;            
            box-shadow: 0 0 20px #eee;
            border-radius: 10px;
            display: block;
        }

        .btn-grad-cancel:hover {
            background-position: right center; 
            color: #fff;
            text-decoration: none;
        }
        
        
        #loader { display: none; }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <aside class="sidebar h-full flex flex-col">
        <div class="p-6 text-2xl font-bold text-cus">Admin</div>
        <nav class="flex-1 px-4 space-y-2">
            <a href="#" onclick="loadContent('dashboard')" class="nav-link flex items-center p-3 rounded-lg active-nav">
                <i class="fas fa-chart-pie mr-3"></i> Dashboard
            </a>
            <a href="#" onclick="loadContent('users')" class="nav-link flex items-center p-3  rounded-lg">
                <i class="fas fa-users mr-3"></i> Users
            </a>
            <a href="#" onclick="loadContent('orders')" class="nav-link flex items-center p-3 rounded-lg">
                <i class="fas fa-shopping-cart mr-3"></i> Orders
            </a>
        </nav>
    </aside>

    @RenderBody()

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @RenderSection("Scripts", required: false)
    <script>
        function loadContent(page) {
            $('.nav-link').removeClass('active-nav');
            $(event.currentTarget).addClass('active-nav');
            
            $('#page-title').text(page);

            $('#main-view').hide();
            $('#loader').show();

            setTimeout(function() {
                $('#loader').hide();
                $('#main-view').fadeIn().html(`
                    <div class="bg-white p-8 rounded-2xl shadow-sm">
                        <h3 class="text-2xl font-bold text-cus mb-4">Nội dung trang ${page}</h3>
                        <p class="text-gray-600">Đây là nội dung được tải động qua Ajax bằng màu sắc bạn yêu cầu.</p>
                        <table class="w-full mt-6 border-collapse">
                            <thead>
                                <tr class="text-left border-b">
                                    <th class="pb-3">ID</th>
                                    <th class="pb-3">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td class="py-3">#001</td><td class="text-accepted font-bold">Thành công</td></tr>
                                <tr><td class="py-3">#002</td><td class="text-wait font-bold">Chờ xử lý</td></tr>
                                <tr><td class="py-3">#003</td><td class="text-deny font-bold">Bị từ chối</td></tr>
                            </tbody>
                        </table>
                    </div>
                `);
            }, 500);
        }
        //Toast_Notification
        function showToast(message, type = 'success', duration = 10000) {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const toast = document.createElement('div');
    
            toast.className = `toast-notification ${type === 'error' ? 'toast-error' : ''}`;
    
            toast.innerHTML = `
                <span class="toast-message">${message}</span>
                <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('show');
            }, 10);

            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => { toast.remove(); }, 500);
            }, duration);
        }
        // CONFIRM UI
        function customConfirm(message, title = "Xác nhận hành động") {
            return new Promise((resolve) => {
                const overlay = document.getElementById('confirm-overlay');
                const titleEl = document.getElementById('confirm-title');
                const messageEl = document.getElementById('confirm-message');
                const btnYes = document.getElementById('confirm-btn-yes');
                const btnNo = document.getElementById('confirm-btn-no');

                titleEl.textContent = title;
                messageEl.innerHTML = message;

                overlay.classList.add('open');

                function cleanup(result) {
                    overlay.classList.remove('open');
                    btnYes.removeEventListener('click', onYes);
                    btnNo.removeEventListener('click', onNo);
                    resolve(result); 
                }

                function onYes() { cleanup(true); }
                function onNo() { cleanup(false); }

                btnYes.addEventListener('click', onYes);
                btnNo.addEventListener('click', onNo);
            });
        }
    </script>

    <div id="toast-container"></div>
    <div id="confirm-overlay">
        <div class="confirm-box">
            <h4 class="confirm-title" id="confirm-title">Confirm</h4>
            <p class="confirm-message" id="confirm-message">Are you sure about this action</p>
            <div class="confirm-buttons">
                <button class="confirm-btn confirm-btn-cancel" id="confirm-btn-no">Reject</button>
                <button class="confirm-btn confirm-btn-success" id="confirm-btn-yes">Accept</button>
            </div>
        </div>
    </div>
</body>
</html>
