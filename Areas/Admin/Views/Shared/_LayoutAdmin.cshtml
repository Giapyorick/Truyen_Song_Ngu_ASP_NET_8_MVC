@{
    var currentUserRole = Context.Session.GetString("AdminRole") ?? "Viewer";
    var isViewer = string.Equals(currentUserRole, "Viewer", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin/_AdminLayout.css" asp-append-version="true" />

</head>
<body class="flex h-screen overflow-hidden">

    <aside class="sidebar h-full flex flex-col">
        <div class="p-6 text-2xl font-bold text-cus">Admin</div>
        <nav class="flex-1 px-4 space-y-2">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="nav-link flex items-center p-3 rounded-lg">
                <i class="fas fa-chart-pie mr-3"></i> Dashboard
            </a>
            <a asp-area="Admin" asp-controller="tblAuthors" asp-action="Authors" class="nav-link flex items-center p-3 rounded-lg">
                <i class="fas fa-users mr-3"></i> Authors
            </a>
            <a asp-area="Admin" asp-controller="tblCategories" asp-action="Categories" class="nav-link flex items-center p-3 rounded-lg">
                <i class="fas fa-book mr-3"></i> Categories
            </a>
            <a asp-area="Admin" asp-controller="tblStories" asp-action="Stories" class="nav-link flex items-center p-3 rounded-lg">
                <i class="fas fa-book mr-3"></i> Stories
            </a>
            <a asp-area="Admin" asp-controller="tblChapters" asp-action="Chapters" class="nav-link flex items-center p-3 rounded-lg">
                <i class="fas fa-list-alt mr-3"></i> Chapters
            </a>
            <a asp-area="Admin" asp-controller="tblParagraphs" asp-action="Paragraphs" class="nav-link flex items-center p-3 rounded-lg">
                <i class="fas fa-paragraph mr-3"></i> Paragraphs
            </a>
            <a asp-area="Admin" asp-controller="tblUsers" asp-action="Users" class="nav-link flex items-center p-3 rounded-lg">
                <i class="fas fa-users-cog mr-3"></i> Users
            </a>

            <a asp-area="Admin" asp-controller="tblAdmins" asp-action="Admins" class="nav-link flex items-center p-3 rounded-lg">
                <i class="fas fa-user-shield mr-3"></i> Admins
            </a>

            <form asp-area="Admin" asp-controller="Auth" asp-action="Logout" method="post" class="inline m-2 w-full">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link flex items-center w-full p-3 rounded-lg text-left border-none bg-transparent hover:text-red-500 transition-colors">
                    <i class="fas fa-sign-out-alt mr-3"></i> Logout
                </button>
            </form>
        </nav>
    </aside>

    @RenderBody()

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @RenderSection("Scripts", required: false)
    <script>
            function loadContent(url, element) {
                $('.sidebar nav a, .nav-link').removeClass('active-nav');

                if (element) {
                    $(element).addClass('active-nav');
                }

                $('#main-view').hide();
                $('#loader').show();

                $.ajax({
                    url: url,
                    type: 'GET',
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (data) {
                        $('#loader').hide();
                        $('#main-view').html(data).fadeIn();
                    },
                    error: function (xhr) {
                        $('#loader').hide();
                        $('#main-view').show();
                        if (typeof showToast === "function") {
                            showToast('Lỗi tải dữ liệu hoặc trang không tồn tại!', 'error');
                        }
                    }
                });
            }
            $(document).ready(function () {
                $('.nav-link').removeClass('active-nav');

                var currentPath = window.location.pathname.toLowerCase().replace(/\/$/, "");

                var matched = false;

                $('.nav-link').each(function () {
                    var href = $(this).attr('href');
                    if (href) {
                        var navPath = href.toLowerCase().replace(/\/$/, "");
                        if (currentPath === navPath) {
                            $(this).addClass('active-nav');
                            matched = true;
                            return false;
                        }
                    }
                });

                if (!matched) {
                    $('.nav-link').each(function () {
                        var href = $(this).attr('href');
                        if (href && href !== '/' && href !== '/admin' && href !== '/admin/home') {
                            var navPath = href.toLowerCase().replace(/\/$/, "");
                            if (currentPath.indexOf(navPath) === 0) {
                                $(this).addClass('active-nav');
                                return false;
                            }
                        }
                    });
                }
            });
        //Toast_Notification
        function showToast(message, type = 'success', duration = 10000) {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const toast = document.createElement('div');
    
            toast.className = `toast-notification ${type === 'error' ? 'toast-error' : ''}`;
    
            toast.innerHTML = `
                <span class="toast-message">${message}</span>
                <button class="toast-close" onclick="this.parentElement.remove()">&times;</button>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('show');
            }, 10);

            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => { toast.remove(); }, 500);
            }, duration);
        }
        // CONFIRM UI
        function customConfirm(message, title = "Xác nhận hành động") {
            return new Promise((resolve) => {
                const overlay = document.getElementById('confirm-overlay');
                const titleEl = document.getElementById('confirm-title');
                const messageEl = document.getElementById('confirm-message');
                const btnYes = document.getElementById('confirm-btn-yes');
                const btnNo = document.getElementById('confirm-btn-no');

                titleEl.textContent = title;
                messageEl.innerHTML = message;

                overlay.classList.add('open');

                function cleanup(result) {
                    overlay.classList.remove('open');
                    btnYes.removeEventListener('click', onYes);
                    btnNo.removeEventListener('click', onNo);
                    resolve(result); 
                }

                function onYes() { cleanup(true); }
                function onNo() { cleanup(false); }

                btnYes.addEventListener('click', onYes);
                btnNo.addEventListener('click', onNo);
            });
        }

    </script>
    <script>
    // Biến toàn cục để các file JS khác có thể kiểm tra
    window.IS_VIEWER_MODE = @(isViewer ? "true" : "false");

    $(document).ready(function () {
        if (window.IS_VIEWER_MODE) {
            // Danh sách các ID / Button thực hiện hành vi Thêm, Sửa, Xóa, Lưu
            const restrictedSelectors = [
                '#btnSave',
                '#chapterEditorSaveButton',
                '#btnConfirmInsertParagraph',
                '#btnDeleteSelected',
                '#btnImport',
                '#btnConfirmUploadImg',
                'button[onclick*="deleteParagraph"]',
                'button[onclick*="handleMergeParagraph"]',
                'button[onclick*="deleteFromCurrentEditorIndex"]',
                'button[onclick*="openInsertParagraphModal"]',
                'button[onclick*="deleteCategory"] '
            ].join(',');

            // Chặn sự kiện click ở mức Capture để ngăn cả onclick inline lẫn event jQuery
            document.addEventListener('click', function (e) {
                const targetBtn = e.target.closest(restrictedSelectors);

                if (targetBtn) {
                    // Chặn hành động mặc định và dừng lan truyền sự kiện
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    // Hiển thị thông báo Toast lỗi
                    if (typeof showToast === "function") {
                        showToast("You have VIEWER (read-only) access. You are not permitted to add, edit, delete, or save data!", "error", 4000);
                    }
                }
            }, true); // true = Capture phase (chặn trước khi các sự kiện khác chạy)
        }
    });
</script>

    <div id="toast-container"></div>
    <div id="confirm-overlay">
        <div class="confirm-box">
            <h4 class="confirm-title" id="confirm-title">Confirm</h4>
            <p class="confirm-message" id="confirm-message">Are you sure about this action</p>
            <div class="confirm-buttons">
                <button class="confirm-btn confirm-btn-cancel" id="confirm-btn-no">Reject</button>
                <button class="confirm-btn confirm-btn-success" id="confirm-btn-yes">Accept</button>
            </div>
        </div>
    </div>

</body>

</html>